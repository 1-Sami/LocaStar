# Apple fetches this with no extension and expects application/json. Served as
# anything else, universal links fail silently — the app never opens, links
# just go to the browser, and nothing reports an error.
/.well-known/apple-app-site-association
  Content-Type: application/json

# Android's verifier is less fussy, but be explicit anyway.
/.well-known/assetlinks.json
  Content-Type: application/json

# Fingerprinted by content, not by filename — a font or a vendored library only
# changes when it is deliberately replaced, and then the path changes with it.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/vendor/*
  Cache-Control: public, max-age=31536000, immutable
