---
import { useTranslations } from '../i18n/ui';

/*
 * One App Store or Google Play badge.
 *
 * A component because there are three pairs of these — the home hero, the
 * "get the app" band, and the features page — and they had drifted: the band's
 * pair was hardcoded as unavailable and would have stayed dead however the
 * flags were set. One definition means a store going live is one edit.
 *
 * The App Store badge is Apple's own artwork, unaltered, which is what their
 * marketing guidelines ask for — it was a lookalike drawn here until
 * 2026-09-03. Google Play is still the drawn chip, because Play is not public
 * yet and its badge is an inactive placeholder; swap it for Google's official
 * artwork when the app is actually there.
 */
interface Props {
  store: 'apple' | 'google';
  over: string;
  name: string;
  href: string;
  ready: boolean;
}

const { store, over, name, href, ready } = Astro.props;
const lang = Astro.locals.lang ?? 'en';
const t = useTranslations(lang);

/*
 * Apple supplies the badge per language, and the wording is part of the
 * artwork — the Swedish one reads "Ladda ned via App Store", so serving the
 * English file on /sv/ would leave one English sentence in a Swedish page.
 */
const appleBadge = (variant: 'black' | 'white') =>
  `/badges/app-store-${lang === 'sv' ? 'sv' : 'en'}-${variant}.svg`;

const GOOGLE_MARK =
  'M3.9 1.9c-.25.26-.4.67-.4 1.2v17.8c0 .53.15.94.4 1.2l.06.06 9.97-9.97v-.24L3.96 1.98l-.06-.08zm11.36 6.6L4.9 2.1l-.1-.06 8.7 8.7 1.76-2.24zm1.16 1.1 2.98 1.7c.85.48.85 1.27 0 1.76l-3.03 1.73-2.02-2.02 2.07-3.17zM4.8 21.96l10.36-6.4-1.9-2.36-8.46 8.76z';
---

{
  store === 'apple' ? (
    /*
     * Two files, one shown by CSS. Which is correct depends on the surface as
     * well as the theme — the hero and the band stay dark in both — so it
     * cannot be decided on the server, and deciding it in script would show
     * the wrong one until the script ran.
     */
    ready ? (
      <a class="apple" href={href} aria-label={t('home.appStoreAlt')}>
        <img class="badge blk" src={appleBadge('black')} alt={t('home.appStoreAlt')} width="120" height="40" />
        <img class="badge wht" src={appleBadge('white')} alt="" aria-hidden="true" width="120" height="40" />
      </a>
    ) : (
      <span class="apple waiting">
        <img class="badge blk" src={appleBadge('black')} alt={t('home.appStoreAlt')} width="120" height="40" />
        <img class="badge wht" src={appleBadge('white')} alt="" aria-hidden="true" width="120" height="40" />
      </span>
    )
  ) : ready ? (
    <a class="store" href={href}>
      <svg class="store-mark" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={GOOGLE_MARK} /></svg>
      <span class="store-text">
        <span class="mono over">{over}</span>
        <span class="store-name">{name}</span>
      </span>
    </a>
  ) : (
    <span class="store waiting">
      <svg class="store-mark" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={GOOGLE_MARK} /></svg>
      <span class="store-text">
        <span class="mono over">{over}</span>
        <span class="store-name">{name}</span>
      </span>
    </span>
  )
}

<style>
  /* Apple's artwork, untouched. Height only — the width follows, because
     changing the proportions is the one thing their guidelines rule out. */
  .apple {
    display: inline-flex;
    align-items: center;
    height: 44px;
    text-decoration: none;
  }
  .badge { height: 44px; width: auto; }
  .blk { display: var(--badge-black); }
  .wht { display: var(--badge-white); }

  /* Google Play, until Google's own badge replaces it. Matched to 44px so the
     row does not step. */
  .store {
    display: flex;
    align-items: center;
    gap: 11px;
    height: 44px;
    padding: 0 18px;
    background: var(--text);
    border-radius: 9px;
    color: var(--page);
    text-decoration: none;
  }
  .store-mark { width: 22px; height: 22px; flex: none; fill: currentColor; }
  .store-text { display: flex; flex-direction: column; }
  .over {
    font-size: 9px;
    letter-spacing: 0.12em;
    /* The chip is inverted, so its ink is the page colour, not a fixed dark. */
    color: rgba(var(--page-rgb), 0.62);
  }
  .store-name { font-weight: 600; font-size: 16px; line-height: 1.2; }

  /* Still a badge, just not a link yet. */
  .waiting { opacity: 0.62; }
</style>
