---
import { useTranslations } from '../i18n/ui';
import { categoryColor, ratingLabel } from '../lib/format';

/*
 * One saved place, as a card.
 *
 * The Saved area used PlaceRow — a thumbnail and a line of text — which is the
 * right weight for a list of your own contributions and the wrong one for the
 * places you kept because you liked the look of them. This is the shape the
 * app's Saved screen uses, so the two surfaces show a saved place the same way.
 *
 * The tension worth naming: most locations still have no photograph, so a card
 * grid is partly a grid of flat colour. That is exactly why the account area
 * moved to rows once before. The category name sits on the plate rather than
 * over the picture, so a card with no photo still says what it is instead of
 * being a coloured rectangle.
 */
interface Props {
  href: string;
  name: string;
  categorySlug?: string | null;
  categoryName?: string | null;
  avgRating?: number;
  reviewCount?: number;
  where?: string | null;
  /** Street and town. Shown under the rating, on its own line. */
  address?: string | null;
  imageUrl?: string | null;
  /** ISO start, for an event. Replaces the rating line with the date. */
  startsAt?: string | null;
}

const {
  href,
  name,
  categorySlug = null,
  categoryName = null,
  avgRating = 0,
  reviewCount = 0,
  where = null,
  address = null,
  imageUrl = null,
  startsAt = null,
} = Astro.props;

const lang = Astro.locals.lang ?? 'en';
const t = useTranslations(lang);
const colour = categoryColor(categorySlug);
const rating = ratingLabel(avgRating, reviewCount);
const isEvent = Boolean(startsAt);

/*
 * Whole days, compared as dates rather than instants — "tomorrow" should not
 * become "0 days" because the event starts 23 hours from now.
 */
const startOfDay = (d: Date) => Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate());
const daysLeft = startsAt
  ? Math.round((startOfDay(new Date(startsAt)) - startOfDay(new Date())) / 86_400_000)
  : null;
const startLabel = startsAt
  ? new Date(startsAt)
      .toLocaleDateString(lang === 'sv' ? 'sv-SE' : 'en-GB', { day: 'numeric', month: 'short' })
      .toUpperCase()
  : null;
---

<a class="card" href={href}>
  <span class="frame">
    {
      imageUrl ? (
        <span class="shot" style={`background-image:url("${imageUrl}")`} />
      ) : (
        <span class="shot flat" style={`background:${colour}`} />
      )
    }
    {/*
      On the picture, and only when it earns its place: an event, where the
      countdown is the point, or a place with no photograph, where the block
      would otherwise be a rectangle of colour saying nothing. A photographed
      court does not need the word "Basketball" over it.
    */}
    {
      categoryName && (isEvent || !imageUrl) && (
        <span class:list={['mono', 'chip', imageUrl ? 'on-shot' : 'on-flat']}>
          {categoryName}
          {daysLeft !== null && daysLeft >= 0 ? ` · ${t('acct.daysLeft').replace('{n}', String(daysLeft))}` : ''}
        </span>
      )
    }
  </span>

  <span class="plate">
    <span class="name">{name}</span>
    {/*
      The rating keeps its review count, and where the place is gets a line of
      its own underneath.

      It used to be one line, with the town replacing the count — so a saved
      place told you either how it was rated or where it was, never both, and
      a place with no town in its row said nothing about where it is at all.
      The address is what a saved place is for: you are deciding whether to go.
    */}
    {
      startLabel ? (
        <span class="mono when">{startLabel}</span>
      ) : rating.rated ? (
        <span class="mono star">★ {rating.avg} ({rating.count})</span>
      ) : (
        <span class="mono unrated">{t('common.notRated')}</span>
      )
    }
    {(address || where) && <span class="where">{address || where}</span>}
  </span>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 12px;
    overflow: hidden;
    color: var(--text);
    transition: box-shadow 120ms ease-out;
  }

  .card:hover {
    color: var(--text);
    box-shadow: 0 0 0 3px rgba(232, 169, 59, 0.12);
  }

  .frame {
    position: relative;
    display: block;
  }

  .shot {
    display: block;
    height: 118px;
    background-size: cover;
    background-position: center;
  }

  /* Two lines at most: an imported address runs to "Kanaans väg 12, 145 69
     Botkyrka", and a card in a two-up grid on a phone is about 20 characters
     wide. Clamped rather than truncated to one line, which cut most of them
     off before the town. */
  .where {
    font-size: 12.5px;
    line-height: 1.35;
    color: var(--text-55);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }

  .chip {
    position: absolute;
    top: 9px;
    left: 9px;
    font-size: 9.5px;
    letter-spacing: 0.12em;
    padding: 3px 7px;
    border-radius: 999px;
  }

  /* Over a photograph whose brightness is unknown, so it carries its own
     background rather than trusting the picture underneath it. */
  .chip.on-shot {
    background: rgba(0, 0, 0, 0.55);
    color: #ffffff;
  }

  /* On a flat category colour, where a second block would just be noise. */
  .chip.on-flat {
    background: rgba(0, 0, 0, 0.28);
    color: #ffffff;
  }

  .plate {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 11px 12px 13px;
  }

  .name {
    font-weight: 500;
    font-size: 15px;
    line-height: 1.25;
  }

  .star {
    font-size: 11.5px;
    color: var(--accent);
  }

  .when {
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--text-70);
  }

  .dim {
    color: var(--text-42);
  }

  .unrated {
    font-size: 10.5px;
    letter-spacing: 0.12em;
    color: var(--text-55);
  }

</style>
