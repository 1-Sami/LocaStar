---
import { localePath, useTranslations } from '../i18n/ui';
import { qrPathFor } from '../lib/qr';
import { GET_THE_APP_PATH } from '../lib/site';

/*
 * "Point your camera at this to get the app."
 *
 * Sits beside the store badges everywhere they appear, because a badge only
 * helps somebody already holding the phone they want the app on — and the most
 * likely visitor to this site is at a desk.
 *
 * Desktop only, by the owner's decision: below 900px it is display: none, so
 * it is out of the layout and out of the accessibility tree rather than shrunk.
 * A phone cannot scan its own screen, and the badges right beside it are the
 * real path there. The markup is still served at every width — the server
 * cannot know the viewport — which costs a few hundred bytes and nothing else.
 *
 * Drawn dark-on-white in both themes and on the dark panels. That is not a
 * styling oversight: plenty of scanners refuse an inverted code, and the ones
 * that manage it are slower about it. The plate is the quiet zone too, which
 * is as much a part of a working code as the modules are.
 */
interface Props {
  /** The code's size in px, up to 72. */
  size?: number;
}

const { size = 64 } = Astro.props;

const lang = Astro.locals.lang ?? 'en';
const t = useTranslations(lang);

/*
 * Absolute, and taken from the configured site rather than the request: a code
 * is scanned by a different device than the one that rendered it, so a bare
 * path is meaningless inside it. On the workers.dev preview Astro.site is
 * still locastar.se, which is what should be tested anyway — the QR is the one
 * thing on a preview that has to name production.
 *
 * The language travels with it. /sv/get and /get pick the same store, but they
 * differ where neither store can be served yet, and a Swedish visitor's phone
 * should not land on the English page.
 */
const href = localePath(GET_THE_APP_PATH, lang);
const { path, size: modules } = qrPathFor(new URL(href, Astro.site ?? Astro.url.origin).href);
---

<a class="qr" href={href} style={`--qr-size: ${size}px`}>
  <span class="plate">
    <svg viewBox={`0 0 ${modules} ${modules}`} aria-hidden="true" focusable="false">
      <path d={path} fill="#0b1211" />
    </svg>
  </span>
  <span class="caption">{t('app.scan')}</span>
</a>

<style>
  /*
   * A row, and it sits under the badges rather than in with them.
   *
   * It was a column beside them at 112px, which made the code the loudest
   * thing in the hero — bigger than the two buttons it is an alternative to.
   * Small, with the sentence beside it, it reads as a footnote to the badges,
   * which is what it is.
   */
  .qr {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: inherit;
  }

  .plate {
    background: #ffffff;
    border-radius: 8px;
    padding: 7px;
    /* The light theme's page is an off-white, so a white plate on it has no
       edge at all without this. Invisible on the dark panels, which is where
       the plate defines itself. */
    box-shadow: 0 0 0 1px rgba(16, 32, 30, 0.09);
    /* An inline SVG is still a line box; without this the plate carries a few
       stray pixels of descender space under the code. */
    line-height: 0;
  }

  .qr svg {
    display: block;
    width: min(var(--qr-size), 72px);
    height: min(var(--qr-size), 72px);
    /* Modules are one unit each on a scaled grid, so the edges land between
       device pixels and antialias into grey. Scanners read the contrast, and
       this is what keeps it. */
    shape-rendering: crispEdges;
  }

  .caption {
    font-size: 13px;
    line-height: 1.45;
    max-width: 17ch;
    color: var(--text-55);
  }

  .qr:hover .caption {
    color: var(--text);
  }

  /*
   * Gone below 900px, not shrunk.
   *
   * 900 rather than a phone width on purpose: it takes in a phone held
   * sideways and the small tablets, none of which can scan themselves either.
   * Every surface that shows this also shows the store badges, which are what
   * a visitor already on a phone needs.
   */
  @media (max-width: 900px) {
    .qr {
      display: none;
    }
  }
</style>
