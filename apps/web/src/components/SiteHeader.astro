---
/*
 * The logo is the app's own mark, lifted from
 * apps/mobile/src/components/locastar-logo.tsx — same path data, same teal
 * tile. The handoff is explicit that this is the SVG, not the PNG icons.
 */
---

<header class="site-header">
  <div class="wrap inner">
    <a class="brand" href="/">
      <svg width="40" height="40" viewBox="0 0 200 200" aria-hidden="true">
        <rect x="4" y="4" width="192" height="192" rx="42" fill="#125F6F"></rect>
        <g
          transform="translate(23.86 13.94) scale(0.2794)"
          fill="none"
          stroke="#F4F6F5"
          stroke-width="24.5"
          stroke-linecap="round"
          stroke-miterlimit="6"
        >
          <path d="M 49 48 L 49 566 L 261 566"></path>
          <path d="M 131 360 L 131 480 L 201 480"></path>
          <path d="M 466 332 A 182 192 0 1 0 163 325 L 313 568 L 418 412"></path>
          <path
            d="M 355 248 L 423 200 L 341 180 L 311 118 L 283 180 L 203 200 L 277 238 L 250 332 L 312 272 L 452 383 C 472 398 492 420 494 450 C 497 490 480 520 450 542 C 425 560 400 568 378 568"
          ></path>
        </g>
      </svg>
      <span class="wordmark">LOCASTAR</span>
    </a>

    <nav class="actions" aria-label="Main">
      <span class="mono lang">EN · SV</span>
      <a class="signin" href="/auth/sign-in">Sign in</a>
      <a class="cta" href="/add">Add a place</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--hairline);
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 22px;
    gap: 20px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--text);
  }

  .brand:hover {
    color: var(--text);
  }

  .wordmark {
    font-weight: 600;
    font-size: 19px;
    letter-spacing: 0.03em;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .lang {
    font-size: 13px;
    letter-spacing: 0.12em;
    color: var(--text-70);
  }

  .signin {
    font-weight: 500;
    font-size: 16px;
    color: var(--text);
  }

  /* Black on accent, never white — roughly 9:1, and white would fail. */
  .cta {
    font-weight: 600;
    font-size: 15.5px;
    color: var(--page);
    background: var(--accent);
    padding: 13px 20px;
    border-radius: 8px;
  }

  .cta:hover {
    color: var(--page);
    background: #f0b94e;
  }

  @media (max-width: 640px) {
    .lang {
      display: none;
    }
  }
</style>
