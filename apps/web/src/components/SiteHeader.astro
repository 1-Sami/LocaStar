---
import { fetchProfile } from '@locastar/shared';

import { localePath, useTranslations } from '../i18n/ui';
import { currentUser } from '../lib/auth';

/*
 * The header as drawn in section 01 of the mockups.
 *
 * The logo is the app's own mark, lifted from
 * apps/mobile/src/components/locastar-logo.tsx — same path data, same teal tile.
 */
interface Props {
  /** Which nav item is underlined. Omit on pages that are not a nav target. */
  current?: 'explore' | 'categories' | 'community' | 'features' | 'about';
}

const { current } = Astro.props;
const lang = Astro.locals.lang ?? 'en';
const t = useTranslations(lang);
const path = Astro.url.pathname;
const p = (href: string) => localePath(href, lang);

const NAV = [
  { key: 'explore', label: t('nav.explore'), href: '/search' },
  { key: 'categories', label: t('nav.categories'), href: '/categories' },
  { key: 'community', label: t('nav.community'), href: '/community' },
  { key: 'features', label: t('nav.features'), href: '/features' },
  { key: 'about', label: t('nav.about'), href: '/about' },
] as const;

/*
 * Who is signed in, checked only when a session cookie is actually present.
 *
 * Verifying a token is a network round trip, and this header renders on every
 * page including the ones a crawler reads. Skipping the call when there is no
 * cookie means a signed-out visitor pays nothing for it.
 */
const hasSessionCookie = (Astro.request.headers.get('cookie') ?? '').includes('sb-');

let signedInName: string | null = null;
let avatarUrl: string | null = null;

if (hasSessionCookie) {
  const { user, supabase } = await currentUser(Astro.cookies, Astro.request.headers);
  if (user) {
    const profile = await fetchProfile(supabase, user.id).catch(() => null);
    signedInName = profile?.username ?? profile?.display_name ?? user.email ?? 'Account';
    avatarUrl = profile?.avatar_url ?? null;
  }
}

const initial = signedInName ? signedInName.trim().charAt(0).toUpperCase() : '';
---

<header class="site-header">
  <div class="wrap inner">
    <div class="left">
      <a class="brand" href={p('/')}>
        <svg width="48" height="48" viewBox="0 0 200 200" aria-hidden="true">
          <rect x="4" y="4" width="192" height="192" rx="42" fill="#125F6F"></rect>
          <g
            transform="translate(23.86 13.94) scale(0.2794)"
            fill="none"
            stroke="#F4F6F5"
            stroke-width="24.5"
            stroke-linecap="round"
            stroke-miterlimit="6"
          >
            <path d="M 49 48 L 49 566 L 261 566"></path>
            <path d="M 131 360 L 131 480 L 201 480"></path>
            <path d="M 466 332 A 182 192 0 1 0 163 325 L 313 568 L 418 412"></path>
            <path
              d="M 355 248 L 423 200 L 341 180 L 311 118 L 283 180 L 203 200 L 277 238 L 250 332 L 312 272 L 452 383 C 472 398 492 420 494 450 C 497 490 480 520 450 542 C 425 560 400 568 378 568"
            ></path>
          </g>
        </svg>
        <span class="lockup">
          <span class="wordmark">LOCASTAR</span>
          <span class="mono tagline">EXPLORE. MAP. SHARE.</span>
        </span>
      </a>

      <nav class="nav" aria-label={t('nav.menuLabel')}>
        {
          NAV.map((item) => (
            <a class={`nav-link${current === item.key ? ' on' : ''}`} href={p(item.href)}>
              {item.label}
            </a>
          ))
        }
      </nav>
    </div>

    <div class="actions">
      <span class="mono lang">
        <a class={lang === 'en' ? 'on' : ''} href={localePath(path, 'en')} hreflang="en">EN</a>
        <span aria-hidden="true"> · </span>
        <a class={lang === 'sv' ? 'on' : ''} href={localePath(path, 'sv')} hreflang="sv">SV</a>
      </span>

      {
        signedInName ? (
          <a class="me" href={p('/account')} aria-label={`${t('nav.account')} — ${signedInName}`}>
            <span class="me-name">{signedInName}</span>
            {avatarUrl ? (
              <span class="me-avatar" style={`background-image:url("${avatarUrl}")`} />
            ) : (
              <span class="me-avatar initial">{initial}</span>
            )}
          </a>
        ) : (
          <a class="signin" href={p('/auth/sign-in')}>{t('nav.signIn')}</a>
        )
      }

      <a class="cta" href={p('/add')}>{t('nav.addPlace')}</a>

      {/*
        The same links again, for the widths where the row above does not fit.

        <details> rather than a button and a script: the menu has to work on the
        first paint of a server-rendered page, and every one of these links is a
        plain anchor. Nothing here needs JavaScript, so nothing here uses it.
      */}
      <details class="menu">
        <summary aria-label={t('nav.menu')}>
          <span class="bars" aria-hidden="true"></span>
        </summary>
        <nav class="menu-panel" aria-label={t('nav.menuLabel')}>
          {
            NAV.map((item) => (
              <a class={`menu-link${current === item.key ? ' on' : ''}`} href={p(item.href)}>
                {item.label}
              </a>
            ))
          }
          <span class="menu-rule" aria-hidden="true"></span>
          <span class="mono menu-lang">
            <a class={lang === 'en' ? 'on' : ''} href={localePath(path, 'en')} hreflang="en">EN</a>
            <span aria-hidden="true"> · </span>
            <a class={lang === 'sv' ? 'on' : ''} href={localePath(path, 'sv')} hreflang="sv">SV</a>
          </span>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--hairline);
    background: rgba(7, 16, 15, 0.9);
    /*
     * Above the sticky results bar the search page puts at the top of its
     * column, so the open menu is never drawn underneath it — and below the
     * photo lightbox at 60, which is meant to cover everything.
     */
    position: relative;
    z-index: 30;
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 24px;
    gap: 24px;
  }

  .left {
    display: flex;
    align-items: center;
    gap: 46px;
    min-width: 0;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 14px;
    color: var(--text);
    flex: none;
  }

  .brand:hover {
    color: var(--text);
  }

  .lockup {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .wordmark {
    font-weight: 600;
    font-size: 22px;
    line-height: 1;
    letter-spacing: 0.03em;
  }

  .tagline {
    font-size: 9.5px;
    line-height: 1;
    letter-spacing: 0.22em;
    color: var(--accent);
  }

  .nav {
    display: flex;
    gap: 32px;
  }

  .nav-link {
    font-weight: 500;
    font-size: 17px;
    line-height: 1;
    color: rgba(244, 246, 245, 0.85);
    padding-bottom: 6px;
    border-bottom: 2px solid transparent;
  }

  .nav-link:hover {
    color: var(--accent);
  }

  .nav-link.on {
    color: var(--text);
    border-bottom-color: var(--accent);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 20px;
    flex: none;
  }

  .lang {
    font-size: 13px;
    letter-spacing: 0.12em;
    color: var(--text-42);
  }

  .lang a {
    color: var(--text-42);
  }

  .lang a.on {
    color: var(--text);
  }

  .lang a:hover {
    color: var(--accent);
  }

  .signin {
    font-weight: 500;
    font-size: 16px;
    color: var(--text);
  }

  /* Signed in: the name and a picture, so it is obvious at a glance which it
     is. "Sign in" sitting there while you are signed in reads as broken. */
  .me {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
  }

  .me:hover {
    color: var(--accent);
  }

  .me-name {
    font-weight: 500;
    font-size: 15px;
  }

  .me-avatar {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background-color: var(--brand);
    background-size: cover;
    background-position: center;
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .me-avatar.initial {
    font-weight: 600;
    font-size: 14px;
    color: var(--text);
  }

  /* Black on accent, never white — roughly 9:1, and white would fail. */
  .cta {
    font-weight: 600;
    font-size: 16px;
    color: var(--page);
    background: var(--accent);
    padding: 14px 24px;
    border-radius: 9px;
  }

  .cta:hover {
    color: var(--page);
    background: #f0b94e;
  }

  /* ---- the narrow-screen menu ---- */

  .menu {
    display: none;
    position: relative;
  }

  .menu > summary {
    list-style: none;
    cursor: pointer;
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: 8px;
  }

  .menu > summary::-webkit-details-marker {
    display: none;
  }

  /* Three rules drawn from one element, so there is no extra markup. */
  .bars,
  .bars::before,
  .bars::after {
    display: block;
    width: 17px;
    height: 1.5px;
    background: var(--text);
    content: '';
  }

  .bars {
    position: relative;
  }

  .bars::before {
    position: absolute;
    top: -5.5px;
  }

  .bars::after {
    position: absolute;
    top: 5.5px;
  }

  .menu[open] > summary {
    border-color: var(--accent);
  }

  .menu-panel {
    position: absolute;
    top: calc(100% + 9px);
    right: 0;
    z-index: 20;
    min-width: 208px;
    display: flex;
    flex-direction: column;
    padding: 8px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 11px;
  }

  .menu-link {
    padding: 11px 13px;
    border-radius: 7px;
    font-size: 15px;
    font-weight: 500;
    color: var(--text);
  }

  .menu-link:hover {
    color: var(--accent);
    background: var(--surface-alt);
  }

  .menu-link.on {
    color: var(--accent);
  }

  .menu-rule {
    height: 1px;
    margin: 7px 5px;
    background: var(--hairline);
  }

  .menu-lang {
    padding: 4px 13px 7px;
    font-size: 11.5px;
    color: var(--text-55);
  }

  .menu-lang .on {
    color: var(--text);
  }

  @media (max-width: 1100px) {
    .nav {
      display: none;
    }

    /* Only now, so the button never sits beside the row it stands in for. */
    .menu {
      display: block;
    }
  }

  @media (max-width: 640px) {
    .lang,
    .me-name {
      display: none;
    }
  }
</style>
