---
import { useTranslations, localePath } from '../i18n/ui';

/*
 * Moving between the admin screens without going back through the account page.
 *
 * Feedback and crashes are admin-only, matching the app, so a superuser sees
 * reports and the log rather than links that would redirect them straight back
 * out. The log stays open to moderators on purpose: their own actions are in
 * it, and being able to see what was done to your work is most of what makes
 * keeping the record worth anything.
 */
interface Props {
  current: 'reports' | 'feedback' | 'crashes' | 'log' | 'people';
  isAdmin: boolean;
}

const { current, isAdmin } = Astro.props;
const lang = Astro.locals.lang ?? 'en';
const t = useTranslations(lang);
const p = (href: string) => localePath(href, lang);

const links = [
  { key: 'reports', href: '/admin/reports', label: t('mod.navReports'), adminOnly: false },
  { key: 'log', href: '/admin/log', label: t('mod.navLog'), adminOnly: false },
  { key: 'people', href: '/admin/people', label: t('mod.navPeople'), adminOnly: false },
  { key: 'feedback', href: '/admin/feedback', label: t('mod.navFeedback'), adminOnly: true },
  { key: 'crashes', href: '/admin/crashes', label: t('mod.navCrashes'), adminOnly: true },
].filter((link) => isAdmin || !link.adminOnly);
---

<nav class="admin-nav" aria-label={t('mod.navLabel')}>
  {links.map((link) => (
    <a
      href={p(link.href)}
      class:list={['link', { on: current === link.key }]}
      aria-current={current === link.key ? 'page' : undefined}>
      {link.label}
    </a>
  ))}
</nav>

<style>
  /* A real tab bar rather than a row of uppercase links: one rounded track
     with a hairline, and the current tab filled so it reads as the sheet you
     are on rather than one more link you have not clicked yet. */
  .admin-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    padding: 4px;
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 999px;
    align-self: flex-start;
    max-width: 100%;
  }
  .link {
    padding: 8px 18px;
    border-radius: 999px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 14px;
    color: var(--text-55);
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 120ms ease-out, color 120ms ease-out;
  }
  .link:hover { color: var(--text); }
  .link.on {
    background: var(--brand);
    color: #ffffff;
  }
  .link.on:hover { color: #ffffff; }

  @media (max-width: 620px) {
    .admin-nav { border-radius: 14px; }
    .link { flex: 1 1 auto; text-align: center; }
  }
</style>
