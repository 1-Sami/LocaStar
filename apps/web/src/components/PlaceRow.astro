---
import { useTranslations } from '../i18n/ui';
import { categoryColor, ratingLabel } from '../lib/format';

/*
 * One place as a row, matching the shape "My reviews" uses.
 *
 * The account area showed added places as large picture cards, which is the
 * wrong weight for a list of your own contributions — and with almost nothing
 * carrying a photo it was a grid of flat colour blocks. A row says the same
 * things in a quarter of the space.
 */
interface Props {
  href: string;
  name: string;
  categorySlug?: string | null;
  categoryName?: string | null;
  avgRating?: number;
  reviewCount?: number;
  where?: string | null;
  /** A resolved image URL, if there is one. */
  imageUrl?: string | null;
  /** Right-hand note — a date, a distance, a status. */
  aside?: string | null;
}

const {
  href,
  name,
  categorySlug = null,
  categoryName = null,
  avgRating = 0,
  reviewCount = 0,
  where = null,
  imageUrl = null,
  aside = null,
} = Astro.props;

const t = useTranslations(Astro.locals.lang ?? 'en');
const colour = categoryColor(categorySlug);
const rating = ratingLabel(avgRating, reviewCount);
---

<a class="row" href={href} style={`border-color:${colour}`}>
  {
    imageUrl ? (
      <span class="thumb" style={`background-image:url("${imageUrl}")`} />
    ) : (
      <span class="thumb flat" style={`background:${colour}`} />
    )
  }

  <span class="body">
    <span class="name">{name}</span>
    <span class="meta">
      {
        rating.rated ? (
          <span class="mono star">★ {rating.avg} <span class="dim">({rating.count})</span></span>
        ) : (
          <span class="mono unrated">{t('common.notRated')}</span>
        )
      }
      {categoryName && <span class="cat">{categoryName}</span>}
    </span>
    {where && <span class="where">{where}</span>}
  </span>

  {aside && <span class="mono aside">{aside}</span>}
</a>

<style>
  .row {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px;
    background: var(--surface);
    border: 1px solid;
    border-radius: 11px;
    color: var(--text);
    transition: box-shadow 120ms ease-out;
  }

  .row:hover {
    color: var(--text);
    box-shadow: 0 0 0 3px rgba(232, 169, 59, 0.12);
  }

  .thumb {
    width: 74px;
    height: 56px;
    border-radius: 7px;
    flex: none;
    background-size: cover;
    background-position: center;
  }

  .body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .name {
    font-weight: 500;
    font-size: 15.5px;
    line-height: 1.25;
  }

  .meta {
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
  }

  .star {
    font-size: 11.5px;
    color: var(--accent);
  }

  .dim {
    color: var(--text-42);
  }

  .unrated {
    font-size: 10.5px;
    letter-spacing: 0.12em;
    color: var(--text-42);
  }

  .cat {
    font-size: 12.5px;
    color: var(--text-55);
  }

  .where {
    font-size: 12.5px;
    line-height: 1.35;
    color: var(--text-55);
  }

  .aside {
    font-size: 10.5px;
    letter-spacing: 0.1em;
    color: var(--text-42);
    flex: none;
  }
</style>
