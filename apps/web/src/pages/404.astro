---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Base from '../layouts/Base.astro';
import { useTranslations, localePath } from '../i18n/ui';

/*
 * Section 13. It explains the one cause people actually hit — an activity that
 * has ended and been retired — because a share link to last month's festival is
 * a 404 that has a reason, and saying so is better than "not found".
 */
export const prerender = false;

const origin = Astro.site?.origin ?? Astro.url.origin;
const lang = Astro.locals.lang ?? 'en';
const t = useTranslations(lang);
const p = (href: string) => localePath(href, lang);
---

<Base
  title={t('notFound.metaTitle')}
  description={t('notFound.metaDesc')}
  canonical={`${origin}/404`}
>
  <SiteHeader />

  <main id="main" class="wrap">
    <div class="panel">
      <span class="mono code">404</span>
      <h1>{t('notFound.title')}</h1>
      <p class="lead">
        {t('notFound.lead')}
      </p>
      <p class="sub">
        {t('notFound.sub')}
      </p>
      <div class="actions">
        <a class="cta" href={p('/search')}>{t('notFound.searchMap')}</a>
        <a class="ghost" href={p('/categories')}>{t('notFound.browse')}</a>
        <a class="ghost" href={p('/')}>{t('notFound.startAgain')}</a>
      </div>
    </div>
  </main>

  <SiteFooter />
</Base>

<style>
  main {
    padding-block: 64px 80px;
  }

  .panel {
    max-width: 640px;
  }

  .code {
    font-size: 11px;
    letter-spacing: 0.22em;
    color: var(--accent);
  }

  h1 {
    font-size: clamp(40px, 8vw, 68px);
    line-height: 1;
    letter-spacing: -0.04em;
    margin: 14px 0 18px;
  }

  .lead {
    margin: 0 0 12px;
    font-size: 20px;
    line-height: 1.55;
    color: var(--text-70);
  }

  .sub {
    margin: 0;
    font-size: 15px;
    line-height: 1.65;
    color: var(--text-55);
    max-width: 56ch;
  }

  .actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 28px;
  }

  .cta {
    background: var(--accent);
    color: var(--page);
    border-radius: 9px;
    padding: 14px 24px;
    font-weight: 600;
    font-size: 15px;
  }

  .cta:hover {
    background: #f0b94e;
    color: var(--page);
  }

  .ghost {
    border: 1px solid var(--border);
    border-radius: 9px;
    padding: 14px 22px;
    font-weight: 500;
    font-size: 15px;
    color: var(--text);
  }

  .ghost:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
</style>
