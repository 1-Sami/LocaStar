---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Base from '../layouts/Base.astro';

/*
 * Section 13. It explains the one cause people actually hit — an activity that
 * has ended and been retired — because a share link to last month's festival is
 * a 404 that has a reason, and saying so is better than "not found".
 */
export const prerender = false;

const origin = Astro.site?.origin ?? Astro.url.origin;
---

<Base
  title="Off the map | LocaStar"
  description="This page does not exist — or the activity it showed has ended and been removed."
  canonical={`${origin}/404`}
>
  <SiteHeader />

  <main id="main" class="wrap">
    <div class="panel">
      <span class="mono code">404</span>
      <h1>Off the map</h1>
      <p class="lead">
        This page doesn’t exist — or the activity it showed has ended and been removed.
      </p>
      <p class="sub">
        Activities are taken down once their last day has passed, so a link to something from last month will
        land here. Places do not disappear that way.
      </p>
      <div class="actions">
        <a class="cta" href="/search">Search the map</a>
        <a class="ghost" href="/categories">Browse by activity</a>
        <a class="ghost" href="/">Start again</a>
      </div>
    </div>
  </main>

  <SiteFooter />
</Base>

<style>
  main {
    padding-block: 64px 80px;
  }

  .panel {
    max-width: 640px;
  }

  .code {
    font-size: 11px;
    letter-spacing: 0.22em;
    color: var(--accent);
  }

  h1 {
    font-size: clamp(40px, 8vw, 68px);
    line-height: 1;
    letter-spacing: -0.04em;
    margin: 14px 0 18px;
  }

  .lead {
    margin: 0 0 12px;
    font-size: 20px;
    line-height: 1.55;
    color: var(--text-70);
  }

  .sub {
    margin: 0;
    font-size: 15px;
    line-height: 1.65;
    color: var(--text-55);
    max-width: 56ch;
  }

  .actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 28px;
  }

  .cta {
    background: var(--accent);
    color: var(--page);
    border-radius: 9px;
    padding: 14px 24px;
    font-weight: 600;
    font-size: 15px;
  }

  .cta:hover {
    background: #f0b94e;
    color: var(--page);
  }

  .ghost {
    border: 1px solid var(--border);
    border-radius: 9px;
    padding: 14px 22px;
    font-weight: 500;
    font-size: 15px;
    color: var(--text);
  }

  .ghost:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
</style>
