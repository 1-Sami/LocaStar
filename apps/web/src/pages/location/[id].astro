  }

  .thumb {
    width: 86px;
    height: 64px;
    border-radius: 6px;
    background-size: cover;
    background-position: center;
    background-color: var(--surface-alt);
  }

  /* The state most pages will actually be in. It names a next action rather
     than just reporting absence. */
  .empty {
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 11px;
    padding: 26px;
  }

  .empty-lead {
    margin: 0;
    font-size: 17px;
  }

  .empty .sub {
    display: block;
    margin-top: 6px;
  }

  /* ---- side column ---- */
  .col-side {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-self: start;
    position: sticky;
    top: 24px;
  }

  .panel {
    background: var(--surface);
    border: 1px solid rgba(var(--ink-rgb), 0.12);
    border-radius: 13px;
    overflow: hidden;
  }

  /* Where the map was. Sized to read as a note rather than a hole. */
  .map-soon {
    margin: 0;
    padding: 16px 20px 0;
    font-size: 13px;
    line-height: 1.55;
    color: var(--text-55);
  }

  .panel-actions {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 11px;
  }

  .cta {
    background: var(--accent);
    border-radius: 9px;
    padding: 14px;
    text-align: center;
    font-weight: 600;
    font-size: 16px;
    color: var(--page);
  }

  .cta:hover {
    background: #f0b94e;
    color: var(--page);
  }

  .note {
    margin: 0;
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--text-42);
    text-align: center;
  }

  /*
   * Three exactly equal columns.
   *
   * Flex could not do it here: two of the three buttons are wrapped in their
   * own form, so the flex items are a mix of forms and a bare button, and they
