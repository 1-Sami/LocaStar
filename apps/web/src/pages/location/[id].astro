        (function () {
          var block = document.querySelector('[data-report-photos]');
          var link = document.querySelector('[data-gallery-report]');
          if (!block || !link) return;

          var byUrl = {};
          try {
            byUrl = JSON.parse(block.textContent || '{}');
          } catch (error) {
            return;
          }

          document.getElementById('gallery').addEventListener('photochange', function (event) {
            var href = byUrl[event.detail];
            link.hidden = !href;
            if (href) link.setAttribute('href', href);
          });
        })();
      </script>
    )
  }

<script is:inline>
  /* Ask before anything destructive. Bound once, and it reads the attribute at
     click time rather than at load, so a button whose prompt is set later —
     the viewer's, as it pages between photos — is still covered. */
  document.addEventListener('click', function (event) {
    var el = event.target.closest('[data-confirm]');
    if (el && !window.confirm(el.getAttribute('data-confirm'))) event.preventDefault();
  });
</script>

{
  isModerator && (
    <script is:inline>
      (function () {
        /*
         * Point the viewer's buttons at whichever photo is on screen. Called
         * by the gallery script's show(), so it follows paging, and it does
         * not matter whether the open set is the place's photos or one
         * review's — the lookup is keyed by URL.
         */
        var block = document.querySelector('[data-mod-photos]');
        var bar = document.querySelector('[data-gallery-mod]');
        if (!block || !bar) return;

        var byUrl = {};
        try {
          byUrl = JSON.parse(block.textContent || '{}');
        } catch (error) {
          return;
        }

        var coverForm = bar.querySelector('[data-mod-cover]');
        var coverId = bar.querySelector('[data-mod-cover-id]');
        var photoId = bar.querySelector('[data-mod-photo-id]');
        var reviewPhotoId = bar.querySelector('[data-mod-review-photo-id]');
        var removed = bar.querySelector('[data-mod-removed]');
        var toggle = bar.querySelector('[data-mod-toggle]');
        var removeLabel = toggle.textContent.trim();
        var restoreLabel = bar.getAttribute('data-restore-label') || removeLabel;

        document.getElementById('gallery').addEventListener('photochange', function (event) {
          var url = event.detail;
          var photo = byUrl[url];
          /* A photo with no row behind it is not something to act on. */
          bar.hidden = !photo;
          if (!photo) return;

          photoId.value = photo.p || '';
          reviewPhotoId.value = photo.r || '';
          removed.value = photo.x ? '0' : '1';
          toggle.textContent = photo.x ? restoreLabel : removeLabel;
          if (photo.x) toggle.removeAttribute('data-confirm');
          else toggle.setAttribute('data-confirm', bar.getAttribute('data-remove-confirm') || '');

          /* Only a photo the place itself owns can become the cover. */
          coverForm.hidden = !photo.p || photo.x;
          coverId.value = photo.p || '';
        });
      })();
    </script>
  )
}


  {
    isModerator && modTrash.length > 0 && (
      <section class="wrap modtrash">
        <h2 class="mono modtrash-head">{t('loc.modTrash')}</h2>
