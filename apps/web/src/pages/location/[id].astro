---
import {
  categoryName,
  fetchLocationById,
  fetchLocationPhotos,
  fetchNearbyLocations,
  fetchReviews,
  fetchListMembershipForLocation,
  fetchLists,
  fetchSavedLocationIds,
  isAlwaysOpen,
} from '@locastar/shared';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Base from '../../layouts/Base.astro';
import { useTranslations, localePath } from '../../i18n/ui';
import { categoryColor, longDate, metaDescription, ratingLabel, relativeDate } from '../../lib/format';
import { isUuid } from '../../lib/ids';
import { currentUser } from '../../lib/auth';
import { anonClient } from '../../lib/supabase';

export const prerender = false;

const { id } = Astro.params;
// A string that cannot be an id is a page that does not exist, not an outage.
if (!isUuid(id)) return new Response(null, { status: 404 });

const supabase = anonClient();
const lang = Astro.locals.lang ?? 'en';
const t = useTranslations(lang);
const p = (href: string) => localePath(href, lang);

/*
 * A frozen URL — every "Copy link" in the shipped app points here, so it has to
 * resolve for a stranger with no account. RLS decides what comes back: an
 * active public place is readable by `anon`, while a removed one and a retired
 * activity are not, which is exactly the behaviour we want. A miss is a real
 * 404, not an error.
 */
let location;
try {
  location = await fetchLocationById(supabase, id);
} catch (error) {
  /*
   * A failed request is not a missing page.
   *
   * Swallowing this into a 404 tells Google the place is gone, and Google
   * acts on that by dropping it from the index — a transient blip during a
   * crawl would quietly cost the page its ranking. 503 says "ask again",
   * which is the truth.
   */
  console.error('Failed to load location', id, error);
  return new Response('Temporarily unavailable', {
    status: 503,
    headers: { 'Retry-After': '60' },
  });
}

// Genuinely absent, or hidden from anonymous readers by RLS. That is a 404.
if (!location) return new Response(null, { status: 404 });

const [photos, reviews] = await Promise.all([
  fetchLocationPhotos(supabase, location.id).catch(() => []),
  fetchReviews(supabase, location.id).catch(() => []),
]);

/*
 * "More basketball nearby" — internal linking between category pages and place
 * pages is what earns rankings, so this block is load-bearing rather than
 * decoration. One extra is requested because this place matches its own query.
 */
const nearbyRaw = location.category_slug
  ? await fetchNearbyLocations(supabase, {
      lat: location.lat,
      lng: location.lng,
      categorySlugs: [location.category_slug],
      sort: 'distance',
      maxResults: 5,
    }).catch(() => [])
  : [];

const nearby = nearbyRaw.filter((place) => place.id !== location.id).slice(0, 4);

const publicUrl = (path: string | null) =>
  path ? supabase.storage.from('media').getPublicUrl(path).data.publicUrl : null;

const colour = categoryColor(location.category_slug);
const rating = ratingLabel(location.avg_rating, location.review_count);
const alwaysOpen = location.hours ? isAlwaysOpen(location.hours) : false;
const hasHours = Boolean(location.hours && Object.keys(location.hours).length > 0);

const category = categoryName(location.category_slug, lang) ?? location.category_label;
const city = location.city;

const title =
  [location.name, category ? `— ${category}` : null, city ? t('loc.inCity', { city }) : null].filter(Boolean).join(' ') +
  ' | LocaStar';
const description = metaDescription(location.description, { name: location.name, category, city });
const origin = Astro.site?.origin ?? Astro.url.origin;
const canonical = new URL(`/location/${location.id}`, origin).href;

/*
 * aggregateRating appears only when reviews exist.
 *
 * Every new place sits at 0.0 with no reviews, and structured data that
 * disagrees with the page is worse than none — Google discards it and can
 * distrust the rest. Omitting the field is the honest option.
 */
const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'SportsActivityLocation',
    name: location.name,
    ...(location.description ? { description: location.description } : {}),
    ...(location.address
      ? {
          address: {
            '@type': 'PostalAddress',
            streetAddress: location.address,
            ...(city ? { addressLocality: city } : {}),
            ...(location.country ? { addressCountry: location.country } : {}),
          },
        }
      : {}),
    geo: { '@type': 'GeoCoordinates', latitude: location.lat, longitude: location.lng },
    url: canonical,
    /*
     * Both keys, deliberately. `photo` is the schema.org property; `image` is
     * the one Google's structured-data documentation actually reads, and
     * without it a place with pictures shows none in a rich result.
     */
    ...(photos.length
      ? { image: photos.map((photo) => photo.url), photo: photos.map((photo) => photo.url) }
      : {}),
    ...(location.website ? { sameAs: location.website } : {}),
    ...(rating.rated
      ? {
          aggregateRating: {
            '@type': 'AggregateRating',
            ratingValue: location.avg_rating,
            reviewCount: location.review_count,
          },
        }
      : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'LocaStar', item: `${origin}/` },
      ...(category && location.category_slug
        ? [{ '@type': 'ListItem', position: 2, name: category, item: `${origin}/activity/${location.category_slug}` }]
        : []),
      { '@type': 'ListItem', position: category ? 3 : 2, name: location.name, item: canonical },
    ],
  },
];

/*
 * The visitor's own state for this place: is it a favourite, is it bookmarked,
 * and which of their lists could it go in. Only asked for when a session cookie
 * exists, so a signed-out reader — and a crawler — pays nothing.
 */
const hasSession = (Astro.request.headers.get('cookie') ?? '').includes('sb-');
let viewerId: string | null = null;
let isFavourite = false;
let isBookmarked = false;
let myLists: { id: string; name: string; has: boolean }[] = [];
/** How many of the viewer's own lists already hold this place. */
let inListCount = 0;

if (hasSession) {
  const { user, supabase: authed } = await currentUser(Astro.cookies, Astro.request.headers);
  if (user) {
    viewerId = user.id;
    const [favIds, bucketIds, lists, inLists] = await Promise.all([
      fetchSavedLocationIds(authed, user.id, 'favorite').catch(() => new Set<string>()),
      fetchSavedLocationIds(authed, user.id, 'bucket_list').catch(() => new Set<string>()),
      fetchLists(authed, user.id).catch(() => []),
      /*
       * Which of this person's lists already hold the place. Without it the
       * picker offered every list identically, so the only way to find out
       * whether you had already added somewhere was to add it again.
       */
      fetchListMembershipForLocation(authed, user.id, location.id).catch(() => new Set<string>()),
    ]);
    isFavourite = favIds.has(location.id);
    isBookmarked = bucketIds.has(location.id);
    myLists = lists.map((l) => ({ id: l.id, name: l.name, has: inLists.has(l.id) }));
    inListCount = myLists.filter((l) => l.has).length;
  }
}

const backHere = p(`/location/${location.id}`);
const saved = Astro.url.searchParams.get('saved');

const mapsHref = `https://www.google.com/maps/dir/?api=1&destination=${location.lat},${location.lng}`;
const seasonLabel =
  location.available_summer && location.available_winter
    ? t('loc.allYear')
    : location.available_summer
      ? t('loc.summer')
      : location.available_winter
        ? t('loc.winter')
        : t('loc.notStated');
---

<Base
  title={title}
  description={description}
  canonical={canonical}
  image={photos[0]?.url ?? null}
  jsonLd={jsonLd}
>
  <SiteHeader />

  <main id="main">
    {
      photos.length > 0 ? (
        <>
        <div class={`mosaic count-${Math.min(photos.length, 4)}`}>
          <button
            class="shot main"
            type="button"
            style={`background-image:url("${photos[0].url}")`}
            data-open-gallery="place"
            data-index="0"
            aria-label={t('loc.openGallery')}
          />
          {photos.length === 2 && (
            <button
              class="shot"
              type="button"
              style={`background-image:url("${photos[1].url}")`}
              data-open-gallery="place"
              data-index="1"
              aria-label={t('loc.openGallery')}
            />
          )}
          {photos.length >= 3 && (
            <div class="mosaic-side">
              <button
                class="shot"
                type="button"
                style={`background-image:url("${photos[1].url}")`}
                data-open-gallery="place"
                data-index="1"
                aria-label={t('loc.openGallery')}
              />
              {photos.length === 3 ? (
                <button
                  class="shot"
                  type="button"
                  style={`background-image:url("${photos[2].url}")`}
                  data-open-gallery="place"
                  data-index="2"
                  aria-label={t('loc.openGallery')}
                />
              ) : (
                <div class="mosaic-pair">
                  <button
                    class="shot"
                    type="button"
                    style={`background-image:url("${photos[2].url}")`}
                    data-open-gallery="place"
                    data-index="2"
                    aria-label={t('loc.openGallery')}
                  />
                  <button
                    class="shot last"
                    type="button"
                    style={`background-image:url("${photos[3].url}")`}
                    data-open-gallery="place"
                    data-index="3"
                    aria-label={t('loc.openGallery')}
                  >
                    {photos.length > 4 && <span class="mono more">+{photos.length - 4}</span>}
                  </button>
                </div>
              )}
            </div>
          )}
        </div>

        {/*
          The mosaic shows four at most, but the gallery pages through every
          one — which is the point of the "+N" badge. The full list travels as
          JSON rather than as more markup nobody sees.
        */}
        <script
          type="application/json"
          data-gallery-set="place"
          set:html={JSON.stringify(photos.map((photo) => photo.url))}
        />
        </>
      ) : (
        /* The common case: 985 of 996 places have no photo. A flat tile in the
           category colour with the category named — never a broken image, never
           a grey box, never a stock photo of somewhere else. */
        <div class="no-photo" style={`background:${colour}`}>
          <span class="mono">{category ?? 'LocaStar'}</span>
        </div>
      )
    }

    <div class="wrap body">
      <div class="col-main">
        <header class="head">
          <div class="badges">
            {category && <span class="badge" style={`background:${colour}`}>{category}</span>}
            {location.kind === 'activity' && <span class="badge outline">{t('loc.activity')}</span>}
            {(location.available_summer || location.available_winter) && (
              <span class="mono season">
                {[location.available_summer && 'Summer', location.available_winter && 'Winter']
                  .filter(Boolean)
                  .join(' · ')}
              </span>
            )}
          </div>

          <h1>{location.name}</h1>

          <div class="meta">
            {
              rating.rated ? (
                <>
                  <span class="mono star">★ {rating.avg}</span>
                  <span class="soft">
                    {rating.count} {rating.count === 1 ? 'review' : 'reviews'}
                  </span>
                </>
              ) : (
                /* Not empty stars — those read as "rated badly" rather than
                   "nobody has been yet". */
                <span class="mono unrated">{t('common.notRated')}</span>
              )
            }
            {location.address && (
              <>
                <span class="rule" />
                <span class="soft">{location.address}</span>
              </>
            )}
          </div>
        </header>

        {location.description && <p class="description">{location.description}</p>}

        <div class="info">
          <div class="card">
            <span class="mono label">{t('loc.openingHours')}</span>
            <div class="value">{alwaysOpen ? t('loc.open247') : hasHours ? t('loc.variesByDay') : t('loc.notStated')}</div>
          </div>
          <div class="card">
            <span class="mono label">{t('loc.season')}</span>
            <div class="value">{seasonLabel}</div>
          </div>
          <div class="card">
            <span class="mono label">{t('loc.addedBy')}</span>
            <div class="value">
              {location.creator_visible && location.creator_username ? location.creator_username : t('loc.someone')}
            </div>
            <span class="sub">{longDate(location.created_at)}</span>
          </div>
        </div>

        <div class="hairline" />

        <section class="reviews">
          <div class="reviews-head">
            <h2>{t('loc.reviews')}</h2>
            {reviews.length > 1 && <span class="mono soft">{t('loc.mostRecent')}</span>}
          </div>

          {
            reviews.length === 0 ? (
              <div class="empty">
                <p class="empty-lead">{t('loc.noReviews')}</p>
                <p class="sub">{t('loc.noReviewsSub')}</p>
              </div>
            ) : (
              <div class="review-list">
                {reviews.map((review) => (
                  <article class="review">
                    <div
                      class="avatar"
                      style={
                        review.author_avatar_url
                          ? `background-image:url("${review.author_avatar_url}")`
                          : `background:${colour}`
                      }
                    />
                    <div class="review-body">
                      <div class="review-head">
                        <span class="who">{review.author_name}</span>
                        <span class="mono star" aria-label={`${review.rating} out of 5`}>
                          {'★'.repeat(review.rating)}
                          {'☆'.repeat(5 - review.rating)}
                        </span>
                        <span class="mono when">{relativeDate(review.created_at)}</span>
                        <a class="mono report" href={`/report?review=${review.id}&location=${location.id}`}>
                          REPORT
                        </a>
                      </div>
                      {review.title && <strong class="review-title">{review.title}</strong>}
                      {review.body && <p class="review-text">{review.body}</p>}
                      {review.photos.length > 0 && (
                        <div class="review-photos">
                          {review.photos.map((url, index) => (
                            <button
                              class="thumb"
                              type="button"
                              style={`background-image:url("${url}")`}
                              data-open-gallery={`review-${review.id}`}
                              data-index={index}
                              aria-label={t('loc.openGallery')}
                            />
                          ))}
                          <script
                            type="application/json"
                            data-gallery-set={`review-${review.id}`}
                            set:html={JSON.stringify(review.photos)}
                          />
                        </div>
                      )}
                    </div>
                  </article>
                ))}
              </div>
            )
          }
        </section>
      </div>

      <aside class="col-side">
        <div class="panel">
          {/*
            The map is out for v1 — see the note on the search page. What
            actually gets somebody here is the Directions button below, which
            is a plain link to Google or Apple Maps: no key, no tile server,
            no cost, and on a phone it opens the maps app directly.
          */}
          <p class="map-soon">{t('loc.mapSoon')}</p>
          <div class="panel-actions">
            <a class="cta" href={mapsHref} rel="noopener noreferrer" target="_blank">{t('common.directions')}</a>
            <div class="secondary">
              <form method="post" action="/api/save">
                <input type="hidden" name="action" value="favorite" />
                <input type="hidden" name="locationId" value={location.id} />
                <input type="hidden" name="on" value={isFavourite ? '0' : '1'} />
                <input type="hidden" name="back" value={backHere} />
                <button class={`ghost${isFavourite ? ' on' : ''}`} type="submit">
                  {isFavourite ? `♥ ${t('loc.saved')}` : `♡ ${t('loc.save')}`}
                </button>
              </form>

              <form method="post" action="/api/save">
                <input type="hidden" name="action" value="bucket_list" />
                <input type="hidden" name="locationId" value={location.id} />
                <input type="hidden" name="on" value={isBookmarked ? '0' : '1'} />
                <input type="hidden" name="back" value={backHere} />
                <button class={`ghost${isBookmarked ? ' on' : ''}`} type="submit">
                  {isBookmarked ? `🔖 ${t('loc.bookmarked')}` : t('loc.bookmark')}
                </button>
              </form>

              <button
                class="ghost"
                type="button"
                data-share={canonical}
                data-name={location.name}
                data-label={t('loc.share')}
                data-copied={t('loc.linkCopied')}
                data-press-copy={t('loc.pressCopy')}
              >
                {t('loc.share')}
              </button>
            </div>

            {
              viewerId ? (
                <form method="post" action="/api/save" class="to-list">
                  <input type="hidden" name="action" value="add-to-list" />
                  <input type="hidden" name="locationId" value={location.id} />
                  <input type="hidden" name="back" value={backHere} />
                  <select name="listId" aria-label={t('loc.chooseList')}>
                    {myLists.map((l) => (
                      <option value={l.id}>{l.has ? `✓ ${l.name}` : l.name}</option>
                    ))}
                    <option value="__new">{t('loc.newList')}</option>
                  </select>
                  <input
                    name="newListName"
                    placeholder={t('loc.nameNewList')}
                    aria-label={t('loc.nameForNewList')}
                    class="new-list"
                  />
                  <button class="ghost" type="submit">{t('loc.addToList')}</button>
                </form>
              ) : null
            }

            {
              inListCount > 0 && (
                <span class="note in-lists">
                  {inListCount === 1
                    ? t('loc.inOneList', { name: myLists.find((l) => l.has)!.name })
                    : t('loc.inLists', { count: inListCount })}
                </span>
              )
            }

            {!viewerId && <span class="note">{t('loc.needAccount')}</span>}

            {saved === 'favorite' && <span class="note done">{t('loc.doneFavourite')}</span>}
            {saved === 'bucket_list' && <span class="note done">{t('loc.doneBookmark')}</span>}
            {saved === 'add-to-list' && <span class="note done">{t('loc.doneList')}</span>}
          </div>
        </div>

        <div class="panel quiet">
          {t('loc.getApp')} <a href={p('/')}>{t('loc.getAppLink')}</a>
        </div>

        <div class="panel quiet">
          {t('loc.wrong')} <a href={p(`/report?location=${location.id}`)}>{t('loc.reportIt')}</a>
        </div>
      </aside>
    </div>

    {
      nearby.length > 0 && (
        <section class="wrap nearby">
          <h2>{t('loc.nearby', { name: category ? category.toLowerCase() : t('loc.nearbyPlaces') })}</h2>
          <div class="nearby-grid">
            {nearby.map((place) => {
              const placeColour = categoryColor(place.category_slug);
              const placeRating = ratingLabel(place.avg_rating, place.review_count);
              const cover = publicUrl(place.cover_photo_path);
              return (
                <a class="near-card" href={`/location/${place.id}`} style={`border-color:${placeColour}`}>
                  {cover ? (
                    <div class="near-photo" style={`background-image:url("${cover}")`} />
                  ) : (
                    <div class="near-photo flat" style={`background:${placeColour}`}>
                      <span class="mono">{place.category_label ?? ''}</span>
                    </div>
                  )}
                  <div class="near-body">
                    <span class="near-name">{place.name}</span>
                    <span class="mono near-meta">
                      {placeRating.rated ? `★ ${placeRating.avg}` : t('common.notRated')}
                      {` · ${(place.distance_m / 1000).toFixed(1)} km`}
                    </span>
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      )
    }
    {/*
    One overlay for every gallery on the page, filled from whichever set was
    clicked. The hidden attribute keeps it out of the accessibility tree
    until it is actually open.
  */}
  <div class="gallery" id="gallery" hidden role="dialog" aria-modal="true" aria-label={t('loc.gallery')}>
    <button class="gallery-close" type="button" data-gallery-close aria-label={t('common.close')}>×</button>
    <button class="gallery-nav prev" type="button" data-gallery-step="-1" aria-label={t('loc.previousPhoto')}>‹</button>
    <img class="gallery-image" alt="" />
    <button class="gallery-nav next" type="button" data-gallery-step="1" aria-label={t('loc.nextPhoto')}>›</button>
    <span class="mono gallery-count" data-gallery-count></span>
  </div>

  </main>

  <SiteFooter />
</Base>

<script is:inline>
  /*
   * Share: the native sheet where the browser has one, the clipboard
   * otherwise. The URL is on screen either way, so nothing is lost if both
   * are unavailable.
   */
  document.addEventListener('click', function (event) {
    var button = event.target.closest('[data-share]');
    if (!button) return;

    var url = button.dataset.share;
    var name = button.dataset.name || 'LocaStar';
    var label = button.dataset.label || 'Share';
    var say = function (text) {
      button.textContent = text;
      setTimeout(function () { button.textContent = label; }, 2000);
    };

    if (navigator.share) {
      navigator.share({ title: name, url: url }).catch(function () {
        /* Dismissing the sheet is not a failure worth reporting. */
      });
    } else if (navigator.clipboard) {
      navigator.clipboard.writeText(url).then(
        function () { say(button.dataset.copied || 'Link copied'); },
        function () { say(button.dataset.pressCopy || 'Press Ctrl+C'); }
      );
    } else {
      say(url);
    }
  });
</script>

<script is:inline>
  /*
   * One lightbox, shared by the place's own photos and by each review's.
   *
   * The mosaic only draws four tiles, so the tiles cannot be the source of
   * truth for what to page through — the full list comes from the JSON block
   * the page emits next to each set.
   */
  (function () {
    var overlay = document.getElementById('gallery');
    if (!overlay) return;

    var image = overlay.querySelector('.gallery-image');
    var counter = overlay.querySelector('[data-gallery-count]');
    var urls = [];
    var at = 0;
    var lastFocus = null;

    function show() {
      image.src = urls[at];
      counter.textContent = urls.length > 1 ? at + 1 + ' / ' + urls.length : '';
      overlay.classList.toggle('single', urls.length < 2);
    }

    function open(name, index) {
      var block = document.querySelector('[data-gallery-set="' + name + '"]');
      if (!block) return;
      try {
        urls = JSON.parse(block.textContent || '[]');
      } catch (error) {
        return;
      }
      if (!urls.length) return;

      at = Math.min(Math.max(index, 0), urls.length - 1);
      lastFocus = document.activeElement;
      overlay.hidden = false;
      document.body.style.overflow = 'hidden';
      show();
      overlay.querySelector('[data-gallery-close]').focus();
    }

    function close() {
      overlay.hidden = true;
      document.body.style.overflow = '';
      image.src = '';
      if (lastFocus && lastFocus.focus) lastFocus.focus();
    }

    function step(by) {
      if (urls.length < 2) return;
      at = (at + by + urls.length) % urls.length;
      show();
    }

    document.addEventListener('click', function (event) {
      var opener = event.target.closest('[data-open-gallery]');
      if (opener) {
        open(opener.dataset.openGallery, parseInt(opener.dataset.index, 10) || 0);
        return;
      }
      if (overlay.hidden) return;

      var nav = event.target.closest('[data-gallery-step]');
      if (nav) {
        step(parseInt(nav.dataset.galleryStep, 10));
        return;
      }
      /* The backdrop closes, the photo itself does not. */
      if (event.target.closest('[data-gallery-close]') || event.target === overlay) close();
    });

    document.addEventListener('keydown', function (event) {
      if (overlay.hidden) return;
      if (event.key === 'Escape') close();
      else if (event.key === 'ArrowLeft') step(-1);
      else if (event.key === 'ArrowRight') step(1);
    });
  })();
</script>

<style>
  /* ---- photo mosaic, 2fr/1fr at 420px as the mockup sets it ---- */
  /* The mockup is a 1440px canvas — the photos stop there, they do not bleed
     to the edge of a wide monitor. */
  .mosaic,
  .no-photo {
    max-width: 1440px;
    margin-inline: auto;
  }

