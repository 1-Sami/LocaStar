              <form method="POST">
                <input type="hidden" name="intent" value="photo" />
                <input type="hidden" name="photoId" value={photo.photoId ?? ''} />
                <input type="hidden" name="reviewPhotoId" value={photo.reviewPhotoId ?? ''} />
                <input type="hidden" name="removed" value="0" />
                <button class="mono mod-remove" type="submit">{t('loc.modRestorePhoto')}</button>
              </form>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  </main>

  <SiteFooter />
</Base>

<script is:inline>
  /*
   * Share: the native sheet where the browser has one, the clipboard
   * otherwise. The URL is on screen either way, so nothing is lost if both
   * are unavailable.
   */
  document.addEventListener('click', function (event) {
    var button = event.target.closest('[data-share]');
    if (!button) return;

    var url = button.dataset.share;
    var name = button.dataset.name || 'LocaStar';
    var label = button.dataset.label || 'Share';
    var say = function (text) {
      button.textContent = text;
      setTimeout(function () { button.textContent = label; }, 2000);
    };

    if (navigator.share) {
      navigator.share({ title: name, url: url }).catch(function () {
        /* Dismissing the sheet is not a failure worth reporting. */
      });
    } else if (navigator.clipboard) {
      navigator.clipboard.writeText(url).then(
        function () { say(button.dataset.copied || 'Link copied'); },
        function () { say(button.dataset.pressCopy || 'Press Ctrl+C'); }
      );
    } else {
      say(url);
    }
  });
</script>

<script is:inline>
  /*
   * One lightbox, shared by the place's own photos and by each review's.
   *
   * The mosaic only draws four tiles, so the tiles cannot be the source of
   * truth for what to page through — the full list comes from the JSON block
   * the page emits next to each set.
   */
  (function () {
    var overlay = document.getElementById('gallery');
    if (!overlay) return;

    var image = overlay.querySelector('.gallery-image');
    var counter = overlay.querySelector('[data-gallery-count]');
    var urls = [];
    var at = 0;
    var lastFocus = null;

    function show() {
      image.src = urls[at];
      counter.textContent = urls.length > 1 ? at + 1 + ' / ' + urls.length : '';
      overlay.classList.toggle('single', urls.length < 2);
      /*
       * An event rather than one global function: the moderator bar and the
       * report link both need to follow the photo, and a single hook can only
       * have one owner.
       */
      overlay.dispatchEvent(new CustomEvent('photochange', { detail: urls[at] }));
    }

    function open(name, index) {
      var block = document.querySelector('[data-gallery-set="' + name + '"]');
      if (!block) return;
      try {
        urls = JSON.parse(block.textContent || '[]');
      } catch (error) {
        return;
      }
      if (!urls.length) return;

      at = Math.min(Math.max(index, 0), urls.length - 1);
      lastFocus = document.activeElement;
      overlay.hidden = false;
      document.body.style.overflow = 'hidden';
      show();
      overlay.querySelector('[data-gallery-close]').focus();
    }

    function close() {
      overlay.hidden = true;
      document.body.style.overflow = '';
      image.src = '';
      if (lastFocus && lastFocus.focus) lastFocus.focus();
    }

    function step(by) {
      if (urls.length < 2) return;
      at = (at + by + urls.length) % urls.length;
      show();
    }

    document.addEventListener('click', function (event) {
      var opener = event.target.closest('[data-open-gallery]');
      if (opener) {
        open(opener.dataset.openGallery, parseInt(opener.dataset.index, 10) || 0);
        return;
      }
      if (overlay.hidden) return;

      var nav = event.target.closest('[data-gallery-step]');
      if (nav) {
        step(parseInt(nav.dataset.galleryStep, 10));
        return;
      }
      /* The backdrop closes, the photo itself does not. */
      if (event.target.closest('[data-gallery-close]') || event.target === overlay) close();
    });

    document.addEventListener('keydown', function (event) {
      if (overlay.hidden) return;
      if (event.key === 'Escape') close();
      else if (event.key === 'ArrowLeft') step(-1);
      else if (event.key === 'ArrowRight') step(1);
    });
  })();
</script>

<style>
  /* ---- photo mosaic, 2fr/1fr at 420px as the mockup sets it ---- */
  /* The mockup is a 1440px canvas — the photos stop there, they do not bleed
     to the edge of a wide monitor. */
  .mosaic,
  .no-photo {
    max-width: 1440px;
    margin-inline: auto;
  }

  /*
   * The mosaic adapts to how many photos there actually are.
   *
   * The mockup draws four. 985 of 998 places have none, and of those that do
   * most have one or two — laying every case out as a four-photo grid left a
   * black hole where the missing pictures would have been.
   */
  .mosaic {
    display: grid;
    gap: 6px;
    height: 420px;
    padding: 6px;
  }

  .mosaic.count-1 {
    grid-template-columns: 1fr;
  }

  .mosaic.count-2 {
    grid-template-columns: 1fr 1fr;
  }

  .mosaic.count-3,
  .mosaic.count-4 {
    grid-template-columns: 2fr 1fr;
  }

  .mosaic-side {
    display: grid;
    grid-template-rows: 1fr 1fr;
    gap: 6px;
  }

  .mosaic-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
  }

  .shot {
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-color: var(--surface);
  }

  .shot.last {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .more {
    font-size: 15px;
    letter-spacing: 0.1em;
    color: var(--text);
    background: rgba(7, 16, 15, 0.66);
    padding: 8px 12px;
    border-radius: 6px;
  }

  .no-photo {
    height: 260px;
    display: flex;
    align-items: flex-end;
    padding: 24px var(--gutter);
  }

  .no-photo .mono {
    font-size: 12px;
    letter-spacing: 0.16em;
    color: rgba(255, 255, 255, 0.85);
  }

  /* ---- body ---- */
  .body {
    display: grid;
    grid-template-columns: 1fr 400px;
    gap: 56px;
    padding-top: 44px;
  }

  .col-main {
    display: flex;
    flex-direction: column;
    gap: 34px;
    min-width: 0;
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .badges {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  /* The badge always carries the category name — colour is never the only
     signal, which is what keeps it accessible. */
  .badge {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 9.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 6px 10px;
    border-radius: 5px;
    color: #fff;
  }

  .badge.outline {
    background: transparent;
    border: 1px solid rgba(var(--ink-rgb), 0.2);
    color: var(--text-70);
  }

  .season {
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--text-42);
  }

  /* Outlined, not filled: the category badge beside it is the loud one, and a
     second solid chip would compete with it for the same glance. Free takes
     the accent colour because it is the answer people look for. */
  .price {
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 4px 9px;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--text-70);
  }

  .price.free {
    border-color: var(--accent);
