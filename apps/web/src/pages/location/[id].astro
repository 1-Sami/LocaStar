          data-restore-label={t('loc.modRestorePhoto')}
          data-remove-confirm={t('loc.modRemovePhotoConfirm')}
        >
          {/*
            Cover is offered only for a photo the place owns. A review photo
            belongs to its review, and promoting one would put a picture on the
            place that its author could delete out from under it — so the
            script hides this form rather than letting it fail.
          */}
          <form method="POST" data-mod-cover hidden>
            <input type="hidden" name="intent" value="cover" />
            <input type="hidden" name="photoId" value="" data-mod-cover-id />
            <button class="gallery-mod-btn" type="submit">{t('loc.modMakeCover')}</button>
          </form>
          <form method="POST">
            <input type="hidden" name="intent" value="photo" />
            <input type="hidden" name="photoId" value="" data-mod-photo-id />
            <input type="hidden" name="reviewPhotoId" value="" data-mod-review-photo-id />
            <input type="hidden" name="removed" value="1" data-mod-removed />
            <button class="gallery-mod-btn danger" type="submit" data-mod-toggle>
              {t('loc.modRemovePhoto')}
            </button>
          </form>
        </div>
