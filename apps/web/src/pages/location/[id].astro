---
import {
  fetchLocationById,
  fetchLocationPhotos,
  fetchNearbyLocations,
  fetchReviews,
  isAlwaysOpen,
} from '@locastar/shared';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Base from '../../layouts/Base.astro';
import { categoryColor, longDate, metaDescription, ratingLabel, relativeDate } from '../../lib/format';
import { anonClient } from '../../lib/supabase';

export const prerender = false;

const { id } = Astro.params;
const supabase = anonClient();

/*
 * A frozen URL — every "Copy link" in the shipped app points here, so it has to
 * resolve for a stranger with no account. RLS decides what comes back: an
 * active public place is readable by `anon`, while a removed one and a retired
 * activity are not, which is exactly the behaviour we want. A miss is a real
 * 404, not an error.
 */
let location;
try {
  location = id ? await fetchLocationById(supabase, id) : null;
} catch (error) {
  /*
   * A failed request is not a missing page.
   *
   * Swallowing this into a 404 tells Google the place is gone, and Google
   * acts on that by dropping it from the index — a transient blip during a
   * crawl would quietly cost the page its ranking. 503 says "ask again",
   * which is the truth.
   */
  console.error('Failed to load location', id, error);
  return new Response('Temporarily unavailable', {
    status: 503,
    headers: { 'Retry-After': '60' },
  });
}

// Genuinely absent, or hidden from anonymous readers by RLS. That is a 404.
if (!location) return new Response(null, { status: 404 });

const [photos, reviews] = await Promise.all([
  fetchLocationPhotos(supabase, location.id).catch(() => []),
  fetchReviews(supabase, location.id).catch(() => []),
]);

/*
 * "More basketball nearby" — internal linking between category pages and place
 * pages is what earns rankings, so this block is load-bearing rather than
 * decoration. One extra is requested because this place matches its own query.
 */
const nearbyRaw = location.category_slug
  ? await fetchNearbyLocations(supabase, {
      lat: location.lat,
      lng: location.lng,
      categorySlugs: [location.category_slug],
      sort: 'distance',
      maxResults: 5,
    }).catch(() => [])
  : [];

const nearby = nearbyRaw.filter((place) => place.id !== location.id).slice(0, 4);

const publicUrl = (path: string | null) =>
  path ? supabase.storage.from('media').getPublicUrl(path).data.publicUrl : null;

const colour = categoryColor(location.category_slug);
const rating = ratingLabel(location.avg_rating, location.review_count);
const alwaysOpen = location.hours ? isAlwaysOpen(location.hours) : false;
const hasHours = Boolean(location.hours && Object.keys(location.hours).length > 0);

const category = location.category_label;
const city = location.city;

const title =
  [location.name, category ? `— ${category}` : null, city ? `in ${city}` : null].filter(Boolean).join(' ') +
  ' | LocaStar';
const description = metaDescription(location.description, { name: location.name, category, city });
const origin = Astro.site?.origin ?? Astro.url.origin;
const canonical = new URL(`/location/${location.id}`, origin).href;

/*
 * aggregateRating appears only when reviews exist.
 *
 * Every new place sits at 0.0 with no reviews, and structured data that
 * disagrees with the page is worse than none — Google discards it and can
 * distrust the rest. Omitting the field is the honest option.
 */
const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'SportsActivityLocation',
    name: location.name,
    ...(location.description ? { description: location.description } : {}),
    ...(location.address
      ? {
          address: {
            '@type': 'PostalAddress',
            streetAddress: location.address,
            ...(city ? { addressLocality: city } : {}),
            ...(location.country ? { addressCountry: location.country } : {}),
          },
        }
      : {}),
    geo: { '@type': 'GeoCoordinates', latitude: location.lat, longitude: location.lng },
    ...(photos.length ? { photo: photos.map((photo) => photo.url) } : {}),
    ...(location.website ? { sameAs: location.website } : {}),
    ...(rating.rated
      ? {
          aggregateRating: {
            '@type': 'AggregateRating',
            ratingValue: location.avg_rating,
            reviewCount: location.review_count,
          },
        }
      : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'LocaStar', item: `${origin}/` },
      ...(category && location.category_slug
        ? [{ '@type': 'ListItem', position: 2, name: category, item: `${origin}/activity/${location.category_slug}` }]
        : []),
      { '@type': 'ListItem', position: category ? 3 : 2, name: location.name, item: canonical },
    ],
  },
];

const mapsHref = `https://www.google.com/maps/dir/?api=1&destination=${location.lat},${location.lng}`;
const seasonLabel =
  location.available_summer && location.available_winter
    ? 'All year'
    : location.available_summer
      ? 'Summer'
      : location.available_winter
        ? 'Winter'
        : 'Not stated';
---

<Base title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <SiteHeader />

  <main id="main">
    {
      photos.length > 0 ? (
        <div class="mosaic">
          <div class="shot main" style={`background-image:url("${photos[0].url}")`} />
          {photos.length > 1 && (
            <div class="mosaic-side">
              <div class="shot" style={`background-image:url("${photos[1].url}")`} />
              {photos.length > 2 && (
                <div class="mosaic-pair">
                  <div class="shot" style={`background-image:url("${photos[2].url}")`} />
                  <div
                    class="shot last"
                    style={photos[3] ? `background-image:url("${photos[3].url}")` : `background:${colour}`}
                  >
                    {photos.length > 4 && <span class="mono more">+{photos.length - 4}</span>}
                  </div>
                </div>
              )}
            </div>
          )}
        </div>
      ) : (
        /* The common case: 985 of 996 places have no photo. A flat tile in the
           category colour with the category named — never a broken image, never
           a grey box, never a stock photo of somewhere else. */
        <div class="no-photo" style={`background:${colour}`}>
          <span class="mono">{category ?? 'LocaStar'}</span>
        </div>
      )
    }

    <div class="wrap body">
      <div class="col-main">
        <header class="head">
          <div class="badges">
            {category && <span class="badge" style={`background:${colour}`}>{category}</span>}
            {location.kind === 'activity' && <span class="badge outline">Activity</span>}
            {(location.available_summer || location.available_winter) && (
              <span class="mono season">
                {[location.available_summer && 'Summer', location.available_winter && 'Winter']
                  .filter(Boolean)
                  .join(' · ')}
              </span>
            )}
          </div>

          <h1>{location.name}</h1>

          <div class="meta">
            {
              rating.rated ? (
                <>
                  <span class="mono star">★ {rating.avg}</span>
                  <span class="soft">
                    {rating.count} {rating.count === 1 ? 'review' : 'reviews'}
                  </span>
                </>
              ) : (
                /* Not empty stars — those read as "rated badly" rather than
                   "nobody has been yet". */
                <span class="mono unrated">Not rated yet</span>
              )
            }
            {location.address && (
              <>
                <span class="rule" />
                <span class="soft">{location.address}</span>
              </>
            )}
          </div>
        </header>

        {location.description && <p class="description">{location.description}</p>}

        <div class="info">
          <div class="card">
            <span class="mono label">Opening hours</span>
            <div class="value">{alwaysOpen ? 'Open 24/7' : hasHours ? 'Varies by day' : 'Not stated'}</div>
          </div>
          <div class="card">
            <span class="mono label">Season</span>
            <div class="value">{seasonLabel}</div>
          </div>
          <div class="card">
            <span class="mono label">Added by</span>
            <div class="value">
              {location.creator_visible && location.creator_username ? location.creator_username : 'Someone on LocaStar'}
            </div>
            <span class="sub">{longDate(location.created_at)}</span>
          </div>
        </div>

        <div class="hairline" />

        <section class="reviews">
          <div class="reviews-head">
            <h2>Reviews</h2>
            {reviews.length > 1 && <span class="mono soft">Most recent</span>}
          </div>

          {
            reviews.length === 0 ? (
              <div class="empty">
                <p class="empty-lead">Nobody has reviewed this yet.</p>
                <p class="sub">If you have been here, you know something the map does not.</p>
              </div>
            ) : (
              <div class="review-list">
                {reviews.map((review) => (
                  <article class="review">
                    <div
                      class="avatar"
                      style={
                        review.author_avatar_url
                          ? `background-image:url("${review.author_avatar_url}")`
                          : `background:${colour}`
                      }
                    />
                    <div class="review-body">
                      <div class="review-head">
                        <span class="who">{review.author_name}</span>
                        <span class="mono star" aria-label={`${review.rating} out of 5`}>
                          {'★'.repeat(review.rating)}
                          {'☆'.repeat(5 - review.rating)}
                        </span>
                        <span class="mono when">{relativeDate(review.created_at)}</span>
                        <a class="mono report" href={`/report?review=${review.id}&location=${location.id}`}>
                          REPORT
                        </a>
                      </div>
                      {review.title && <strong class="review-title">{review.title}</strong>}
                      {review.body && <p class="review-text">{review.body}</p>}
                      {review.photos.length > 0 && (
                        <div class="review-photos">
                          {review.photos.map((url) => (
                            <div class="thumb" style={`background-image:url("${url}")`} />
                          ))}
                        </div>
                      )}
                    </div>
                  </article>
                ))}
              </div>
            )
          }
        </section>
      </div>

      <aside class="col-side">
        <div class="panel">
          <div class="map-slot mono">Map</div>
          <div class="panel-actions">
            <a class="cta" href={mapsHref} rel="noopener noreferrer" target="_blank">Directions</a>
            <div class="secondary">
              <a class="ghost" href="/auth/sign-in">Save</a>
              <a class="ghost" href="/auth/sign-in">Add to list</a>
              <a class="ghost narrow" href={`/location/${location.id}`}>Share</a>
            </div>
            <span class="note">Saving needs an account — free, in the app or here.</span>
          </div>
        </div>

        <div class="panel quiet">
          Want distance from where you are, and turn-by-turn? <a href="/">Get the LocaStar app →</a>
        </div>

        {
          !location.is_verified && (
            <div class="panel quiet">
              <strong>Do you run this place?</strong>
              <span>Claim it to keep the details right.</span>
              <a class="quiet-link" href="/contact#claim">Claim this place →</a>
            </div>
          )
        }

        <div class="panel quiet">
          Something wrong or gone? <a href={`/report?location=${location.id}`}>Report it</a>
        </div>
      </aside>
    </div>

    {
      nearby.length > 0 && (
        <section class="wrap nearby">
          <h2>More {category ? category.toLowerCase() : 'places'} nearby</h2>
          <div class="nearby-grid">
            {nearby.map((place) => {
              const placeColour = categoryColor(place.category_slug);
              const placeRating = ratingLabel(place.avg_rating, place.review_count);
              const cover = publicUrl(place.cover_photo_path);
              return (
                <a class="near-card" href={`/location/${place.id}`} style={`border-color:${placeColour}`}>
                  {cover ? (
                    <div class="near-photo" style={`background-image:url("${cover}")`} />
                  ) : (
                    <div class="near-photo flat" style={`background:${placeColour}`}>
                      <span class="mono">{place.category_label ?? ''}</span>
                    </div>
                  )}
                  <div class="near-body">
                    <span class="near-name">{place.name}</span>
                    <span class="mono near-meta">
                      {placeRating.rated ? `★ ${placeRating.avg}` : 'Not rated yet'}
                      {` · ${(place.distance_m / 1000).toFixed(1)} km`}
                    </span>
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      )
    }
    <SiteFooter />
  </main>
</Base>

<style>
  /* ---- photo mosaic, 2fr/1fr at 420px as the mockup sets it ---- */
  /* The mockup is a 1440px canvas — the photos stop there, they do not bleed
     to the edge of a wide monitor. */
  .mosaic,
  .no-photo {
    max-width: 1440px;
    margin-inline: auto;
  }

  .mosaic {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 6px;
    height: 420px;
    padding: 6px;
  }

  .mosaic-side {
    display: grid;
    grid-template-rows: 1fr 1fr;
    gap: 6px;
  }

  .mosaic-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
  }

  .shot {
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-color: var(--surface);
  }

  .shot.last {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .more {
    font-size: 15px;
    letter-spacing: 0.1em;
    color: var(--text);
    background: rgba(7, 16, 15, 0.66);
    padding: 8px 12px;
    border-radius: 6px;
  }

  .no-photo {
    height: 260px;
    display: flex;
    align-items: flex-end;
    padding: 24px var(--gutter);
  }

  .no-photo .mono {
    font-size: 12px;
    letter-spacing: 0.16em;
    color: rgba(255, 255, 255, 0.85);
  }

  /* ---- body ---- */
  .body {
    display: grid;
    grid-template-columns: 1fr 400px;
    gap: 56px;
    padding-top: 44px;
  }

  .col-main {
    display: flex;
    flex-direction: column;
    gap: 34px;
    min-width: 0;
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .badges {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  /* The badge always carries the category name — colour is never the only
     signal, which is what keeps it accessible. */
  .badge {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 9.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 6px 10px;
    border-radius: 5px;
    color: #fff;
  }

  .badge.outline {
    background: transparent;
    border: 1px solid rgba(244, 246, 245, 0.2);
    color: var(--text-70);
  }

  .season {
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--text-42);
  }

  h1 {
    font-size: clamp(34px, 5vw, 60px);
    line-height: 1.02;
    letter-spacing: -0.035em;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }

  .star {
    font-size: 17px;
    letter-spacing: 0.02em;
    color: var(--accent);
  }

  .unrated {
    font-size: 11.5px;
    letter-spacing: 0.14em;
    color: var(--text-42);
  }

  .soft {
    font-size: 15px;
    color: var(--text-55);
  }

  .rule {
    width: 1px;
    height: 15px;
    background: rgba(244, 246, 245, 0.18);
  }

  .description {
    font-size: 19px;
    line-height: 1.65;
    color: var(--text-70);
    margin: 0;
    max-width: 640px;
    text-wrap: pretty;
  }

  .info {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 11px;
    padding: 18px;
  }

  .label {
    font-size: 9.5px;
    letter-spacing: 0.16em;
    color: var(--text-42);
  }

  .value {
    font-size: 16px;
    line-height: 1.4;
    margin-top: 10px;
  }

  .sub {
    font-size: 12.5px;
    color: var(--text-55);
  }

  .hairline {
    height: 1px;
    background: var(--hairline);
  }

  /* ---- reviews ---- */
  .reviews {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .reviews-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }

  .reviews-head h2 {
    font-size: 26px;
  }

  .review-list {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .review {
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 11px;
    padding: 20px;
    display: flex;
    gap: 16px;
  }

  .avatar {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    flex: none;
    background-size: cover;
    background-position: center;
  }

  .review-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 9px;
    min-width: 0;
  }

  .review-head {
    display: flex;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }

  .who {
    font-weight: 500;
    font-size: 15px;
  }

  .review-head .star {
    font-size: 12px;
  }

  .report {
    font-size: 10px;
    letter-spacing: 0.12em;
    color: var(--text-42);
    margin-left: auto;
  }

  .report:hover {
    color: var(--accent);
  }

  .when {
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--text-42);
  }

  .review-title {
    font-weight: 500;
    font-size: 15px;
  }

  .review-text {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-70);
    margin: 0;
  }

  .review-photos {
    display: flex;
    gap: 7px;
    margin-top: 3px;
    flex-wrap: wrap;
  }

  .thumb {
    width: 86px;
    height: 64px;
    border-radius: 6px;
    background-size: cover;
    background-position: center;
    background-color: var(--surface-alt);
  }

  /* The state most pages will actually be in. It names a next action rather
     than just reporting absence. */
  .empty {
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 11px;
    padding: 26px;
  }

  .empty-lead {
    margin: 0;
    font-size: 17px;
  }

  .empty .sub {
    display: block;
    margin-top: 6px;
  }

  /* ---- side column ---- */
  .col-side {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-self: start;
    position: sticky;
    top: 24px;
  }

  .panel {
    background: var(--surface);
    border: 1px solid rgba(244, 246, 245, 0.12);
    border-radius: 13px;
    overflow: hidden;
  }

  .map-slot {
    height: 186px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--surface-alt);
    font-size: 10px;
    color: var(--text-42);
  }

  .panel-actions {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 11px;
  }

  .cta {
    background: var(--accent);
    border-radius: 9px;
    padding: 14px;
    text-align: center;
    font-weight: 600;
    font-size: 16px;
    color: var(--page);
  }

  .cta:hover {
    background: #f0b94e;
    color: var(--page);
  }

  .note {
    margin: 0;
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--text-42);
    text-align: center;
  }

  .secondary {
    display: flex;
    gap: 9px;
  }

  .ghost {
    flex: 1;
    border: 1px solid rgba(244, 246, 245, 0.22);
    border-radius: 9px;
    padding: 13px;
    text-align: center;
    font-weight: 500;
    font-size: 14px;
    color: var(--text);
  }

  .ghost:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .ghost.narrow {
    flex: none;
    padding-inline: 15px;
  }

  .quiet-link {
    font-weight: 500;
    font-size: 13px;
    margin-top: 3px;
  }

  .panel.quiet {
    background: transparent;
    padding: 18px 20px;
    font-size: 13px;
    line-height: 1.5;
    color: var(--text-55);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .panel.quiet strong {
    font-weight: 500;
    font-size: 14.5px;
    color: var(--text);
  }

  /* ---- nearby ---- */
  .nearby {
    padding-block: 64px 44px;
  }

  .nearby h2 {
    font-size: 26px;
    margin-bottom: 20px;
  }

  .nearby-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .near-card {
    border: 1px solid;
    border-radius: 11px;
    overflow: hidden;
    background: var(--surface);
    color: var(--text);
    display: flex;
    flex-direction: column;
    transition: box-shadow 120ms ease-out;
  }

  /* No lift — depth comes from the ring, per the handoff. */
  .near-card:hover {
    color: var(--text);
    box-shadow: 0 0 0 3px rgba(232, 169, 59, 0.12);
  }

  .near-photo {
    height: 120px;
    background-size: cover;
    background-position: center;
  }

  .near-photo.flat {
    display: flex;
    align-items: flex-end;
    padding: 12px;
  }

  .near-photo.flat .mono {
    font-size: 10px;
    letter-spacing: 0.14em;
    color: rgba(255, 255, 255, 0.85);
  }

  .near-body {
    padding: 13px;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .near-name {
    font-weight: 500;
    font-size: 15px;
    line-height: 1.2;
  }

  .near-meta {
    font-size: 11.5px;
    letter-spacing: 0.06em;
    color: var(--accent);
  }

  /* ---- 768–1279: map becomes secondary, grids halve ---- */
  @media (max-width: 1279px) {
    .body {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .col-side {
      position: static;
    }

    .nearby-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 767px) {
    .mosaic {
      grid-template-columns: 1fr;
      height: 260px;
    }

    .mosaic-side {
      display: none;
    }

    .info {
      grid-template-columns: 1fr;
    }

    .nearby-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
