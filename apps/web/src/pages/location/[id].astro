    /*
     * Directions above the reviews.
     *
     * Both columns become one here, and the side column is second in the
     * markup, so the way to actually get to the place sat below every review
     * of it. display: contents drops the two column boxes so their children
     * become items of the page grid directly, which is what makes it possible
     * to put one of them between the facts and the reviews rather than only
     * before or after both.
     */
    .col-main,
    .col-side {
      display: contents;
    }

    .body {
