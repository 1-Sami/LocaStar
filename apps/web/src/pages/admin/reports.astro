---
import {
  fetchHandledListReports,
  fetchHandledLocationReports,
  fetchHandledReviewReports,
  fetchOpenListReports,
  fetchOpenLocationReports,
  fetchOpenReviewReports,
  fetchProfile,
  isModeratorRole,
  issueWarning,
  resolveListReport,
  resolveLocationReport,
  resolveReviewReport,
  updateLocationStatus,
  updateReviewStatus,
} from '@locastar/shared';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Base from '../../layouts/Base.astro';
import { useTranslations, localePath } from '../../i18n/ui';
import { longDate } from '../../lib/format';
import { currentUser } from '../../lib/auth';

/*
 * The moderation queue, on a keyboard.
 *
 * Judging a report is reading, comparing and typing a reason — desk work that
 * the app made you do on a phone. It also ships without a store review, which
 * matters: when a binary is sitting with Apple there is otherwise no way to
 * act on anything at all.
 *
 * Every query runs as the signed-in moderator through their own session, so
 * RLS decides what comes back and what an action is allowed to do. The role
 * check below only decides what to *show* — it is not the thing that protects
 * anything, exactly as in the app.
 */
export const prerender = false;

const lang = Astro.locals.lang ?? 'en';
const t = useTranslations(lang);
const p = (href: string) => localePath(href, lang);

const { user, supabase } = await currentUser(Astro.cookies, Astro.request.headers);
if (!user) return Astro.redirect(p('/auth/sign-in'));

const profile = await fetchProfile(supabase, user.id).catch(() => null);
const role = profile?.role ?? 'user';
if (!isModeratorRole(role)) return Astro.redirect(p('/account'));

let actionError: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const kind = String(form.get('kind') ?? '');
  const reportId = String(form.get('reportId') ?? '');
  const decision = String(form.get('decision') ?? '');
  const note = String(form.get('note') ?? '').trim();
  const targetId = String(form.get('targetId') ?? '');
  const authorId = String(form.get('authorId') ?? '');

  /*
   * A written reason is required, same as the app. The moderation log is only
   * worth keeping if it says why, and "" is not a why. Three words is the
   * floor at which a decision can be reconstructed later.
   */
  if (note.split(/\s+/).filter(Boolean).length < 3) {
    actionError = t('mod.noteTooShort');
  } else {
    try {
      const status = decision === 'dismissed' ? 'dismissed' : 'actioned';

      if (decision === 'warned' && authorId) {
        await issueWarning(supabase, {
          userId: authorId,
          issuedBy: user.id,
          reason: note,
          targetType: kind,
          targetId,
        });
      }

      if (kind === 'location') {
        if (decision === 'removed') await updateLocationStatus(supabase, targetId, 'removed');
        await resolveLocationReport(supabase, reportId, status, user.id, decision as never, note);
      } else if (kind === 'review') {
        if (decision === 'removed') await updateReviewStatus(supabase, targetId, 'removed');
        await resolveReviewReport(supabase, reportId, status, user.id, decision as never, note);
      } else if (kind === 'list') {
        await resolveListReport(supabase, reportId, status, user.id, decision as never, note);
      }

      return Astro.redirect(`${p('/admin/reports')}?tab=${kind}&done=1`);
    } catch (err) {
      console.error('Moderation action failed', err);
      actionError = t('mod.actionFailed');
    }
  }
}

const tab = Astro.url.searchParams.get('tab') ?? 'location';
const done = Astro.url.searchParams.get('done') === '1';
const showHandled = Astro.url.searchParams.get('handled') === '1';

const [openLocations, openReviews, openLists] = await Promise.all([
  fetchOpenLocationReports(supabase).catch(() => []),
  fetchOpenReviewReports(supabase).catch(() => []),
  fetchOpenListReports(supabase).catch(() => []),
]);

const handled = showHandled
  ? await (tab === 'review'
      ? fetchHandledReviewReports(supabase)
      : tab === 'list'
        ? fetchHandledListReports(supabase)
        : fetchHandledLocationReports(supabase)
    ).catch(() => [])
  : [];

const tabs = [
  { key: 'location', label: t('mod.tabPlaces'), count: openLocations.length },
  { key: 'review', label: t('mod.tabReviews'), count: openReviews.length },
  { key: 'list', label: t('mod.tabLists'), count: openLists.length },
];

const isAdmin = role === 'admin';
const origin = Astro.site?.origin ?? Astro.url.origin;
---

<Base title={t('mod.title')} description={t('mod.subtitle')} canonical={`${origin}/admin/reports`}>
  <SiteHeader />

  <main class="wrap">
    <header class="head">
      <p class="mono kicker">{t('mod.kicker')}</p>
      <h1>{t('mod.title')}</h1>
      <p class="sub">{t('mod.subtitle')}</p>
    </header>

    {done && <p class="flash ok">{t('mod.done')}</p>}
    {actionError && <p class="flash bad">{actionError}</p>}

    <nav class="tabs" aria-label={t('mod.title')}>
      {tabs.map((item) => (
        <a
          href={`${p('/admin/reports')}?tab=${item.key}`}
          class:list={['tab', { on: tab === item.key }]}
          aria-current={tab === item.key ? 'page' : undefined}>
          {item.label} <span class="mono count">{item.count}</span>
        </a>
      ))}
    </nav>

    {tab === 'location' && (
      <section class="queue">
        {openLocations.length === 0 ? (
          <p class="empty">{t('mod.empty')}</p>
        ) : (
          openLocations.map((report) => (
            <article class="card">
              <div class="card-head">
                <a href={p(`/location/${report.locationId}`)} class="target">{report.locationName}</a>
                <span class="mono when">{longDate(report.createdAt, lang)}</span>
              </div>
              <div class="field">
                <span class="mono field-label">{t('mod.reasonLabel')}</span>
                <p class="reason">{report.reason}</p>
                {report.details && <p class="details">{report.details}</p>}
              </div>
              {report.fromBlock && <p class="from-block">{t('mod.fromBlock')}</p>}
              <p class="mono by">{t('mod.reportedBy')} {report.reporterName} · {t('mod.author')} {report.locationCreatorName}</p>

              <form method="POST" class="actions">
                <input type="hidden" name="kind" value="location" />
                <input type="hidden" name="reportId" value={report.id} />
                <input type="hidden" name="targetId" value={report.locationId} />
                <input type="hidden" name="authorId" value={report.locationCreatorId ?? ''} />
                <label class="note-label">
                  <span class="mono">{t('mod.note')}</span>
                  <input type="text" name="note" required minlength={3} placeholder={t('mod.notePlaceholder')} />
                </label>
                <div class="buttons">
                  <button type="submit" name="decision" value="dismissed" class="btn">{t('mod.dismiss')}</button>
                  {report.locationCreatorId && (
                    <button type="submit" name="decision" value="warned" class="btn warn">{t('mod.warn')}</button>
                  )}
                  {isAdmin && !report.fromBlock && (
                    <button type="submit" name="decision" value="removed" class="btn danger">{t('mod.remove')}</button>
                  )}
                </div>
              </form>
            </article>
          ))
        )}
      </section>
    )}

    {tab === 'review' && (
      <section class="queue">
        {openReviews.length === 0 ? (
          <p class="empty">{t('mod.empty')}</p>
        ) : (
          openReviews.map((report) => (
            <article class="card">
              <div class="card-head">
                <a href={p(`/location/${report.locationId}`)} class="target">{report.locationName}</a>
                <span class="mono when">{longDate(report.createdAt, lang)}</span>
              </div>
              <div class="content">
                <span class="mono field-label">{t('mod.contentLabel')}</span>
                {report.reviewTitle && <p class="quote-title">{report.reviewTitle}</p>}
                {report.reviewBody && <blockquote class="quote">{report.reviewBody}</blockquote>}
              </div>
              <div class="field">
                <span class="mono field-label">{t('mod.reasonLabel')}</span>
                <p class="reason">{report.reason}</p>
                {report.details && <p class="details">{report.details}</p>}
              </div>
              {report.fromBlock && <p class="from-block">{t('mod.fromBlock')}</p>}
              <p class="mono by">{t('mod.reportedBy')} {report.reporterName} · {t('mod.author')} {report.reviewAuthorName}</p>

              <form method="POST" class="actions">
                <input type="hidden" name="kind" value="review" />
                <input type="hidden" name="reportId" value={report.id} />
                <input type="hidden" name="targetId" value={report.reviewId} />
                <input type="hidden" name="authorId" value={report.reviewAuthorId ?? ''} />
                <label class="note-label">
                  <span class="mono">{t('mod.note')}</span>
                  <input type="text" name="note" required minlength={3} placeholder={t('mod.notePlaceholder')} />
                </label>
                <div class="buttons">
                  <button type="submit" name="decision" value="dismissed" class="btn">{t('mod.dismiss')}</button>
                  {report.reviewAuthorId && (
                    <button type="submit" name="decision" value="warned" class="btn warn">{t('mod.warn')}</button>
                  )}
                  {!report.fromBlock && (
                    <button type="submit" name="decision" value="removed" class="btn danger">{t('mod.remove')}</button>
                  )}
                </div>
              </form>
            </article>
          ))
        )}
      </section>
    )}

    {tab === 'list' && (
      <section class="queue">
        {openLists.length === 0 ? (
          <p class="empty">{t('mod.empty')}</p>
        ) : (
          openLists.map((report) => (
            <article class="card">
              <div class="card-head">
                <a href={p(`/lists/${report.listId}`)} class="target">{report.listName}</a>
                <span class="mono when">{longDate(report.createdAt, lang)}</span>
              </div>
              {report.listDescription && (
                <div class="content">
                  <span class="mono field-label">{t('mod.contentLabel')}</span>
                  <blockquote class="quote">{report.listDescription}</blockquote>
                </div>
              )}
              <div class="field">
                <span class="mono field-label">{t('mod.reasonLabel')}</span>
                <p class="reason">{report.reason}</p>
                {report.details && <p class="details">{report.details}</p>}
              </div>
              {report.fromBlock && <p class="from-block">{t('mod.fromBlock')}</p>}
              <p class="mono by">{t('mod.reportedBy')} {report.reporterName} · {t('mod.author')} {report.ownerName}</p>

              {/* No Remove here. A list is deleted from the list itself, where
                  what is in it can be seen first — same rule as the app. */}
              <form method="POST" class="actions">
                <input type="hidden" name="kind" value="list" />
                <input type="hidden" name="reportId" value={report.id} />
                <input type="hidden" name="targetId" value={report.listId} />
                <input type="hidden" name="authorId" value={report.ownerId ?? ''} />
                <label class="note-label">
                  <span class="mono">{t('mod.note')}</span>
                  <input type="text" name="note" required minlength={3} placeholder={t('mod.notePlaceholder')} />
                </label>
                <div class="buttons">
                  <button type="submit" name="decision" value="dismissed" class="btn">{t('mod.dismiss')}</button>
                  {report.ownerId && (
                    <button type="submit" name="decision" value="warned" class="btn warn">{t('mod.warn')}</button>
                  )}
                </div>
              </form>
            </article>
          ))
        )}
      </section>
    )}

    <section class="handled">
      {showHandled ? (
        <>
          <h2>{t('mod.handled')}</h2>
          {handled.length === 0 ? (
            <p class="empty">{t('mod.handledEmpty')}</p>
          ) : (
            <ul class="log">
              {handled.map((report) => (
                <li>
                  <span class="mono when">{report.resolvedAt ? longDate(report.resolvedAt, lang) : ''}</span>
                  <span class={`verdict ${report.resolutionAction ?? ''}`}>{report.resolutionAction}</span>
                  <span class="log-note">{report.resolutionNote}</span>
                </li>
              ))}
            </ul>
          )}
          <a class="toggle" href={`${p('/admin/reports')}?tab=${tab}`}>{t('mod.hideHandled')}</a>
        </>
      ) : (
        <a class="toggle" href={`${p('/admin/reports')}?tab=${tab}&handled=1`}>{t('mod.showHandled')}</a>
      )}
    </section>
  </main>

  <SiteFooter />
</Base>

<style>
  /*
   * Written against the real tokens in styles/tokens.css. The first pass used
   * invented names (--rule, --muted, --fg), so every border and every muted
   * colour silently fell back and the page arrived as one flat column of
   * same-weight text with no card edges and invisible inputs.
   *
   * The hierarchy the queue needs, in order: what was written, then why it was
   * reported, then who, then what you do about it. Depth comes from --surface
   * against --page and from hairlines, per the note at the top of tokens.css.
   */
  .wrap {
    max-width: 780px;
    margin: 0 auto;
    padding: 48px var(--gutter) 96px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .head { display: flex; flex-direction: column; gap: 10px; }
  .kicker { font-size: 12px; letter-spacing: .16em; color: var(--accent); margin: 0; }
  h1 { margin: 0; font-size: clamp(32px, 5vw, 44px); line-height: 1.05; }
  .sub { margin: 0; color: var(--text-70); max-width: 60ch; }

  .flash { margin: 0; padding: 13px 16px; border-radius: 9px; font-size: 15px; }
  .flash.ok { background: rgba(76, 211, 122, .12); color: var(--ok); }
  .flash.bad { background: rgba(224, 82, 82, .13); color: #f09a9a; }

  .tabs { display: flex; flex-wrap: wrap; gap: 8px; }
  .tab {
    display: inline-flex;
    align-items: baseline;
    gap: 7px;
    padding: 9px 16px;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    text-decoration: none;
    color: var(--text-70);
    font-size: 15px;
    background: var(--surface);
  }
  .tab:hover { border-color: var(--border); color: var(--text); }
  .tab.on { border-color: var(--brand-light); color: var(--text); background: var(--surface-alt); }
  .count { font-size: 12px; color: var(--text-55); }
  .tab.on .count { color: var(--brand-light); }

  .queue { display: flex; flex-direction: column; gap: 18px; }
  .empty { color: var(--text-55); margin: 0; }

  .card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 12px;
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .card-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--hairline);
  }
  .target { font-weight: 600; color: var(--text); text-decoration: none; }
  .target:hover { color: var(--link); }
  .when { font-size: 11px; letter-spacing: .08em; color: var(--text-42); }

  /* The content being judged. Indented and set apart, because it is the one
     thing on the card that is somebody else's words rather than ours. */
  .content { display: flex; flex-direction: column; gap: 6px; }
  .quote-title { margin: 0; font-weight: 600; font-size: 17px; }
  .quote {
    margin: 0;
    padding: 10px 14px;
    background: var(--surface-alt);
    border-left: 3px solid var(--border);
    border-radius: 0 7px 7px 0;
    color: var(--text-70);
  }

  .field { display: flex; flex-direction: column; gap: 4px; }
  .field-label {
    font-size: 10px;
    letter-spacing: .14em;
    color: var(--text-42);
  }
  .reason { margin: 0; font-weight: 600; color: var(--accent); }
  .details { margin: 0; color: var(--text-70); }
  .from-block {
    margin: 0;
    font-size: 14px;
    color: var(--accent);
    background: rgba(232, 169, 59, .1);
    border-radius: 7px;
    padding: 9px 13px;
  }
  .by { margin: 0; font-size: 11px; letter-spacing: .06em; color: var(--text-42); }

  .actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 16px;
    border-top: 1px solid var(--hairline);
  }
  .note-label { display: flex; flex-direction: column; gap: 6px; }
  .note-label span { font-size: 10px; letter-spacing: .14em; color: var(--text-42); }
  .note-label input {
    padding: 11px 13px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--page);
    color: var(--text);
    font: inherit;
    font-size: 15px;
  }
  .note-label input::placeholder { color: var(--text-42); }
  .note-label input:focus-visible { outline: 2px solid var(--brand-light); outline-offset: 1px; }

  .buttons { display: flex; flex-wrap: wrap; gap: 10px; }
  .btn {
    padding: 10px 18px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface-alt);
    color: var(--text);
    font: inherit;
    font-size: 14px;
    cursor: pointer;
  }
  .btn:hover { border-color: var(--text-55); }
  .btn.warn { border-color: rgba(232, 169, 59, .5); color: var(--accent); }
  .btn.warn:hover { border-color: var(--accent); }
  .btn.danger { border-color: rgba(224, 82, 82, .5); color: #f09a9a; }
  .btn.danger:hover { border-color: #e05252; }
  .btn:focus-visible { outline: 2px solid var(--brand-light); outline-offset: 2px; }

  .handled { display: flex; flex-direction: column; gap: 12px; }
  .handled h2 { margin: 0; font-size: 20px; }
  .toggle { align-self: flex-start; font-size: 14px; color: var(--text-55); }
  .toggle:hover { color: var(--link); }
  .log { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .log li {
    display: flex;
    gap: 12px;
    align-items: baseline;
    flex-wrap: wrap;
    font-size: 14px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--hairline);
  }
  .log li:last-child { border-bottom: 0; }
  .verdict { font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--text-55); }
  .verdict.removed { color: #f09a9a; }
  .verdict.warned { color: var(--accent); }
  .log-note { color: var(--text-70); }
</style>
