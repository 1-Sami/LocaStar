---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Base from '../layouts/Base.astro';
import { useTranslations, localePath } from '../i18n/ui';
import { SUPPORT_EMAIL } from '../lib/site';

/*
 * Both stores check that the support URL shows a way to reach a human, so the
 * address is large and in the open rather than behind a form. No contact form
 * at all: a form that silently fails is worse than an address, and there is
 * nobody staffing a ticket queue.
 */
export const prerender = false;

const origin = Astro.site?.origin ?? Astro.url.origin;
const lang = Astro.locals.lang ?? 'en';
const t = useTranslations(lang);
const p = (href: string) => localePath(href, lang);
const title = t('contact.title');
const description = t('contact.metaDesc');
---

<Base title={title} description={description} canonical={`${origin}/contact`}>
  <SiteHeader />

  <main id="main" class="wrap">
    <header class="head">
      <h1>{t('contact.heading')}</h1>
      <p class="lead">{t('contact.lead')}</p>
      <a class="email" href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a>
    </header>

    <div class="cards">
      <section class="card" id="report">
        <h2>{t('contact.wrongTitle')}</h2>
        <p>{t('contact.wrongBody')}</p>
        <p class="small">{t('contact.wrongSmall')}</p>
      </section>

      <section class="card" id="claim">
        <h2>{t('contact.claimTitle')}</h2>
        <p>{t('contact.claimBody')}</p>
        <p class="small">{t('contact.claimSmall')}</p>
      </section>

      <section class="card">
        <h2>{t('contact.deleteTitle')}</h2>
        <p>{t('contact.deleteBody')}</p>
        <p class="small">
          <a href={p('/legal/delete-account')}>{t('contact.deleteLink')}</a>
        </p>
      </section>
    </div>

    <p class="who">
      {t('contact.operatedBy')}{' '}
      <a href={p('/legal/privacy')}>{t('contact.privacy')}</a> {t('contact.and')}{' '}
      <a href={p('/legal/terms')}>{t('contact.terms')}</a>.
    </p>
  </main>

  <SiteFooter />
</Base>

<style>
  main {
    padding-block: 48px 72px;
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 36px;
    align-items: flex-start;
  }

  h1 {
    font-size: clamp(32px, 5vw, 52px);
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .lead {
    margin: 0;
    font-size: 18px;
    line-height: 1.6;
    color: var(--text-70);
    max-width: 56ch;
  }

  .email {
    font-size: clamp(22px, 3.4vw, 34px);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--accent);
    margin-top: 6px;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 13px;
    padding: 24px;
  }

  .card h2 {
    font-size: 18px;
    line-height: 1.3;
    margin-bottom: 12px;
  }

  .card p {
    margin: 0 0 10px;
    font-size: 15px;
    line-height: 1.65;
    color: var(--text-70);
  }

  .small {
    font-size: 13px;
    color: var(--text-55);
  }

  .who {
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid var(--hairline);
    font-size: 14px;
    color: var(--text-55);
  }

  @media (max-width: 1000px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
