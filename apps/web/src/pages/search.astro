      overscroll-behavior: contain;
      /* Room for the scrollbar so it never sits on top of a card's edge. */
      padding-right: 6px;
      margin-right: -6px;
    }

    /* The empty state is the middle band when there are no results at all. */
    .empty {
      min-height: 0;
    }

    .pager {
