     * two without scrolling to the bottom of page one. Making it a grid row
     * instead of a sticky footer means it is simply always there, and the
     * scrollbar belongs to the list it actually moves.
     */
    .results {
      display: grid;
      grid-template-rows: auto minmax(0, 1fr) auto;
      overflow: hidden;
    }

    .list {
      overflow-y: auto;
      /* Reaching the end of the list must not start scrolling the page
