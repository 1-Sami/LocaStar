   */
  @media (min-width: 1280px) {
    .layout {
      height: calc(100vh - 208px);
      min-height: 520px;
    }

    /*
     * Three fixed bands: the count and sort, then the places, then the pager.
     * Only the middle one scrolls.
     *
     * It used to be the whole column that scrolled, which put the pager below
