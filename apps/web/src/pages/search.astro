---
import { categoryName, fetchCategoryCounts, fetchSearchResults, SearchPageOutOfRange } from '@locastar/shared';
import LeafletMap from '../components/LeafletMap.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Base from '../layouts/Base.astro';
import { useTranslations, localePath } from '../i18n/ui';
import { byCategoryName, categoryColor, ratingLabel } from '../lib/format';
import { anonClient } from '../lib/supabase';

export const prerender = false;

const supabase = anonClient();
const lang = Astro.locals.lang ?? 'en';
const t = useTranslations(lang);
const p = (href: string) => localePath(href, lang);
const url = Astro.url;

/*
 * Every filter lives in the URL.
 *
 * /search?activity=basketball&page=3 has to be a real address somebody can
 * link, bookmark and index — the handoff is explicit that endless scroll alone
 * would cost the crawlability the whole project is built around.
 */
const q = url.searchParams.get('q')?.trim() || '';
/*
 * The home page's finder posts this, and for a while nothing read it — you
 * typed a town, got the unfiltered list back, and nothing said otherwise.
 * A filter that silently does nothing is worse than no filter.
 */
const where = url.searchParams.get('where')?.trim() || '';
const activity = url.searchParams.getAll('activity').filter(Boolean);
const kindParam = url.searchParams.get('kind');
const seasonParam = url.searchParams.get('season');
const page = Number.parseInt(url.searchParams.get('page') ?? '1', 10) || 1;
/*
 * A–Z was a filing order, not a reason to pick one place over another — the
 * owner's point, and true: nobody chooses where to go alphabetically. What is
 * left are the two orderings that say something about the place itself, each
 * reversible with the arrow beside them.
 */
const sortParam = url.searchParams.get('sort');
const sort = sortParam === 'reviews' ? 'reviews' : 'rating';
const direction = url.searchParams.get('dir') === 'asc' ? 'asc' : 'desc';

const kind = kindParam === 'place' || kindParam === 'activity' ? kindParam : null;
const season = seasonParam === 'summer' || seasonParam === 'winter' ? seasonParam : null;

let response;
let categoryCounts;
try {
  [response, categoryCounts] = await Promise.all([
    fetchSearchResults(supabase, {
      query: q,
      where,
      categorySlugs: activity,
      kind,
      season,
      sort,
      direction,
      page,
      perPage: 20,
    }),
    fetchCategoryCounts(supabase),
  ]);
} catch (error) {
  /*
   * A page past the last one is a page that does not exist, so it 404s. Only a
   * genuine failure gets the 503 — and a failed search is never rendered as an
   * empty one, per the note on the location page.
   */
  if (error instanceof SearchPageOutOfRange) return new Response(null, { status: 404 });
  console.error('Search failed', error);
  return new Response('Temporarily unavailable', { status: 503, headers: { 'Retry-After': '60' } });
}

const publicUrl = (path: string | null) =>
  path ? supabase.storage.from('media').getPublicUrl(path).data.publicUrl : null;

const withPlaces = categoryCounts.filter((row) => row.count > 0);

/*
 * The filter list is alphabetical, with Others at the end.
 *
 * Counts decide what the home page's browse grid leads with — there the size
 * of a category is the point. Here it is not: somebody scanning a filter list
 * is looking for a word they already have in mind, and hunting for it down a
 * list ordered by popularity means reading all forty-three.
 */
const filterCategories = byCategoryName(
  withPlaces,
  lang,
  (row) => categoryName(row.slug, lang) ?? row.name
);

/** A URL with one parameter changed, everything else preserved. */
function withParam(name: string, value: string | null, resetPage = true) {
  const next = new URLSearchParams(url.search);
  if (value === null) next.delete(name);
  else next.set(name, value);
  if (resetPage) next.delete('page');
  const qs = next.toString();
  return qs ? `${p('/search')}?${qs}` : p('/search');
}

/** Toggle one category on or off, keeping the rest. */
function toggleActivity(slug: string) {
  const next = new URLSearchParams(url.search);
  const current = next.getAll('activity');
  next.delete('activity');
  const updated = current.includes(slug) ? current.filter((s) => s !== slug) : [...current, slug];
  updated.forEach((s) => next.append('activity', s));
  next.delete('page');
  const qs = next.toString();
  return qs ? `${p('/search')}?${qs}` : p('/search');
}

function pageHref(target: number) {
  const next = new URLSearchParams(url.search);
  if (target <= 1) next.delete('page');
  else next.set('page', String(target));
  const qs = next.toString();
  return qs ? `${p('/search')}?${qs}` : p('/search');
}

const first = response.total === 0 ? 0 : (response.page - 1) * response.perPage + 1;
const last = Math.min(response.page * response.perPage, response.total);
const progress = response.total === 0 ? 0 : Math.round((last / response.total) * 100);

/*
 * Page numbers worth rendering: the first three, the last, and the current
 * neighbourhood. A crawler follows these; a person uses the button.
 */
const pageNumbers: (number | '…')[] = [];
for (let i = 1; i <= response.pageCount; i += 1) {
  if (i <= 3 || i === response.pageCount || Math.abs(i - response.page) <= 1) pageNumbers.push(i);
  else if (pageNumbers[pageNumbers.length - 1] !== '…') pageNumbers.push('…');
}

const describedFilters = [
  q ? `"${q}"` : null,
  where || null,
  activity.length ? activity.map((slug) => categoryName(slug, lang) ?? withPlaces.find((c) => c.slug === slug)?.name ?? slug).join(', ') : null,
  kind === 'place' ? t('search.places') : kind === 'activity' ? t('search.activities') : null,
  season === 'summer' ? t('season.summer') : season === 'winter' ? t('season.winter') : null,
].filter(Boolean);

/*
 * Both of these are what a Swedish searcher reads in the results list, so both
 * have to be Swedish. They were hardcoded English while every other page on
 * /sv was translated, which quietly undid the translation where it counted.
 */
const title = describedFilters.length
  ? t('search.metaTitleFiltered', { filters: describedFilters.join(' · '), count: String(response.total) })
  : t('search.metaTitle', { count: String(response.total) });

const description = describedFilters.length
  ? t('search.metaDescFiltered', { filters: describedFilters.join(', '), count: String(response.total) })
  : t('search.metaDesc');

const origin = Astro.site?.origin ?? Astro.url.origin;
/*
 * Filtered searches canonicalise to the bare page.
 *
 * Same reasoning as the city chips on a category page: these are the same
 * content sliced, and thousands of near-identical URLs competing dilutes the
 * pages that should win. robots.txt disallows /search? for the same reason.
 */
const canonical = `${origin}/search`;
---

<Base title={title} description={description} canonical={canonical}>
  <SiteHeader current="explore" />

  <main id="main" class="wrap">
    <form class="searchbar" action={p("/search")} method="get">
      <span class="mono glyph" aria-hidden="true">⌕</span>
      <input name="q" value={q} placeholder={t('search.placeholder')} aria-label={t('common.search')} />
      <input name="where" value={where} placeholder={t('search.wherePlaceholder')} aria-label={t('search.where')} class="where" />
      {activity.map((slug) => <input type="hidden" name="activity" value={slug} />)}
      {kind && <input type="hidden" name="kind" value={kind} />}
      {season && <input type="hidden" name="season" value={season} />}
      <button type="submit">{t('common.search')}</button>
    </form>

    <div class="layout">
      <aside class="rail" aria-label={t('search.filters')}>
        <div class="group">
          <span class="mono group-head">{t('search.type')}</span>
          <div class="pills">
            <a class={`pill${kind === 'place' ? ' on' : ''}`} href={withParam('kind', kind === 'place' ? null : 'place')}>
              {t('search.places')}
            </a>
            <a
              class={`pill${kind === 'activity' ? ' on' : ''}`}
              href={withParam('kind', kind === 'activity' ? null : 'activity')}
            >
              {t('search.activities')}
            </a>
          </div>
        </div>

        <div class="group">
          <span class="mono group-head">{t('search.season')}</span>
          <div class="pills">
            <a
              class={`pill${season === 'summer' ? ' on' : ''}`}
              href={withParam('season', season === 'summer' ? null : 'summer')}
            >
              {t('season.summer')}
            </a>
            <a
              class={`pill${season === 'winter' ? ' on' : ''}`}
              href={withParam('season', season === 'winter' ? null : 'winter')}
            >
              {t('season.winter')}
            </a>
          </div>
        </div>

        <div class="group activity-group">
          <span class="mono group-head">{t('search.activity')}</span>
          <div class="cats">
            {
              filterCategories.map((row) => {
                const on = activity.includes(row.slug);
                return (
                  <a class={`cat${on ? ' on' : ''}`} href={toggleActivity(row.slug)}>
                    <span class="box" />
                    <span class="cat-name">
                      {categoryName(row.slug, lang) ?? row.name} <span class="mono cat-count">{row.count}</span>
                    </span>
                  </a>
                );
              })
            }
          </div>
        </div>

        {
          (q || where || activity.length > 0 || kind || season) && (
            <a class="clear" href={p('/search')}>
              {t('common.clearAll')}
            </a>
          )
        }
      </aside>

      <section class="results" aria-label={t('common.results')}>
        <div class="results-head">
          <span class="mono count">{response.total} {t('common.results')}</span>
          <label class="sort">
            <span class="mono sort-label">{t('common.sort')}</span>
            <select onchange="location.href = this.value" aria-label={t('search.sortResults')}>
              <option value={withParam('sort', 'rating', false)} selected={sort === 'rating'}>
                {t('search.sortRating')}
              </option>
              <option value={withParam('sort', 'reviews', false)} selected={sort === 'reviews'}>
                {t('search.sortReviews')}
              </option>
            </select>
            <a
              class="flip"
              href={withParam('dir', direction === 'asc' ? null : 'asc', false)}
              aria-label={direction === 'asc' ? t('search.showBestFirst') : t('search.showWorstFirst')}
              title={direction === 'asc' ? t('search.showBestFirst') : t('search.showWorstFirst')}
            >
              {direction === 'asc' ? '↑' : '↓'}
            </a>
          </label>
        </div>

        {
          response.results.length === 0 ? (
            /* Named actions, not just an absence — the handoff's rule for every
               empty state on the site. */
            <div class="empty">
              <p class="empty-lead">{t('search.emptyLead')}</p>
              <p class="empty-sub">
                {t('search.emptySub')}
              </p>
              <div class="empty-actions">
                <a class="ghost" href={p('/search')}>{t('search.clearFilters')}</a>
                <a class="ghost" href={p("/add")}>{t("nav.addPlace")}</a>
              </div>
            </div>
          ) : (
            <>
              <div class="list">
              {response.results.map((place) => {
                const colour = categoryColor(place.categorySlug);
                const rating = ratingLabel(place.avgRating, place.reviewCount);
                const cover = publicUrl(place.coverPhotoPath);
                return (
                  <article class="row" style={`border-color:${colour}`}>
                    <a class="row-link" href={p(`/location/${place.id}`)}>
                      {cover ? (
                        <div class="row-photo" style={`background-image:url("${cover}")`} />
                      ) : (
                        <div class="row-photo flat" style={`background:${colour}`}>
                          <span class="mono">{categoryName(place.categorySlug, lang) ?? place.categoryName ?? ''}</span>
                        </div>
                      )}
                      <div class="row-body">
                        {place.categoryName && (
                          <span class="row-badge" style={`background:${colour}`}>
                            {categoryName(place.categorySlug, lang) ?? place.categoryName}
                          </span>
                        )}
                        <span class="row-name">{place.name}</span>
                        {rating.rated ? (
                          <span class="mono row-rating">
                            ★ {rating.avg}{' '}
                            <span class="dim">
                              ({rating.count} {rating.count === 1 ? t('common.review') : t('common.reviews')})
                            </span>
                          </span>
                        ) : (
                          <span class="mono row-unrated">{t('common.notRated')}</span>
                        )}
                        <span class="row-where">{[place.address, place.city].filter(Boolean).join(', ')}</span>
                      </div>
                    </a>
                    <div class="row-side">
                      <a
                        class="directions"
                        href={`https://www.google.com/maps/dir/?api=1&destination=${place.lat},${place.lng}`}
                        rel="noopener noreferrer"
                        target="_blank"
                      >
                        {t('common.directions')}
                      </a>
                    </div>
                  </article>
                );
              })}
            </div>

            <div class="pager">
              <span class="mono showing">
                {t('search.showing')} {first}–{last} {t('search.of')} {response.total}
              </span>
              <div class="bar" aria-hidden="true">
                <div class="bar-fill" style={`width:${progress}%`} />
              </div>
              {/*
                Real numbered links, not a script. A crawler follows these, and
                somebody can link page 3 — which is the whole reason the search
                page is server-rendered rather than an endless scroll.
              */}
              {
                response.pageCount > 1 && (
                  <nav class="pages" aria-label={t('search.pagination')}>
                    {pageNumbers.map((n) =>
                      n === '…' ? (
                        <span class="mono gap">…</span>
                      ) : (
                        <a class={`page${n === response.page ? ' on' : ''}`} href={pageHref(n)}>
                          {n}
                        </a>
                      )
                    )}
                    {response.page < response.pageCount && (
                      <a class="page next" href={pageHref(response.page + 1)} aria-label={t('search.nextPage')}>
                        →
                      </a>
                    )}
                  </nav>
                )
              }
            </div>
            </>
          )
        }
      </section>

      <aside class="map-col" aria-label="Map">
        {
          response.results.length > 0 ? (
            <LeafletMap
              pins={response.results.map((place) => ({
                id: place.id,
                lat: place.lat,
                lng: place.lng,
                name: place.name,
                colour: categoryColor(place.categorySlug),
                href: p(`/location/${place.id}`),
              }))}
              height="100%"
              class="results-map"
            />
          ) : (
            <div class="map-slot">
              <span class="mono">NOTHING TO SHOW</span>
            </div>
          )
        }
      </aside>
    </div>
  </main>

  <SiteFooter />
</Base>

<style>
  main {
    padding-top: 24px;
  }

  /* ---- search field ---- */
  .searchbar {
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--surface);
    border: 1px solid rgba(244, 246, 245, 0.16);
    border-radius: 9px;
    padding: 6px 6px 6px 18px;
    max-width: 620px;
  }

  .glyph {
    font-size: 15px;
    color: var(--text-55);
  }

  .searchbar input {
    flex: 1;
    background: transparent;
    border: 0;
    color: var(--text);
    font-family: var(--font-display);
    font-size: 16px;
    padding-block: 13px;
    min-width: 0;
  }

  .searchbar input::placeholder {
    color: var(--text-55);
  }

  /*
   * The town sits in the same bar as the name, divided by a hairline rather
   * than a second box: they are one question asked in two halves, and the home
   * page's finder already pairs them that way.
   */
  .searchbar .where {
    flex: 0 1 34%;
    border-left: 1px solid var(--hairline);
    padding-left: 14px;
  }

  @media (max-width: 560px) {
    .searchbar {
      flex-wrap: wrap;
      padding: 6px;
    }
    .searchbar input {
      flex-basis: 100%;
      padding-inline: 12px;
    }
    .searchbar .where {
      border-left: 0;
      border-top: 1px solid var(--hairline);
      padding-left: 12px;
    }
  }

  .searchbar button {
    background: var(--accent);
    border: 0;
    border-radius: 7px;
    padding: 12px 22px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 15px;
    color: var(--page);
    cursor: pointer;
  }

  .searchbar button:hover {
    background: #f0b94e;
  }

  /* ---- three columns, as drawn ---- */
  .layout {
    display: grid;
    grid-template-columns: 238px 1fr 520px;
    gap: 0;
    margin-top: 22px;
  }

  .rail {
    border-right: 1px solid rgba(244, 246, 245, 0.08);
    padding: 24px 22px 24px 0;
    display: flex;
    flex-direction: column;
    gap: 26px;
  }

  .group {
    display: flex;
    flex-direction: column;
    gap: 11px;
  }

  .group-head {
    font-size: 9.5px;
    letter-spacing: 0.16em;
    color: var(--text-42);
  }

  .pills {
    display: flex;
    gap: 7px;
    flex-wrap: wrap;
  }

  .pill {
    font-size: 12px;
    padding: 8px 13px;
    border-radius: 20px;
    border: 1px solid rgba(244, 246, 245, 0.2);
    color: var(--text-70);
  }

  .pill.on {
    background: var(--text);
    border-color: var(--text);
    color: var(--page);
    font-weight: 500;
  }

  .pill.on:hover {
    color: var(--page);
  }

  .cats {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-height: 460px;
    overflow-y: auto;
  }

  .cat {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 13.5px;
    color: var(--text-70);
  }

  .cat.on {
    color: var(--text);
  }

  .box {
    width: 13px;
    height: 13px;
    border-radius: 3px;
    border: 1px solid rgba(244, 246, 245, 0.25);
    flex: none;
  }

  .cat.on .box {
    background: var(--ok);
    border-color: var(--ok);
  }

  .cat-count {
    font-size: 11px;
    letter-spacing: 0;
    color: var(--text-42);
  }

  /* ---- results ---- */
  .results {
    padding: 24px 22px;
    min-width: 0;
  }

  .results-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 16px;
  }

  .count {
    font-size: 12px;
    letter-spacing: 0.1em;
    color: var(--text-55);
  }

  /* The arrow is the whole control for direction: one tap, and the same list
     reads from the other end. */
  .flip {
    border: 1px solid var(--hairline);
    border-radius: 7px;
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    color: var(--text-70);
    flex: none;
  }

  .flip:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .sort {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
  }

  .sort-label {
    font-size: 10px;
    letter-spacing: 0.16em;
    color: var(--text-42);
  }

  .sort select {
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 7px;
    color: var(--text);
    font-family: var(--font-display);
    font-size: 13px;
    padding: 7px 10px;
  }

  .sort select option {
    background: var(--surface);
    color: var(--text);
  }

  /* Under the filters it is undoing, not next to the sort control it has
     nothing to do with. */
  .clear {
    align-self: flex-start;
    border: 1px solid var(--ok);
    border-radius: 999px;
    padding: 9px 18px;
    font-size: 13px;
    font-weight: 500;
    color: var(--ok);
  }

  .clear:hover {
    background: var(--ok);
    color: var(--page);
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .row {
    display: flex;
    gap: 15px;
    background: var(--surface);
    border: 1px solid;
    border-radius: 11px;
    padding: 13px;
    transition: box-shadow 120ms ease-out;
  }

  .row:hover {
    box-shadow: 0 0 0 3px rgba(232, 169, 59, 0.12);
  }

  .row-link {
    flex: 1;
    display: flex;
    gap: 15px;
    color: var(--text);
    min-width: 0;
  }

  .row-link:hover {
    color: var(--text);
  }

  .row-photo {
    width: 150px;
    height: 104px;
    border-radius: 7px;
    flex: none;
    background-size: cover;
    background-position: center;
  }

  .row-photo.flat {
    display: flex;
    align-items: flex-end;
    padding: 10px;
  }

  .row-photo.flat .mono {
    font-size: 9px;
    letter-spacing: 0.14em;
    color: rgba(255, 255, 255, 0.85);
  }

  .row-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: flex-start;
    min-width: 0;
  }

  .row-badge {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 5px 8px;
    border-radius: 4px;
    color: #fff;
  }

  .row-name {
    font-weight: 500;
    font-size: 18px;
    line-height: 1.2;
  }

  .row-rating {
    font-size: 12px;
    color: var(--accent);
  }

  .dim {
    color: var(--text-42);
  }

  .row-unrated {
    font-size: 11.5px;
    letter-spacing: 0.14em;
    color: var(--text-42);
  }

  .row-where {
    font-size: 13px;
    line-height: 1.4;
    color: var(--text-55);
  }

  .row-side {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    flex: none;
  }

  .directions {
    font-weight: 500;
    font-size: 12.5px;
    color: var(--page);
    background: var(--text);
    border-radius: 7px;
    padding: 9px 14px;
    white-space: nowrap;
  }

  .directions:hover {
    color: var(--page);
    background: var(--accent);
  }

  /* ---- empty ---- */
  .empty {
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 11px;
    padding: 30px;
  }

  .empty-lead {
    margin: 0;
    font-size: 19px;
    font-weight: 500;
  }

  .empty-sub {
    margin: 8px 0 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-55);
    max-width: 52ch;
  }

  .empty-actions {
    display: flex;
    gap: 10px;
    margin-top: 18px;
    flex-wrap: wrap;
  }

  .ghost {
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 11px 18px;
    font-weight: 500;
    font-size: 14px;
    color: var(--text);
  }

  .ghost:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* ---- pager ---- */
  .pager {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
