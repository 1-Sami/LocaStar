---
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Base from '../../layouts/Base.astro';
import { useTranslations, localePath } from '../../i18n/ui';
import { currentUser, sessionClient } from '../../lib/auth';

/*
 * Ask for a reset link.
 *
 * The counterpart to /reset-password, which is where the emailed link lands.
 * That path is fixed — it is compiled into every installed app — so this page
 * has to name it exactly rather than pick its own.
 *
 * Server-side is fine here: nothing secret is involved yet, and the address is
 * an ordinary form field. The reset page itself cannot work this way, because
 * the token arrives in a URL fragment the server never sees.
 */
export const prerender = false;

const lang = Astro.locals.lang ?? 'en';
const t = useTranslations(lang);
const p = (href: string) => localePath(href, lang);

const { user } = await currentUser(Astro.cookies, Astro.request.headers);
if (user) return Astro.redirect(p('/account'));

let error: string | null = null;
let sentTo: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const email = String(form.get('email') ?? '').trim();

  if (!email) {
    error = t('forgot.errEmail');
  } else {
    const supabase = sessionClient(Astro.cookies, Astro.request.headers);
    /*
     * Always the same answer, sent or not.
     *
     * Telling someone "no account with that address" turns this form into a
     * way to test whether a given person is a member — the same reason the
     * sign-up form answers identically either way. Only a genuine transport
     * failure is reported, and that says nothing about the address.
     */
    const { error: sendError } = await supabase.auth.resetPasswordForEmail(email, {
      redirectTo: new URL('/reset-password', Astro.url.origin).href,
    });

    if (sendError && sendError.status !== 400) {
      console.error('Password reset send failed', sendError);
      error = t('forgot.errSend');
    } else {
      sentTo = email;
    }
  }
}

const origin = Astro.site?.origin ?? Astro.url.origin;
---

<Base title={t('forgot.title')} description={t('forgot.metaDesc')} canonical={`${origin}/auth/forgot-password`}>
  <SiteHeader />

  <main id="main" class="wrap">
    <div class="card">
      {
        sentTo ? (
          <>
            <h1>{t('forgot.sent')}</h1>
            <p class="lead">{t('forgot.sentSub', { email: sentTo })}</p>
            <a class="ghost" href={p('/auth/sign-in')}>{t('auth.signIn')}</a>
          </>
        ) : (
          <>
            <h1>{t('forgot.heading')}</h1>
            <p class="lead">{t('forgot.lead')}</p>

            <form method="post" class="form">
              {error && <p class="error" role="alert">{error}</p>}

              <label class="field">
                <span class="mono label">{t('auth.email')}</span>
                <input name="email" type="email" required autocomplete="email" placeholder="you@example.com" />
              </label>

              <button type="submit">{t('forgot.send')}</button>
              <a class="quiet" href={p('/auth/sign-in')}>{t('auth.signIn')}</a>
            </form>
          </>
        )
      }
    </div>
  </main>

  <SiteFooter />
</Base>

<style>
  main {
    padding-block: 56px 80px;
    display: flex;
    justify-content: center;
  }

  .card {
    width: 100%;
    max-width: 460px;
    background: var(--page);
    border: 1px solid var(--hairline);
    border-radius: 13px;
    padding: clamp(24px, 4vw, 36px);
  }

  h1 {
    font-size: clamp(24px, 3.4vw, 30px);
    line-height: 1.15;
    letter-spacing: -0.025em;
    margin: 0 0 12px;
  }

  .lead {
    margin: 0 0 24px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-70);
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .label {
    font-size: 10px;
    letter-spacing: 0.16em;
    color: var(--text-55);
  }

  input {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 9px;
    padding: 13px 14px;
    font: inherit;
    font-size: 15px;
    color: var(--text);
  }

  input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  button {
    background: var(--accent);
    color: var(--page);
    border: 0;
    border-radius: 9px;
    padding: 14px;
    font: inherit;
    font-weight: 600;
    font-size: 15px;
    cursor: pointer;
  }

  button:hover {
    background: #f0b94e;
  }

  .ghost {
    display: inline-block;
    border: 1px solid var(--border);
    border-radius: 9px;
    padding: 13px 22px;
    font-weight: 500;
    font-size: 15px;
    color: var(--text);
  }

  .ghost:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .quiet {
    align-self: center;
    font-size: 14px;
    color: var(--text-70);
  }

  .quiet:hover {
    color: var(--accent);
  }

  .error {
    margin: 0;
    padding: 11px 13px;
    border-left: 2px solid #e06060;
    background: rgba(224, 96, 96, 0.08);
    font-size: 14px;
    line-height: 1.55;
    color: var(--text);
  }
</style>
