---
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Base from '../../layouts/Base.astro';

/*
 * Where the confirmation email lands.
 *
 * A frozen path: Supabase auth mail points at locastar.se/auth/*, and Android's
 * intent filter claims that prefix, so on a phone with the app installed this
 * URL opens the app instead of the browser. The page only has to work for
 * everyone else — somebody confirming on a laptop.
 */
export const prerender = false;
const origin = Astro.site?.origin ?? Astro.url.origin;
---

<Base
  title="Email confirmed | LocaStar"
  description="Your LocaStar email address is confirmed."
  canonical={`${origin}/auth/confirmed`}
>
  <SiteHeader />
  <main id="main" class="wrap">
    <div class="panel">
      <h1>That's confirmed</h1>
      <p class="lead">Your email address is verified. You can sign in now, here or in the app.</p>
      <div class="actions">
        <a class="cta" href="/auth/sign-in">Sign in</a>
        <a class="ghost" href="/search">Look around first</a>
      </div>
    </div>
  </main>
  <SiteFooter />
</Base>

<style>
  main { padding-block: 72px 96px; }
  .panel { max-width: 560px; }
  h1 { font-size: clamp(34px, 6vw, 52px); line-height: 1.05; letter-spacing: -0.035em; }
  .lead { margin: 16px 0 0; font-size: 18px; line-height: 1.6; color: var(--text-70); }
  .actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 26px; }
  .cta { background: var(--accent); color: var(--page); border-radius: 9px; padding: 14px 24px; font-weight: 600; font-size: 15px; }
  .cta:hover { background: #f0b94e; color: var(--page); }
  .ghost { border: 1px solid var(--border); border-radius: 9px; padding: 14px 22px; font-weight: 500; font-size: 15px; color: var(--text); }
  .ghost:hover { color: var(--accent); border-color: var(--accent); }
</style>
