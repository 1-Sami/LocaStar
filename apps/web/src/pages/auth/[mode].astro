---
import { isValidUsername } from '@locastar/shared';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Base from '../../layouts/Base.astro';
import { useTranslations, localePath } from '../../i18n/ui';
import { currentUser, sessionClient } from '../../lib/auth';
import { safePath } from '../../lib/redirects';

export const prerender = false;

const { mode } = Astro.params;
if (mode !== 'sign-in' && mode !== 'sign-up') return new Response(null, { status: 404 });
const isSignUp = mode === 'sign-up';
const lang = Astro.locals.lang ?? 'en';
const t = useTranslations(lang);
const p = (href: string) => localePath(href, lang);

/*
 * Where to go once they are in.
 *
 * api/save.ts sends a signed-out saver here with ?next=<the place they were
 * looking at>. For a while nothing read it and everyone landed in their
 * account instead, with the place gone and the save never made.
 *
 * safePath is what makes carrying it around safe — it is a caller-supplied
 * address, and forwarding to an arbitrary one after sign-in is exactly the
 * redirect a phishing link wants.
 */
const next = safePath(Astro.url.searchParams.get('next'), p('/account'));

const { user } = await currentUser(Astro.cookies, Astro.request.headers);
if (user) return Astro.redirect(next);

let error: string | null = null;
let sentTo: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const email = String(form.get('email') ?? '').trim();
  const password = String(form.get('password') ?? '');
  const username = String(form.get('username') ?? '').trim();

  const supabase = sessionClient(Astro.cookies, Astro.request.headers);

  if (!email || !password) {
    error = t('auth.errBoth');
  } else if (isSignUp) {
    /*
     * The same username rule the app and the database use, checked here so a
     * bad handle comes back as a sentence rather than as a raw constraint
     * violation after the account already exists.
     */
    const badUsername = username !== '' && !isValidUsername(username);
    if (badUsername) {
      error = t('auth.errUsername');
    } else {
      const { error: signUpError } = await supabase.auth.signUp({
        email,
        password,
        options: {
          data: username ? { username } : undefined,
          emailRedirectTo: new URL('/auth/confirmed', Astro.url.origin).href,
        },
      });
      if (signUpError) {
        error = signUpError.message;
      } else {
        /*
         * Always the same message, whether or not the address was already
         * registered. Saying "that email is taken" tells anyone who asks which
         * addresses have accounts here.
         */
        sentTo = email;
      }
    }
  } else {
    const { error: signInError } = await supabase.auth.signInWithPassword({ email, password });
    if (signInError) {
      error = t('auth.errCredentials');
    } else {
      return Astro.redirect(next);
    }
  }
}

/** Carried across the sign-in / sign-up toggle so switching tabs keeps it. */
const keep = next === p('/account') ? '' : `?next=${encodeURIComponent(next)}`;

const origin = Astro.site?.origin ?? Astro.url.origin;
const title = isSignUp ? t('auth.signUpTitle') : t('auth.signInTitle');
const description = isSignUp ? t('auth.signUpDesc') : t('auth.signInDesc');
---

<Base title={title} description={description} canonical={`${origin}/auth/${mode}`}>
  <SiteHeader />

  <main id="main" class="wrap">
    <div class="card">
      <div class="pane">
        <svg width="44" height="44" viewBox="0 0 200 200" aria-hidden="true">
          <rect x="4" y="4" width="192" height="192" rx="42" fill="#125F6F"></rect>
          <g
            transform="translate(23.86 13.94) scale(0.2794)"
            fill="none"
            stroke="#F4F6F5"
            stroke-width="24.5"
            stroke-linecap="round"
            stroke-miterlimit="6"
          >
            <path d="M 49 48 L 49 566 L 261 566"></path>
            <path d="M 131 360 L 131 480 L 201 480"></path>
            <path d="M 466 332 A 182 192 0 1 0 163 325 L 313 568 L 418 412"></path>
            <path
              d="M 355 248 L 423 200 L 341 180 L 311 118 L 283 180 L 203 200 L 277 238 L 250 332 L 312 272 L 452 383 C 472 398 492 420 494 450 C 497 490 480 520 450 542 C 425 560 400 568 378 568"
            ></path>
          </g>
        </svg>

        <div class="intro">
          <h1>{isSignUp ? t('auth.createAccount') : t('auth.welcomeBack')}</h1>
          <p>
            {
              isSignUp ? t('auth.signUpIntro') : t('auth.signInIntro')
            }
          </p>
        </div>

        <div class="segmented">
          <a class={`seg${isSignUp ? ' on' : ''}`} href={p('/auth/sign-up') + keep}>{t('auth.signUp')}</a>
          <a class={`seg${isSignUp ? '' : ' on'}`} href={p('/auth/sign-in') + keep}>{t('auth.signIn')}</a>
        </div>

        {
          sentTo ? (
            <div class="sent">
              <p class="sent-lead">{t('auth.checkEmail')}</p>
              <p class="sent-sub">{t('auth.sentSub', { email: sentTo })}</p>
            </div>
          ) : (
            <form method="post" class="form">
              {error && <p class="error" role="alert">{error}</p>}

              {isSignUp && (
                <label class="field">
                  <span class="mono label">{t('auth.username')}</span>
                  <input name="username" autocomplete="username" placeholder="sam_86" />
                </label>
              )}

              <label class="field">
                <span class="mono label">{t('auth.email')}</span>
                <input
                  name="email"
                  type="email"
                  required
                  autocomplete="email"
                  placeholder="you@example.com"
                />
              </label>

              <label class="field">
                <span class="mono label">{t('auth.password')}</span>
                <input
                  name="password"
                  type="password"
                  required
                  minlength="8"
                  autocomplete={isSignUp ? 'new-password' : 'current-password'}
                  placeholder={isSignUp ? t('auth.passwordHint') : ''}
                />
              </label>

              <button type="submit">{isSignUp ? t('auth.submitSignUp') : t('auth.signIn')}</button>

              {
                isSignUp ? (
                  <p class="fine">
                    {t('auth.fineSignUpPrefix')} <a href={p('/legal/terms')}>{t('contact.terms')}</a>{' '}
                    {t('auth.fineSignUpMiddle')} <a href={p('/legal/privacy')}>{t('contact.privacy')}</a>{t('auth.fineSignUpSuffix')}
                  </p>
                ) : (
                  <p class="fine">{t('auth.fineSignIn')}</p>
                )
              }
            </form>
          )
        }
      </div>

      <div class="art" aria-hidden="true"></div>
    </div>
  </main>

  <SiteFooter />
</Base>

<style>
  main {
    padding-block: 56px 80px;
    display: flex;
    justify-content: center;
  }

  .card {
    width: 100%;
    max-width: 760px;
    background: var(--page);
    border: 1px solid var(--hairline);
    border-radius: 13px;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr 300px;
  }

  .pane {
    padding: 44px 40px;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  h1 {
    font-size: 34px;
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  .intro p {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--text-55);
  }

  .segmented {
    display: flex;
    gap: 8px;
    padding: 4px;
    background: var(--surface);
    border-radius: 9px;
  }

  .seg {
    flex: 1;
    text-align: center;
    font-weight: 500;
    font-size: 14px;
    padding: 11px;
    border-radius: 7px;
    color: var(--text-70);
  }

  .seg.on {
    background: var(--text);
    color: var(--page);
  }

  .seg.on:hover {
    color: var(--page);
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: 13px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .label {
    font-size: 11.5px;
    letter-spacing: 0.12em;
    color: var(--text-55);
  }

  input {
    border: 1px solid rgba(244, 246, 245, 0.3);
    border-radius: 8px;
    padding: 14px 15px;
    background: transparent;
    color: var(--text);
    font-family: var(--font-display);
    font-size: 15px;
  }

  input::placeholder {
    color: var(--text-42);
  }

  input:focus {
    outline: none;
    border-color: var(--accent);
  }

  button {
    margin-top: 4px;
    background: var(--accent);
    border: 0;
    border-radius: 9px;
    padding: 15px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 16px;
    color: var(--page);
    cursor: pointer;
  }

  button:hover {
    background: #f0b94e;
  }

  .fine {
    margin: 4px 0 0;
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--text-42);
  }

  .error {
    margin: 0;
    padding: 12px 14px;
    border-radius: 8px;
    background: rgba(224, 82, 82, 0.12);
    border: 1px solid rgba(224, 82, 82, 0.35);
    color: #f0a9a9;
    font-size: 14px;
    line-height: 1.5;
  }

  .sent {
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 11px;
    padding: 22px;
  }

  .sent-lead {
    margin: 0;
    font-size: 17px;
    font-weight: 500;
  }

  .sent-sub {
    margin: 8px 0 0;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--text-55);
  }

  .art {
    background:
      radial-gradient(300px 200px at 40% 20%, rgba(43, 163, 163, 0.28), transparent 65%),
      linear-gradient(150deg, #125f6f, #0a2a31);
  }

  @media (max-width: 720px) {
    .card {
      grid-template-columns: 1fr;
    }

    .art {
      display: none;
    }

    .pane {
      padding: 32px 24px;
    }
  }
</style>
