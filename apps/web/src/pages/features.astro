---
import SiteFooter from '../components/SiteFooter.astro';
import StoreBadge from '../components/StoreBadge.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Base from '../layouts/Base.astro';
import { aboutCopy } from '@locastar/shared';
import { FEATURE_DETAIL, type FeatureItem } from '../i18n/featureList';
import { useTranslations } from '../i18n/ui';
import { appStoreReady, googlePlayReady, STORE_LINKS } from '../lib/site';

/*
 * Four alternating bands, from the app's own About copy (about.find*, save*,
 * private*, contribute* in apps/mobile/src/locales/en.json). Same words as the
 * app, per the handoff — not rewritten for the web.
 */
export const prerender = false;

const origin = Astro.site?.origin ?? Astro.url.origin;
const lang = Astro.locals.lang ?? 'en';
const t = useTranslations(lang);

/*
 * The four bands are the app's own "what you can do here" copy, which already
 * exists in both languages — writing a second set of four sentences saying the
 * same thing is how two descriptions of one product start to disagree.
 */
const about = aboutCopy(lang);

const title = t('features.title');
const description = t('features.metaDesc');

/*
 * The promise, then what it actually means.
 *
 * The four leads are the app's own About copy; the lines under each come from
 * featureList.ts. Before this the page made four claims and stopped, which
 * left the one question a visitor arrives with — "so what can I actually do?"
 * — answered nowhere on the site.
 */
const detail = FEATURE_DETAIL[lang === 'sv' ? 'sv' : 'en'];

const bands = [
  { lead: about.findLead, body: about.findBody, image: '01-find', items: detail.find },
  { lead: about.saveLead, body: about.saveBody, image: '02-save', items: detail.save },
  { lead: about.privateLead, body: about.privateBody, image: '03-plan', items: detail.private },
  { lead: about.contributeLead, body: about.contributeBody, image: '04-contribute', items: detail.contribute },
];

const whereLabel = (item: FeatureItem) => (item.where === 'app' ? detail.whereApp : detail.whereBoth);
---

<Base title={`${title} | LocaStar`} description={description} canonical={`${origin}/features`}>
  <SiteHeader current="features" />

  <main id="main">
    <header class="wrap head">
      <h1>{about.doTitle}</h1>
      <p class="lead">{about.gap4}</p>
    </header>

    {
      bands.map((band, index) => (
        <section class={`band${index % 2 === 1 ? ' flip' : ''}`}>
          <div class="wrap band-inner">
            <div class="band-copy">
              <h2>{band.lead}</h2>
              <p>{band.body}</p>
              <dl class="detail">
                {band.items.map((item) => (
                  <div class="item">
                    <dt>{item.title}</dt>
                    <dd>{item.body}</dd>
                    <span class={`mono where${item.where === 'app' ? ' app' : ''}`}>{whereLabel(item)}</span>
                  </div>
                ))}
              </dl>
            </div>
            <picture class="band-art">
              <source srcset={`/images/features/${band.image}.webp`} type="image/webp" />
              <img
                src={`/images/features/${band.image}.png`}
                alt={band.lead}
                width="1304"
                height="880"
                loading={index === 0 ? 'eager' : 'lazy'}
                fetchpriority={index === 0 ? 'high' : undefined}
              />
            </picture>
          </div>
        </section>
      ))
    }

    {
      [detail.account, detail.safety].map((block) => (
        <section class="wrap block">
          <h2>{block.heading}</h2>
          <p class="lead">{block.lead}</p>
          <dl class="detail wide">
            {block.items.map((item) => (
              <div class="item">
                <dt>{item.title}</dt>
                <dd>{item.body}</dd>
                <span class={`mono where${item.where === 'app' ? ' app' : ''}`}>{whereLabel(item)}</span>
              </div>
            ))}
          </dl>
        </section>
      ))
    }

    <section class="wrap closing">
      <div class="closing-inner on-dark">
        <h2>{t('features.freeTitle')}</h2>
        <p>{t('features.freeBody')}</p>
        <div class="badges">
          <StoreBadge store="apple" over={t('features.appStoreOver')} name="App Store" href={STORE_LINKS.appStore} ready={appStoreReady} />
          <StoreBadge store="google" over={t('features.googlePlayOver')} name="Google Play" href={STORE_LINKS.googlePlay} ready={googlePlayReady} />
        </div>
        {/* Same note the home page carries, and for the same reason: a greyed
            badge with no sentence beside it reads as a broken app rather than
            an unreleased one. It hides itself the moment STORE_LINKS.googlePlay
            is filled in — so does the one on the home page. */}
        {!googlePlayReady && <span class="android-note">{t('home.androidNotYet')}</span>}
      </div>
    </section>
  </main>

  <SiteFooter />
</Base>

<style>
  .head {
    padding-block: 48px 8px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  h1 {
    font-size: clamp(32px, 5vw, 52px);
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .lead {
    margin: 0;
    font-size: 18px;
    line-height: 1.6;
    color: var(--text-70);
    max-width: 60ch;
  }

  .band {
    padding-block: 48px;
  }

  .band:nth-child(odd) {
    background: var(--surface);
  }

  .band-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }

  .band.flip .band-inner {
    direction: rtl;
  }

  .band.flip .band-copy {
    direction: ltr;
  }

  .band-copy h2 {
    font-size: clamp(22px, 3vw, 30px);
    line-height: 1.2;
    margin-bottom: 12px;
  }

  .band-copy p {
    margin: 0;
    font-size: 17px;
    line-height: 1.65;
    color: var(--text-70);
    max-width: 50ch;
  }

  /*
   * A description list, because that is what it is: a name and what it means.
   * Hairlines rather than cards — twenty-four boxes would read as twenty-four
   * separate things, when it is one list per promise.
   */
  .detail {
    margin: 6px 0 0;
    border-top: 1px solid var(--hairline);
  }

  .item {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2px 14px;
    padding-block: 12px;
    border-bottom: 1px solid var(--hairline);
  }

  .item dt {
    grid-column: 1;
    font-weight: 500;
    font-size: 15.5px;
  }

  .item dd {
    grid-column: 1;
    margin: 0;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--text-55);
  }

  /* Which product a line belongs to. Most of the map reads on the website;
     adding, reviewing, sharing with a friend and blocking are the app's. */
  .where {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: start;
    padding-top: 4px;
    font-size: 9.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-42);
    white-space: nowrap;
  }

  .where.app {
    color: var(--brand-light);
  }

  /* The two sections with no illustration run the full column. */
  .block {
    padding-block: 44px 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .block h2 {
    font-size: clamp(22px, 3vw, 30px);
  }

  .block .lead {
    font-size: 17px;
    max-width: 56ch;
  }

  .detail.wide .item dd {
    max-width: 78ch;
  }

  /*
   * aspect-ratio, not a fixed height: the source illustrations are 1304x880.
   * A fixed height on a fluid-width column meant the rendered box almost never
   * matched that ratio, so the image was stretched or cropped depending on
   * viewport width. object-fit: cover is just the safety net for the rare
   * in-between size, not the mechanism doing the work.
   */
  .band-art {
    aspect-ratio: 1304 / 880;
    border-radius: 13px;
    overflow: hidden;
    background: var(--surface);
  }

  .band-art img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .closing {
    padding-block: 56px 72px;
  }

  /*
   * The one dark panel on the page, and the last thing on it.
   *
   * The same gradient the home page's hero and download band use. Spent once:
   * a page of alternating dark panels would make the home page's own panels
   * ordinary, and half a page of reversed text is harder to read for the
   * people who chose the light theme on purpose.
   */
  .closing-inner {
    border-radius: 14px;
    padding: 40px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    align-items: flex-start;
    background:
      radial-gradient(620px 300px at 18% 8%, rgba(43, 163, 163, 0.28), transparent 62%),
      linear-gradient(150deg, #125f6f 0%, #0a2a31 52%, #07100f 100%);
    color: var(--text);
  }

  .closing h2 {
    font-size: 28px;
  }

  .closing p {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-70);
    max-width: 56ch;
  }

  .badges {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 6px;
  }

  .android-note {
    font-size: 14px;
    line-height: 1.4;
    color: var(--accent);
  }

  .store {
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 12px 20px;
    background: var(--text);
    border-radius: 9px;
    color: var(--page);
  }

  .store:hover {
    color: var(--page);
  }

  .store.waiting {
    opacity: 0.72;
    cursor: default;
  }

  .store-mark {
    width: 22px;
    height: 22px;
    border-radius: 5px;
    background: repeating-linear-gradient(45deg, #d9ddd9, #d9ddd9 5px, #c9cfc9 5px, #c9cfc9 10px);
    flex: none;
  }

  .store-text {
    display: flex;
    flex-direction: column;
  }

  .over {
    font-size: 8px;
    line-height: 1.2;
    letter-spacing: 0.1em;
    /* The chip is inverted — its background is --text — so its ink is the
       page colour, not a fixed dark. Hardcoded, this vanished on the light
       theme where the chip itself turns dark. */
    color: rgba(var(--page-rgb), 0.62);
  }

  .store-name {
    font-weight: 600;
    font-size: 16px;
    line-height: 1.2;
  }

  @media (max-width: 900px) {
    .band-inner,
    .band.flip .band-inner {
      grid-template-columns: 1fr;
      direction: ltr;
      gap: 24px;
    }
  }
</style>
