---
import {
  fetchCategoryBySlug,
  fetchCategoryCounts,
  fetchCategoryPlaces,
  fetchLocationTotal,
  fetchPublicLists,
} from '@locastar/shared';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Base from '../layouts/Base.astro';
import { categoryColor, ratingLabel } from '../lib/format';
import { storeLinksReady, STORE_LINKS } from '../lib/site';
import { anonClient } from '../lib/supabase';

export const prerender = false;

const supabase = anonClient();

/*
 * The counts are the page, so they are not allowed to fail quietly.
 *
 * Defaulting them to zero would render "0 places and activities" — a false
 * claim that the map is empty, on the first page anyone sees. 503 says the
 * server is having a moment, which is both true and retryable.
 *
 * The shared-lists strip is different: it is supplementary, so losing it just
 * drops a section.
 */
let categoryCounts;
let totalPlaces;
try {
  [categoryCounts, totalPlaces] = await Promise.all([fetchCategoryCounts(supabase), fetchLocationTotal(supabase)]);
} catch (error) {
  console.error('Failed to load the home page counts', error);
  return new Response('Temporarily unavailable', {
    status: 503,
    headers: { 'Retry-After': '60' },
  });
}

const lists = await fetchPublicLists(supabase).catch((error) => {
  console.error('Failed to load shared lists', error);
  return [];
});

const withPlaces = categoryCounts.filter((row) => row.count > 0);

/*
 * The strip's places.
 *
 * Ordered by review count, so the ones somebody has actually written about come
 * first — which is the best that can be done on the server, since it has no
 * idea where the visitor is. Making the heading literally true needs the
 * browser's location; see the note on the heading itself.
 */
const biggest = withPlaces[0];
const biggestCategory = biggest ? await fetchCategoryBySlug(supabase, biggest.slug).catch(() => null) : null;
const featured = biggestCategory
  ? (await fetchCategoryPlaces(supabase, biggestCategory.id, { limit: 4 }).catch(() => ({ places: [], total: 0 })))
      .places
  : [];

const publicUrl = (path: string | null) =>
  path ? supabase.storage.from('media').getPublicUrl(path).data.publicUrl : null;

const origin = Astro.site?.origin ?? Astro.url.origin;

const title = 'LocaStar — a map of things to actually go and do';
const description =
  `${totalPlaces} places and activities across Sweden — courts, trails, slopes, playgrounds and festivals, ` +
  'described by the people who have been there. Free, and you can browse without an account.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'LocaStar',
    url: `${origin}/`,
    description,
  },
];
---

<Base title={title} description={description} canonical={`${origin}/`} jsonLd={jsonLd}>
  <SiteHeader current="explore" />

  <main id="main">
    <section class="hero">
      <div class="hero-shade"></div>

      <div class="hero-inner">
        <span class="mono eyebrow">
          {totalPlaces} PLACES AND ACTIVITIES · {withPlaces.length} CATEGORIES
        </span>

        <h1>Explore</h1>

        <p class="promise">
          One map of things to actually go and do — described by the people who have been there.
        </p>

        <div class="badges">
          {
            storeLinksReady ? (
              <>
                <a class="store" href={STORE_LINKS.appStore}>
                  <span class="store-mark" aria-hidden="true" />
                  <span class="store-text">
                    <span class="mono over">DOWNLOAD ON THE</span>
                    <span class="store-name">App Store</span>
                  </span>
                </a>
                <a class="store" href={STORE_LINKS.googlePlay}>
                  <span class="store-mark" aria-hidden="true" />
                  <span class="store-text">
                    <span class="mono over">GET IT ON</span>
                    <span class="store-name">Google Play</span>
                  </span>
                </a>
              </>
            ) : (
              /*
               * Spans, not links, until the apps are public: the App Store id
               * does not exist until Apple approves, and a badge that 404s is
               * worse than one that waits. They become links the moment
               * STORE_LINKS is filled in — the design is identical either way.
               */
              <>
                <span class="store waiting">
                  <span class="store-mark" aria-hidden="true" />
                  <span class="store-text">
                    <span class="mono over">DOWNLOAD ON THE</span>
                    <span class="store-name">App Store</span>
                  </span>
                </span>
                <span class="store waiting">
                  <span class="store-mark" aria-hidden="true" />
                  <span class="store-text">
                    <span class="mono over">GET IT ON</span>
                    <span class="store-name">Google Play</span>
                  </span>
                </span>
              </>
            )
          }
          <span class="badge-note">Free · iOS and Android · English and Swedish</span>
        </div>
      </div>

      <form class="finder" action="/search" method="get">
        <label class="cell activity">
          <span class="mono cell-label">ACTIVITY</span>
          <input name="q" placeholder="Basketball, skiing, hiking…" autocomplete="off" />
        </label>
        <label class="cell">
          <span class="mono cell-label">WHERE</span>
          <input name="where" placeholder="Near me" autocomplete="off" />
        </label>
        <label class="cell narrow">
          <span class="mono cell-label">TYPE</span>
          <select name="kind">
            <option value="">Place · Activity</option>
            <option value="place">Place</option>
            <option value="activity">Activity</option>
          </select>
        </label>
        <label class="cell narrow">
          <span class="mono cell-label">SEASON</span>
          <select name="season">
            <option value="">Any</option>
            <option value="summer">Summer</option>
            <option value="winter">Winter</option>
          </select>
        </label>
        <button class="finder-go" type="submit">Explore</button>
      </form>
    </section>

    {
      featured.length > 0 && (
        <section class="wrap strip">
          <div class="strip-head">
            <h2>Near you</h2>
            <a class="mono see-all" href="/search">
              SEE ALL {totalPlaces} →
            </a>
          </div>
          <div class="grid-4">
            {featured.map((place) => {
              const colour = categoryColor(biggest?.slug ?? null);
              const rating = ratingLabel(place.avgRating, place.reviewCount);
              const cover = publicUrl(place.coverPhotoPath);
              return (
                <a class="card" href={`/location/${place.id}`} style={`border-color:${colour}`}>
                  {cover ? (
                    <div class="card-photo" style={`background-image:url("${cover}")`} />
                  ) : (
                    <div class="card-photo flat" style={`background:${colour}`}>
                      <span class="mono">{biggest?.name ?? ''}</span>
                    </div>
                  )}
                  <div class="card-body">
                    <span class="card-badge" style={`background:${colour}`}>
                      {biggest?.name ?? ''}
                    </span>
                    <span class="card-name">{place.name}</span>
                    {rating.rated ? (
                      <span class="mono card-rating">
                        ★ {rating.avg} <span class="dim">({rating.count})</span>
                      </span>
                    ) : (
                      <span class="mono card-unrated">NOT RATED YET</span>
                    )}
                    {place.city && <span class="card-where">{place.city}</span>}
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      )
    }

    <section class="wrap browse">
      <div class="strip-head tight">
        <h2>Browse by activity</h2>
        <span class="soft">{withPlaces.length} categories, grouped the way the map is</span>
      </div>
      <div class="cat-grid">
        {
          withPlaces.slice(0, 23).map((row) => (
            <a class="cat" href={`/activity/${row.slug}`} style={`background:${categoryColor(row.slug)}`}>
              <span class="cat-name">{row.name}</span>
              <span class="mono cat-count">{row.count}</span>
            </a>
          ))
        }
        {
          withPlaces.length > 23 && (
            <a class="cat more" href="/categories">
              <span class="cat-name">+{withPlaces.length - 23} more</span>
            </a>
          )
        }
      </div>
    </section>

    {
      lists.length > 0 && (
        <section class="wrap strip">
          <div class="strip-head">
            <h2>Lists people have shared</h2>
            <a class="mono see-all" href="/community">
              COMMUNITY →
            </a>
          </div>
          <div class="grid-4">
            {lists.slice(0, 4).map((list) => {
              const previews = list.previewLocations.slice(0, 3);
              return (
                <a class="list-card" href={`/lists/${list.id}`}>
                  <span class="list-name">{list.name}</span>
                  <span class="list-by">
                    by {list.ownerUsername ?? list.ownerDisplayName ?? 'someone on LocaStar'}
                  </span>
                  <div class="list-mosaic">
                    <div
                      class="lm-main"
                      style={previews[0]?.imageUrl ? `background-image:url("${previews[0].imageUrl}")` : ''}
                    />
                    <div class="lm-side">
                      <div
                        class="lm-tile"
                        style={previews[1]?.imageUrl ? `background-image:url("${previews[1].imageUrl}")` : ''}
                      />
                      <div
                        class="lm-tile"
                        style={previews[2]?.imageUrl ? `background-image:url("${previews[2].imageUrl}")` : ''}
                      />
                    </div>
                  </div>
                  <span class="mono list-count">
                    {list.itemCount} {list.itemCount === 1 ? 'PLACE' : 'PLACES'} · {list.likeCount} LIKES
                  </span>
                </a>
              );
            })}
          </div>
        </section>
      )
    }

    <section class="wrap" id="get-the-app">
      <div class="band">
        <div class="band-copy">
          <h2>The whole map, in your pocket</h2>
          <p>
            Directions from where you actually are, places saved for later, and a reminder before something you
            wanted to see starts.
          </p>
          <div class="band-badges">
            <span class="store waiting">
              <span class="store-mark" aria-hidden="true" />
              <span class="store-text">
                <span class="mono over">DOWNLOAD ON THE</span>
                <span class="store-name">App Store</span>
              </span>
            </span>
            <span class="store waiting">
              <span class="store-mark" aria-hidden="true" />
              <span class="store-text">
                <span class="mono over">GET IT ON</span>
                <span class="store-name">Google Play</span>
              </span>
            </span>
          </div>
          <p class="band-note">Free, no ads. Works in English and Swedish.</p>
        </div>

        <div class="band-art">
          <div class="phone tall">
            <img src="/app/screen-1.jpg" alt="The LocaStar app showing places near you" loading="lazy" />
          </div>
          <div class="phone short">
            <img src="/app/screen-2.jpg" alt="The LocaStar app showing a place in detail" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <SiteFooter />
  </main>
</Base>

<style>
  /*
   * The mockup is a 1440px canvas, so the hero stops there rather than running
   * to the edge of a wide monitor.
   *
   * No hero photograph yet: the mockup uses one of the owner's own pictures,
   * and a stock photo of somewhere not in the map would be exactly the
   * dishonesty the rest of the site avoids. A deep brand gradient holds the
   * space and a real picture drops in behind it with one line.
   */
  .hero {
    position: relative;
    max-width: 1440px;
    margin: 0 auto;
    min-height: 660px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background:
      radial-gradient(900px 420px at 22% 12%, rgba(43, 163, 163, 0.28), transparent 62%),
      linear-gradient(150deg, #125f6f 0%, #0a2a31 46%, #07100f 100%);
    overflow: hidden;
  }

  .hero-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(7, 16, 15, 0.55) 0%,
      rgba(7, 16, 15, 0.15) 40%,
      rgba(7, 16, 15, 0.92) 100%
    );
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    padding: 150px var(--gutter) 0;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .eyebrow {
    font-size: 11px;
    letter-spacing: 0.22em;
    color: var(--accent);
  }

  h1 {
    font-size: clamp(58px, 12vw, 168px);
    line-height: 0.9;
    letter-spacing: -0.045em;
    margin: 0;
  }

  .promise {
    font-size: clamp(19px, 2.4vw, 26px);
    line-height: 1.4;
    color: rgba(244, 246, 245, 0.88);
    margin: 0;
    max-width: 620px;
    text-wrap: pretty;
  }

  /* ---- store badges ---- */
  .badges {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 6px;
  }

  .store {
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 12px 20px;
    background: var(--text);
    border-radius: 9px;
    color: var(--page);
  }

  .store:hover {
    color: var(--page);
  }

  .store.waiting {
    opacity: 0.72;
    cursor: default;
  }

  .store-mark {
    width: 22px;
    height: 22px;
    border-radius: 5px;
    background: repeating-linear-gradient(45deg, #d9ddd9, #d9ddd9 5px, #c9cfc9 5px, #c9cfc9 10px);
    flex: none;
  }

  .store-text {
    display: flex;
    flex-direction: column;
  }

  .over {
    font-size: 8px;
    line-height: 1.2;
    letter-spacing: 0.1em;
    color: rgba(7, 16, 15, 0.55);
  }

  .store-name {
    font-weight: 600;
    font-size: 16px;
    line-height: 1.2;
  }

  .badge-note {
    font-size: 13px;
    line-height: 1.4;
    color: rgba(244, 246, 245, 0.62);
    max-width: 170px;
    padding-left: 8px;
  }

  /* ---- the finder, pinned to the hero's lower edge ---- */
  .finder {
    position: relative;
    margin: 44px var(--gutter) 36px;
    display: flex;
    background: rgba(7, 16, 15, 0.72);
    border: 1px solid rgba(244, 246, 245, 0.16);
    border-radius: 10px;
    overflow: hidden;
    backdrop-filter: blur(14px);
  }

  .cell {
    flex: 1;
    padding: 18px 22px;
    border-right: 1px solid rgba(244, 246, 245, 0.14);
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
    cursor: text;
  }

  .cell.activity {
    flex: 1.2;
  }

  .cell.narrow {
    flex: 0.8;
  }

  .cell-label {
    font-size: 9.5px;
    letter-spacing: 0.16em;
    color: rgba(244, 246, 245, 0.5);
  }

  .cell input,
  .cell select {
    background: transparent;
    border: 0;
    padding: 0;
    color: rgba(244, 246, 245, 0.85);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 15px;
    line-height: 1;
    width: 100%;
  }

  .cell input::placeholder {
    color: rgba(244, 246, 245, 0.85);
  }

  .cell select option {
    background: var(--surface);
    color: var(--text);
  }

  .finder-go {
    width: 190px;
    flex: none;
    background: var(--accent);
    border: 0;
    color: var(--page);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 17px;
    cursor: pointer;
  }

  .finder-go:hover {
    background: #f0b94e;
  }

  /* ---- section furniture ---- */
  .strip,
  .browse {
    padding-top: 64px;
  }

  .strip-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 22px;
    flex-wrap: wrap;
  }

  .strip-head.tight {
    justify-content: flex-start;
  }

  .strip-head h2 {
    font-size: clamp(24px, 3vw, 30px);
  }

  .see-all {
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--link);
  }

  .soft {
    font-size: 15px;
    color: var(--text-55);
  }

  .grid-4 {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }

  .card {
    border: 1px solid;
    border-radius: 11px;
    overflow: hidden;
    background: var(--surface);
    color: var(--text);
    display: flex;
    flex-direction: column;
    transition: box-shadow 120ms ease-out;
  }

  .card:hover {
    color: var(--text);
    box-shadow: 0 0 0 3px rgba(232, 169, 59, 0.12);
  }

  .card-photo {
    height: 158px;
    background-size: cover;
    background-position: center;
  }

  .card-photo.flat {
    display: flex;
    align-items: flex-end;
    padding: 12px;
  }

  .card-photo.flat .mono {
    font-size: 10px;
    letter-spacing: 0.14em;
    color: rgba(255, 255, 255, 0.85);
  }

  .card-body {
    padding: 15px 16px;
    display: flex;
    flex-direction: column;
    gap: 7px;
    align-items: flex-start;
  }

  .card-badge {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 5px 8px;
    border-radius: 4px;
    color: #fff;
  }

  .card-name {
    font-weight: 500;
    font-size: 16px;
    line-height: 1.2;
  }

  .card-rating {
    font-size: 11.5px;
    color: var(--accent);
  }

  .dim {
    color: var(--text-42);
  }

  .card-unrated {
    font-size: 11.5px;
    letter-spacing: 0.14em;
    color: var(--text-42);
  }

  .card-where {
    font-size: 13px;
    color: var(--text-55);
  }

  /* ---- category grid ---- */
  .cat-grid {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 10px;
  }

  .cat {
    height: 74px;
    border-radius: 9px;
    padding: 10px 12px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 3px;
    color: #fff;
    transition: box-shadow 120ms ease-out;
  }

  .cat:hover {
    color: #fff;
    box-shadow: 0 0 0 3px rgba(232, 169, 59, 0.18);
  }

  .cat-name {
    font-weight: 500;
    font-size: 13px;
    line-height: 1.15;
  }

  .cat-count {
    font-size: 10px;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.7);
  }

  .cat.more {
    background: var(--surface-alt);
    color: var(--text-70);
    justify-content: center;
  }

  /* ---- shared lists, in the blue family the app uses ---- */
  .list-card {
    background: var(--list-surface);
    border: 1px solid rgba(76, 143, 232, 0.3);
    border-radius: 11px;
    padding: 18px;
    display: flex;
    flex-direction: column;
    color: var(--text);
    transition: box-shadow 120ms ease-out;
  }

  .list-card:hover {
    color: var(--text);
    box-shadow: 0 0 0 3px rgba(232, 169, 59, 0.12);
  }

  .list-name {
    font-weight: 500;
    font-size: 17px;
    line-height: 1.25;
  }

  .list-by {
    font-size: 13px;
    line-height: 1;
    color: var(--text-55);
    margin: 6px 0 14px;
  }

  .list-mosaic {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 5px;
    height: 110px;
  }

  .lm-side {
    display: grid;
    grid-template-rows: 1fr 1fr;
    gap: 5px;
  }

  .lm-main,
  .lm-tile {
    border-radius: 6px;
    background-color: rgba(244, 246, 245, 0.06);
    background-size: cover;
    background-position: center;
  }

  .list-count {
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--text-55);
    margin-top: 12px;
  }

  /* ---- download band ---- */
  .band {
    margin-top: 72px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: end;
    background: linear-gradient(150deg, #125f6f, #0a2a31);
    border-radius: 14px;
    overflow: hidden;
    padding-left: 44px;
  }

  .band-copy {
    padding-block: 44px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    align-items: flex-start;
    align-self: center;
  }

  .band-copy h2 {
    font-size: clamp(24px, 3vw, 32px);
  }

  .band-copy p {
    font-size: 16px;
    line-height: 1.6;
    color: rgba(244, 246, 245, 0.75);
    margin: 0;
    max-width: 46ch;
  }

  .band-badges {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 4px;
  }

  .band-note {
    font-size: 13px;
    color: rgba(244, 246, 245, 0.55);
  }

  .band-art {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 20px;
    padding-top: 44px;
  }

  .phone {
    width: 186px;
    border-radius: 26px 26px 0 0;
    border: 7px solid #05100f;
    background: #0a0a0d;
    overflow: hidden;
    flex: none;
  }

  .phone img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .phone.tall {
    height: 380px;
  }

  .phone.short {
    height: 330px;
    margin-bottom: -14px;
  }

  @media (max-width: 1279px) {
    .grid-4 {
      grid-template-columns: repeat(2, 1fr);
    }

    .cat-grid {
      grid-template-columns: repeat(4, 1fr);
    }

    .finder {
      flex-wrap: wrap;
    }

    .cell {
      flex: 1 1 45%;
    }

    .finder-go {
      width: 100%;
      padding-block: 16px;
    }

    .band {
      grid-template-columns: 1fr;
      padding-left: 0;
    }

    .band-copy {
      padding-inline: 28px;
    }
  }

  @media (max-width: 767px) {
    .hero {
      min-height: 400px;
    }

    .hero-inner {
      padding-top: 72px;
    }

    .grid-4 {
      grid-template-columns: 1fr;
    }

    .cat-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .cell {
      flex: 1 1 100%;
      border-right: 0;
      border-bottom: 1px solid rgba(244, 246, 245, 0.14);
    }
  }
</style>
