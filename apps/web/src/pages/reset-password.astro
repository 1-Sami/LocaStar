---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Base from '../layouts/Base.astro';
import { useTranslations, localePath } from '../i18n/ui';

/*
 * Where a password-reset email lands.
 *
 * The path is not a choice. `authRedirectTo('/reset-password')` in the mobile
 * app compiles this exact URL into every installed binary, so the address in
 * an email sent to somebody on last week's build points here and cannot be
 * changed retroactively. The old Expo export served this route; the Astro site
 * did not, so before this page existed the domain cutover would have turned
 * every reset link into a 404 — silently, and only for people already locked
 * out of their account.
 *
 * Rendered on the server, driven in the browser: Supabase returns the recovery
 * session in the URL *fragment*, which is never sent to a server. The markup
 * below is the shell; the script decides which part of it is visible.
 */
export const prerender = false;

const lang = Astro.locals.lang ?? 'en';
const t = useTranslations(lang);
const p = (href: string) => localePath(href, lang);

const origin = Astro.site?.origin ?? Astro.url.origin;

---

<Base title={t('reset.title')} description={t('reset.metaDesc')} canonical={`${origin}/reset-password`}>
  <SiteHeader />

  <main id="main" class="wrap">
    <div class="card">
      {/* Three states, one of which the script reveals. Starting from
          "checking" rather than the form means a dead link never flashes an
          input somebody might start typing into. */}
      <div data-state="checking">
        <h1>{t('reset.heading')}</h1>
        <p class="lead">{t('reset.checking')}</p>
      </div>

      <div data-state="invalid" hidden>
        <h1>{t('reset.linkInvalid')}</h1>
        <p class="lead">{t('reset.linkInvalidSub')}</p>
        <a class="ghost" href={p('/auth/forgot-password')}>{t('reset.askAgain')}</a>
      </div>

      <div data-state="form" hidden>
        <h1>{t('reset.heading')}</h1>

        <form class="form" id="reset-form">
          <p class="error" role="alert" data-error hidden></p>

          <label class="field">
            <span class="mono label">{t('reset.newPassword')}</span>
            <span class="password-wrap">
              <input name="password" type="password" required autocomplete="new-password" minlength="8" />
              <button
                type="button"
                class="password-toggle"
                aria-label={t('auth.showPassword')}
                aria-pressed="false"
                data-hide-label={t('auth.hidePassword')}
              >
                <svg class="icon-eye" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"></path>
                  <circle cx="12" cy="12" r="3"></circle>
                </svg>
                <svg class="icon-eye-off" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:none">
                  <path d="M3 3l18 18"></path>
                  <path d="M10.6 10.6a3 3 0 0 0 4.24 4.24"></path>
                  <path d="M9.4 5.3A10.9 10.9 0 0 1 12 5c6.5 0 10 7 10 7a13.7 13.7 0 0 1-3.1 3.9M6.2 6.2A13.7 13.7 0 0 0 2 12s3.5 7 10 7c1.1 0 2.1-.15 3-.4"></path>
                </svg>
              </button>
            </span>
            <span class="hint">{t('reset.hint')}</span>
          </label>

          <label class="field">
            <span class="mono label">{t('reset.confirmPassword')}</span>
            <span class="password-wrap">
              <input name="confirm" type="password" required autocomplete="new-password" minlength="8" />
              <button
                type="button"
                class="password-toggle"
                aria-label={t('auth.showPassword')}
                aria-pressed="false"
                data-hide-label={t('auth.hidePassword')}
              >
                <svg class="icon-eye" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"></path>
                  <circle cx="12" cy="12" r="3"></circle>
                </svg>
                <svg class="icon-eye-off" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:none">
                  <path d="M3 3l18 18"></path>
                  <path d="M10.6 10.6a3 3 0 0 0 4.24 4.24"></path>
                  <path d="M9.4 5.3A10.9 10.9 0 0 1 12 5c6.5 0 10 7 10 7a13.7 13.7 0 0 1-3.1 3.9M6.2 6.2A13.7 13.7 0 0 0 2 12s3.5 7 10 7c1.1 0 2.1-.15 3-.4"></path>
                </svg>
              </button>
            </span>
          </label>

          <button type="submit" data-submit>{t('reset.save')}</button>
        </form>
      </div>

      <div data-state="saved" hidden>
        <h1>{t('reset.saved')}</h1>
        <p class="lead">{t('reset.savedSub')}</p>
        <a class="ghost" href={p('/auth/sign-in')}>{t('auth.signIn')}</a>
      </div>
    </div>
  </main>

  <SiteFooter />
</Base>

{/* A data block, not code — is:inline keeps Astro from trying to bundle it.
    The script below it is the opposite: no attributes, so it does get bundled. */}
<script
  is:inline
  type="application/json"
  id="reset-strings"
  set:html={JSON.stringify({
    tooShort: t('reset.tooShort'),
    needsBoth: t('reset.needsBoth'),
    mismatch: t('reset.mismatch'),
    saving: t('reset.saving'),
    save: t('reset.save'),
    errSave: t('reset.errSave'),
    linkExpiredNow: t('reset.linkExpiredNow'),
  })}
/>

<script>
  /*
   * Bundled, not fetched from a CDN.
   *
   * OPS-03 in the site review was Leaflet loading from unpkg with no integrity
   * hash; it was vendored for exactly the reason that applies doubly here. A
   * third party who can change the response on this page can read a password
   * as it is typed and the token that authorises changing it. Astro puts this
   * through the same bundle as everything else, so it is same-origin and
   * versioned with the deploy.
   */
  import { createClient } from '@supabase/supabase-js';

  const strings = JSON.parse(document.getElementById('reset-strings')!.textContent!);
  const card = document.querySelector('.card')!;

  document.querySelectorAll<HTMLButtonElement>('.password-toggle').forEach((button) => {
    const input = button.parentElement?.querySelector<HTMLInputElement>('input[type="password"], input[type="text"]');
    const eye = button.querySelector<SVGElement>('.icon-eye');
    const eyeOff = button.querySelector<SVGElement>('.icon-eye-off');
    if (!input || !eye || !eyeOff) return;

    const showLabel = button.getAttribute('aria-label')!;
    const hideLabel = button.dataset.hideLabel ?? showLabel;

    button.addEventListener('click', () => {
      const revealing = input.type === 'password';
      input.type = revealing ? 'text' : 'password';
      eye.style.display = revealing ? 'none' : '';
      eyeOff.style.display = revealing ? '' : 'none';
      button.setAttribute('aria-pressed', String(revealing));
      button.setAttribute('aria-label', revealing ? hideLabel : showLabel);
    });
  });

  const show = (name: string) => {
    card.querySelectorAll<HTMLElement>('[data-state]').forEach((el) => {
      el.hidden = el.dataset.state !== name;
    });
  };

  /*
   * persistSession: false on purpose. The rest of the site keeps its session
   * in an httpOnly cookie set by the server; a second one in localStorage
   * would leave the browser believing it is signed in while every
   * server-rendered page disagrees. This one lives in memory, changes the
   * password, and is gone on navigation.
   */
  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL!.trim(),
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY!.trim(),
    { auth: { persistSession: false, autoRefreshToken: false, detectSessionInUrl: false } },
  );

  const query = new URLSearchParams(window.location.search);
  const fragment = new URLSearchParams(window.location.hash.replace(/^#/, ''));

  /*
   * Three shapes reach this page, and the newest one is the reason the others
   * are no longer enough.
   *
   * token_hash — the link goes straight here and nothing is spent until the
   *   form is submitted. This exists because Microsoft Defender's Safe Links
   *   fetches every URL in a message before the recipient sees it, and a
   *   Supabase recovery link is single use: the scan consumed it, so the first
   *   human click already reported otp_expired. Observed on a real hotmail.com
   *   address. A scanner issuing a GET now gets a form and nothing else.
   * code — PKCE, exchanged on load.
   * fragment — the implicit flow, set on load.
   *
   * The last two are kept because messages already sent still carry them, and
   * because they remain what arrives until the email template is changed.
   */
  const tokenHash = query.get('token_hash');
  const otpType = (query.get('type') ?? 'recovery') as 'recovery';
  const code = query.get('code');
  const accessToken = fragment.get('access_token');
  const refreshToken = fragment.get('refresh_token');

  /** Cleared once spent, so a resubmit after a failure cannot replay it. */
  let pendingTokenHash: string | null = tokenHash;

  if (tokenHash) {
    // Deliberately not verified yet. That is the whole point.
    show('form');
    wireForm();
  } else if (code || (accessToken && refreshToken)) {
    const established = code
      ? supabase.auth.exchangeCodeForSession(code)
      : supabase.auth.setSession({ access_token: accessToken!, refresh_token: refreshToken! });

    established
      .then(({ error }) => {
        if (error) return show('invalid');
        /*
         * Take the token out of the address bar once it has been used. It is
         * in browser history and anything the person screenshots otherwise.
         */
        history.replaceState(null, '', window.location.pathname);
        show('form');
        wireForm();
      })
      .catch(() => show('invalid'));
  } else {
    show('invalid');
  }

  function wireForm() {
    const form = document.getElementById('reset-form') as HTMLFormElement;
    const errorBox = form.querySelector<HTMLElement>('[data-error]')!;
    const button = form.querySelector<HTMLButtonElement>('[data-submit]')!;

    const setError = (message: string) => {
      errorBox.textContent = message;
      errorBox.hidden = !message;
    };
    const release = (message: string) => {
      setError(message);
      button.disabled = false;
      button.textContent = strings.save;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const password = (form.elements.namedItem('password') as HTMLInputElement).value;
      const confirm = (form.elements.namedItem('confirm') as HTMLInputElement).value;

      /*
       * The same rule as passwordProblem() in the app and
       * password_requirements in supabase/config.toml. Checked here so the
       * message is immediate and in the reader's language; Supabase enforces
       * it regardless, which is what actually makes it true.
       */
      if (password.length < 8) return setError(strings.tooShort);
      if (!/[a-zA-Z]/.test(password) || !/[0-9]/.test(password)) return setError(strings.needsBoth);
      if (password !== confirm) return setError(strings.mismatch);

      setError('');
      button.disabled = true;
      button.textContent = strings.saving;

      try {
        /*
         * The token is spent here, on a deliberate action, rather than on
         * page load. If it has genuinely expired this is where we find out —
         * later than the old flow told us, which is the cost of not letting
         * a mail scanner burn it first.
         */
        if (pendingTokenHash) {
          const { error } = await supabase.auth.verifyOtp({
            token_hash: pendingTokenHash,
            type: otpType,
          });
          pendingTokenHash = null;
          if (error) return release(strings.linkExpiredNow);
        }

        const { error } = await supabase.auth.updateUser({ password });
        if (error) return release(strings.errSave);

        // Nothing should stay signed in off the back of a recovery token.
        void supabase.auth.signOut().catch(() => {});
        show('saved');
      } catch {
        release(strings.errSave);
      }
    });
  }
</script>

<style>
  main {
    padding-block: 56px 80px;
    display: flex;
    justify-content: center;
  }

  .card {
    width: 100%;
    max-width: 460px;
    background: var(--page);
    border: 1px solid var(--hairline);
    border-radius: 13px;
    padding: clamp(24px, 4vw, 36px);
  }

  h1 {
    font-size: clamp(24px, 3.4vw, 30px);
    line-height: 1.15;
    letter-spacing: -0.025em;
    margin: 0 0 12px;
  }

  .lead {
    margin: 0 0 24px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-70);
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 20px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .label {
    font-size: 10px;
    letter-spacing: 0.16em;
    color: var(--text-55);
  }

  .hint {
    font-size: 12.5px;
    color: var(--text-55);
  }

  input {
    width: 100%;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 9px;
    padding: 13px 14px;
    font: inherit;
    font-size: 15px;
    color: var(--text);
  }

  input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  .password-wrap {
    position: relative;
    display: block;
  }

  .password-wrap input {
    padding-right: 44px;
  }

  .password-toggle {
    position: absolute;
    right: 4px;
    top: 50%;
    transform: translateY(-50%);
    width: 34px;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: 0;
    border-radius: 6px;
    padding: 0;
    color: var(--text-55);
    cursor: pointer;
  }

  .password-toggle:hover {
    color: var(--text);
    background: rgba(244, 246, 245, 0.08);
  }

  button {
    background: var(--accent);
    color: var(--page);
    border: 0;
    border-radius: 9px;
    padding: 14px;
    font: inherit;
    font-weight: 600;
    font-size: 15px;
    cursor: pointer;
  }

  button:hover {
    background: #f0b94e;
  }

  button:disabled {
    opacity: 0.6;
    cursor: default;
  }

  .ghost {
    display: inline-block;
    border: 1px solid var(--border);
    border-radius: 9px;
    padding: 13px 22px;
    font-weight: 500;
    font-size: 15px;
    color: var(--text);
  }

  .ghost:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .error {
    margin: 0;
    padding: 11px 13px;
    border-left: 2px solid #e06060;
    background: rgba(224, 96, 96, 0.08);
    font-size: 14px;
    line-height: 1.55;
    color: var(--text);
  }
</style>
