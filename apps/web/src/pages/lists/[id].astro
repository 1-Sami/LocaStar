---
import { fetchCategoryCounts, fetchListItems, fetchListMeta } from '@locastar/shared';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Base from '../../layouts/Base.astro';
import { categoryColor, ratingLabel } from '../../lib/format';
import { isUuid } from '../../lib/ids';
import { useTranslations, localePath } from '../../i18n/ui';
import { currentUser } from '../../lib/auth';
import { anonClient } from '../../lib/supabase';

/*
 * A frozen URL — public list share links from the app point here, so it has to
 * resolve for a stranger. RLS decides: a public list is readable by `anon`, a
 * private one is not, and the page 404s for it exactly as it should.
 */
export const prerender = false;

const { id } = Astro.params;
// A string that cannot be an id is a page that does not exist, not an outage.
if (!isUuid(id)) return new Response(null, { status: 404 });

const lang = Astro.locals.lang ?? 'en';
const t = useTranslations(lang);
const p = (href: string) => localePath(href, lang);

/*
 * Read as the visitor when they are signed in.
 *
 * Everything here used to go through the anonymous client, which is right for
 * a stranger and wrong for the owner: RLS hides a private list from `anon`,
 * so the account page's own link to somebody's private list landed them on a
 * 404. Through their session the same RLS lets them see their own lists and
 * anything shared with them, and still nothing else.
 *
 * The cookie check first, so an anonymous visitor costs no auth round trip —
 * the place page does the same.
 */
let supabase = anonClient();
let viewerId: string | null = null;
if ((Astro.request.headers.get('cookie') ?? '').includes('sb-')) {
  const { user, supabase: authed } = await currentUser(Astro.cookies, Astro.request.headers);
  if (user) {
    viewerId = user.id;
    supabase = authed;
  }
}

let meta;
try {
  meta = id ? await fetchListMeta(supabase, id) : null;
} catch (error) {
  console.error('Failed to load list', id, error);
  return new Response('Temporarily unavailable', { status: 503, headers: { 'Retry-After': '60' } });
}

if (!meta) return new Response(null, { status: 404 });

const [items, likes, categories] = await Promise.all([
  fetchListItems(supabase, id!).catch((error): Awaited<ReturnType<typeof fetchListItems>> => {
    console.error('Failed to load list items', id, error);
    return [];
  }),
  /*
   * fetchListMeta does not carry a like count and the design shows one.
   *
   * Wrapped in Promise.resolve because a supabase query builder is a thenable
   * rather than a real Promise — it has .then but no .catch, so the .catch that
   * used to sit here was never going to run.
   */
  Promise.resolve(
    supabase.from('list_likes').select('*', { count: 'exact', head: true }).eq('list_id', id!)
  )
    .then((r) => r.count ?? 0)
    .catch(() => 0),
  // Item rows carry a category slug but not its name.
  fetchCategoryCounts(supabase).catch((): Awaited<ReturnType<typeof fetchCategoryCounts>> => []),
]);

const categoryName = new Map(categories.map((c) => [c.slug, c.name]));

/*
 * The owner gets the app's list controls: rename, public or private, take a
 * place out, delete. Drawn only for them; api/list.ts checks ownership again
 * and RLS decides regardless.
 */
const isOwner = viewerId !== null && viewerId === meta.ownerId;
const backHere = p(`/lists/${meta.id}`);
const listDone = Astro.url.searchParams.get('listDone');
const listError = Astro.url.searchParams.get('listError');
const doneText =
  listDone === 'renamed' ? t('list.doneRenamed')
  : listDone === 'public' ? t('list.donePublic')
  : listDone === 'private' ? t('list.donePrivate')
  : listDone === 'removed' ? t('list.doneRemoved')
  : null;
const errorText = listError === 'name' ? t('list.errName') : listError ? t('list.errFailed') : null;

const owner = meta.ownerUsername ?? meta.ownerDisplayName ?? 'someone on LocaStar';
const origin = Astro.site?.origin ?? Astro.url.origin;
const canonical = `${origin}/lists/${meta.id}`;

const title = `${meta.name} — ${t('list.byLine', { owner })} | LocaStar`;
const description =
  meta.description?.trim() ||
  `${items.length} ${items.length === 1 ? 'place' : 'places'} collected by ${owner} on LocaStar, with directions, photos and reviews from people who have been there.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: meta.name,
    numberOfItems: items.length,
    itemListElement: items.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.name,
      url: `${origin}/location/${item.locationId}`,
    })),
  },
];
---

{/* A private list is only ever seen by its owner or somebody it was shared
    with, and has no business in a search index even if a link escapes. */}
<Base title={title} description={description} canonical={canonical} jsonLd={jsonLd} noindex={!meta.isPublic}>
  <SiteHeader current="community" />

  <main id="main">
    <header class="head">
      <div class="wrap head-inner">
        <span class="mono kicker">{meta.isPublic ? t('list.public') : t('list.private')}</span>
        <h1>{meta.name}</h1>
        {meta.description && <p class="blurb">{meta.description}</p>}
        <div class="byline">
          <span class="avatar" aria-hidden="true"></span>
          <span class="by">{t('community.by', { name: owner })}</span>
          <span class="rule"></span>
          <span class="mono stat">{items.length} {items.length === 1 ? t('list.place_one') : t('list.place_other')}</span>
          {
            meta.isPublic && (
              <>
                <span class="rule" />
                <span class="mono stat">{likes} {likes === 1 ? t('list.like_one') : t('list.like_other')}</span>
              </>
            )
          }
        </div>

        {doneText && <p class="list-note done">{doneText}</p>}
        {errorText && <p class="list-note bad" role="alert">{errorText}</p>}

        {
          isOwner && (
            <details class="manage" open={listError ? true : undefined}>
              <summary>{t('list.manage')}</summary>
              <div class="manage-body">
                <form class="manage-row" method="post" action="/api/list">
                  <input type="hidden" name="action" value="rename" />
                  <input type="hidden" name="listId" value={meta.id} />
                  <input type="hidden" name="back" value={backHere} />
                  <input class="field" name="name" value={meta.name} required aria-label={t('list.nameLabel')} />
                  <button class="btn" type="submit">{t('list.rename')}</button>
                </form>

                <form class="manage-row" method="post" action="/api/list">
                  <input type="hidden" name="action" value="visibility" />
                  <input type="hidden" name="listId" value={meta.id} />
                  <input type="hidden" name="back" value={backHere} />
                  <input type="hidden" name="isPublic" value={meta.isPublic ? '0' : '1'} />
                  <p class="manage-sub">{meta.isPublic ? t('list.publicExplainer') : t('list.privateExplainer')}</p>
                  <button class="btn" type="submit">{meta.isPublic ? t('list.makePrivate') : t('list.makePublic')}</button>
                </form>

                <form method="post" action="/api/list">
                  <input type="hidden" name="action" value="delete" />
                  <input type="hidden" name="listId" value={meta.id} />
                  <input type="hidden" name="back" value={backHere} />
                  <button class="mono danger" type="submit" data-confirm={t('list.deleteConfirm')}>{t('list.delete')}</button>
                </form>
              </div>
            </details>
          )
        }
      </div>
    </header>

    <div class="wrap body">
      {
        items.length === 0 ? (
          <div class="empty">
            <p class="empty-lead">{t('list.empty')}</p>
            <p class="empty-sub">{t('list.emptySub')}</p>
          </div>
        ) : (
          <ol class="rows">
            {items.map((item, index) => {
              const colour = categoryColor(item.categorySlug);
              const rating = ratingLabel(item.avgRating, item.reviewCount);
              const where = [item.categorySlug ? categoryName.get(item.categorySlug) : null, item.city, item.country]
                .filter(Boolean)
                .join(' · ');
              return (
                <li>
                  <a class="row" href={p(`/location/${item.locationId}`)} style={`border-color:${colour}`}>
                    <span class="mono num">{String(index + 1).padStart(2, '0')}</span>
                    {item.imageUrl ? (
                      <div class="thumb" style={`background-image:url("${item.imageUrl}")`} />
                    ) : (
                      <div class="thumb flat" style={`background:${colour}`} />
                    )}
                    <div class="row-body">
                      <span class="row-name">{item.name}</span>
                      {rating.rated ? (
                        <span class="mono row-rating">
                          ★ {rating.avg} <span class="dim">({rating.count})</span>
                        </span>
                      ) : (
                        <span class="mono row-unrated">{t('common.notRated')}</span>
                      )}
                      {where && <span class="row-where">{where}</span>}
                      {item.note && <span class="row-note">{item.note}</span>}
                    </div>
                    <span class="view">{t('list.view')}</span>
                  </a>
                  {/* Beside the row rather than inside it: a form cannot sit
                      inside a link. */}
                  {isOwner && (
                    <form class="remove-item" method="post" action="/api/list">
                      <input type="hidden" name="action" value="remove-item" />
                      <input type="hidden" name="listId" value={meta.id} />
                      <input type="hidden" name="locationId" value={item.locationId} />
                      <input type="hidden" name="back" value={backHere} />
                      <button class="mono danger" type="submit" data-confirm={t('list.removeConfirm')}>{t('list.remove')}</button>
                    </form>
                  )}
                </li>
              );
            })}
          </ol>
        )
      }
    </div>
  </main>

  <SiteFooter />
</Base>

<script is:inline>
  /* Ask before deleting the list or taking a place out of it. */
  document.addEventListener('click', function (event) {
    var el = event.target.closest('[data-confirm]');
    if (el && !window.confirm(el.getAttribute('data-confirm'))) event.preventDefault();
  });
</script>

<style>
  /* The blue family the app uses for lists, not the teal used everywhere else. */
  .head {
    background: var(--list-surface);
  }

  .head-inner {
    padding-block: 40px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .kicker {
    font-size: 10px;
    letter-spacing: 0.2em;
    color: rgba(var(--ink-rgb), 0.5);
  }

  h1 {
    font-size: clamp(30px, 5vw, 46px);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .blurb {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-70);
    max-width: 60ch;
  }

  .byline {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .avatar {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgba(var(--ink-rgb), 0.12);
    flex: none;
  }

  .by {
    font-size: 15px;
    color: rgba(var(--ink-rgb), 0.8);
  }

  .rule {
    width: 1px;
    height: 14px;
    background: rgba(var(--ink-rgb), 0.2);
  }

  .stat {
    font-size: 13px;
    letter-spacing: 0.1em;
    color: var(--text-55);
  }

  .body {
    padding-block: 30px 40px;
  }

  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .row {
    display: flex;
    gap: 16px;
    align-items: center;
    padding: 14px;
    background: var(--surface);
    border: 1px solid;
    border-radius: 11px;
    color: var(--text);
    transition: box-shadow 120ms ease-out;
  }

  .row:hover {
    color: var(--text);
    box-shadow: 0 0 0 3px rgba(232, 169, 59, 0.12);
  }

  .num {
    font-size: 13px;
    width: 20px;
    flex: none;
    color: var(--text-42);
  }

  .thumb {
    width: 96px;
    height: 70px;
    border-radius: 7px;
    flex: none;
    background-size: cover;
    background-position: center;
  }

  .row-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 5px;
    min-width: 0;
  }

  .row-name {
    font-weight: 500;
    font-size: 17px;
    line-height: 1.2;
  }

  .row-rating {
    font-size: 11.5px;
    color: var(--accent);
  }

  .dim {
    color: var(--text-42);
  }

  .row-unrated {
    font-size: 11.5px;
    letter-spacing: 0.14em;
    color: var(--text-42);
  }

  .row-where {
    font-size: 13px;
    line-height: 1.3;
    color: var(--text-55);
  }

  .row-note {
    font-size: 13px;
    line-height: 1.5;
    color: var(--text-70);
    font-style: italic;
  }

  .view {
    font-weight: 500;
    font-size: 13px;
    color: var(--link);
    flex: none;
  }

  /* ---- owner controls ---- */
  .list-note {
    margin: 0;
    font-size: 14px;
  }

  .list-note.done {
    color: var(--ok);
  }

  .list-note.bad {
    color: #e05252;
  }

  .manage {
    border: 1px solid rgba(var(--ink-rgb), 0.18);
    border-radius: 11px;
    background: var(--surface);
    max-width: 560px;
  }

  .manage summary {
    cursor: pointer;
    padding: 12px 16px;
    font-weight: 600;
    font-size: 14.5px;
  }

  .manage-body {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 4px 16px 16px;
  }

  .manage-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .manage-sub {
    flex: 1 1 220px;
    margin: 0;
    font-size: 13.5px;
    color: var(--text-55);
  }

  .field {
    flex: 1 1 220px;
    min-width: 0;
    background: var(--surface-alt);
    border: 1px solid rgba(var(--ink-rgb), 0.22);
    border-radius: 8px;
    color: var(--text);
    font-family: inherit;
    font-size: 14.5px;
    padding: 9px 11px;
  }

  .btn {
    border: 1px solid rgba(var(--ink-rgb), 0.22);
    background: none;
    color: var(--text);
    border-radius: 8px;
    padding: 9px 14px;
    font-family: inherit;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
  }

  .btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .danger {
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--text-42);
  }

  .danger:hover {
    color: #e05252;
  }

  .remove-item {
    display: flex;
    justify-content: flex-end;
    margin-top: 6px;
  }

  .empty {
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 11px;
    padding: 30px;
  }

  .empty-lead {
    margin: 0;
    font-size: 19px;
    font-weight: 500;
  }

  .empty-sub {
    margin: 8px 0 0;
    font-size: 15px;
    color: var(--text-55);
  }

  @media (max-width: 767px) {
    .row {
      flex-wrap: wrap;
    }

    .thumb {
      width: 100%;
      height: 140px;
    }

    .view {
      width: 100%;
      text-align: right;
    }
  }
</style>
