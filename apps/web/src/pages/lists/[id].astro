---
import { fetchCategoryCounts, fetchListItems, fetchListMeta } from '@locastar/shared';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Base from '../../layouts/Base.astro';
import { categoryColor, ratingLabel } from '../../lib/format';
import { useTranslations, localePath } from '../../i18n/ui';
import { anonClient } from '../../lib/supabase';

/*
 * A frozen URL — public list share links from the app point here, so it has to
 * resolve for a stranger. RLS decides: a public list is readable by `anon`, a
 * private one is not, and the page 404s for it exactly as it should.
 */
export const prerender = false;

const { id } = Astro.params;
const supabase = anonClient();
const lang = Astro.locals.lang ?? 'en';
const t = useTranslations(lang);
const p = (href: string) => localePath(href, lang);

let meta;
try {
  meta = id ? await fetchListMeta(supabase, id) : null;
} catch (error) {
  console.error('Failed to load list', id, error);
  return new Response('Temporarily unavailable', { status: 503, headers: { 'Retry-After': '60' } });
}

if (!meta) return new Response(null, { status: 404 });

const [items, likes, categories] = await Promise.all([
  fetchListItems(supabase, id!).catch((error) => {
    console.error('Failed to load list items', id, error);
    return [];
  }),
  // fetchListMeta does not carry a like count and the design shows one.
  supabase
    .from('list_likes')
    .select('*', { count: 'exact', head: true })
    .eq('list_id', id!)
    .then((r) => r.count ?? 0)
    .catch(() => 0),
  // Item rows carry a category slug but not its name.
  fetchCategoryCounts(supabase).catch(() => []),
]);

const categoryName = new Map(categories.map((c) => [c.slug, c.name]));

const owner = meta.ownerUsername ?? meta.ownerDisplayName ?? 'someone on LocaStar';
const origin = Astro.site?.origin ?? Astro.url.origin;
const canonical = `${origin}/lists/${meta.id}`;

const title = `${meta.name} — ${t('list.byLine', { owner })} | LocaStar`;
const description =
  meta.description?.trim() ||
  `${items.length} ${items.length === 1 ? 'place' : 'places'} collected by ${owner} on LocaStar, with directions, photos and reviews from people who have been there.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: meta.name,
    numberOfItems: items.length,
    itemListElement: items.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.name,
      url: `${origin}/location/${item.locationId}`,
    })),
  },
];
---

<Base title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <SiteHeader current="community" />

  <main id="main">
    <header class="head">
      <div class="wrap head-inner">
        <span class="mono kicker">{meta.isPublic ? t('list.public') : t('list.private')}</span>
        <h1>{meta.name}</h1>
        {meta.description && <p class="blurb">{meta.description}</p>}
        <div class="byline">
          <span class="avatar" aria-hidden="true"></span>
          <span class="by">{t('community.by', { name: owner })}</span>
          <span class="rule"></span>
          <span class="mono stat">{items.length} {items.length === 1 ? t('list.place_one') : t('list.place_other')}</span>
          {
            meta.isPublic && (
              <>
                <span class="rule" />
                <span class="mono stat">{likes} {likes === 1 ? t('list.like_one') : t('list.like_other')}</span>
              </>
            )
          }
        </div>
      </div>
    </header>

    <div class="wrap body">
      {
        items.length === 0 ? (
          <div class="empty">
            <p class="empty-lead">{t('list.empty')}</p>
            <p class="empty-sub">{t('list.emptySub')}</p>
          </div>
        ) : (
          <ol class="rows">
            {items.map((item, index) => {
              const colour = categoryColor(item.categorySlug);
              const rating = ratingLabel(item.avgRating, item.reviewCount);
              const where = [item.categorySlug ? categoryName.get(item.categorySlug) : null, item.city, item.country]
                .filter(Boolean)
                .join(' · ');
              return (
                <li>
                  <a class="row" href={p(`/location/${item.locationId}`)} style={`border-color:${colour}`}>
                    <span class="mono num">{String(index + 1).padStart(2, '0')}</span>
                    {item.imageUrl ? (
                      <div class="thumb" style={`background-image:url("${item.imageUrl}")`} />
                    ) : (
                      <div class="thumb flat" style={`background:${colour}`} />
                    )}
                    <div class="row-body">
                      <span class="row-name">{item.name}</span>
                      {rating.rated ? (
                        <span class="mono row-rating">
                          ★ {rating.avg} <span class="dim">({rating.count})</span>
                        </span>
                      ) : (
                        <span class="mono row-unrated">{t('common.notRated')}</span>
                      )}
                      {where && <span class="row-where">{where}</span>}
                      {item.note && <span class="row-note">{item.note}</span>}
                    </div>
                    <span class="view">{t('list.view')}</span>
                  </a>
                </li>
              );
            })}
          </ol>
        )
      }
    </div>
  </main>

  <SiteFooter />
</Base>

<style>
  /* The blue family the app uses for lists, not the teal used everywhere else. */
  .head {
    background: var(--list-surface);
  }

  .head-inner {
    padding-block: 40px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .kicker {
    font-size: 10px;
    letter-spacing: 0.2em;
    color: rgba(244, 246, 245, 0.5);
  }

  h1 {
    font-size: clamp(30px, 5vw, 46px);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .blurb {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-70);
    max-width: 60ch;
  }

  .byline {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .avatar {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgba(244, 246, 245, 0.12);
    flex: none;
  }

  .by {
    font-size: 15px;
    color: rgba(244, 246, 245, 0.8);
  }

  .rule {
    width: 1px;
    height: 14px;
    background: rgba(244, 246, 245, 0.2);
  }

  .stat {
    font-size: 13px;
    letter-spacing: 0.1em;
    color: var(--text-55);
  }

  .body {
    padding-block: 30px 40px;
  }

  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .row {
    display: flex;
    gap: 16px;
    align-items: center;
    padding: 14px;
    background: var(--surface);
    border: 1px solid;
    border-radius: 11px;
    color: var(--text);
    transition: box-shadow 120ms ease-out;
  }

  .row:hover {
    color: var(--text);
    box-shadow: 0 0 0 3px rgba(232, 169, 59, 0.12);
  }

  .num {
    font-size: 13px;
    width: 20px;
    flex: none;
    color: var(--text-42);
  }

  .thumb {
    width: 96px;
    height: 70px;
    border-radius: 7px;
    flex: none;
    background-size: cover;
    background-position: center;
  }

  .row-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 5px;
    min-width: 0;
  }

  .row-name {
    font-weight: 500;
    font-size: 17px;
    line-height: 1.2;
  }

  .row-rating {
    font-size: 11.5px;
    color: var(--accent);
  }

  .dim {
    color: var(--text-42);
  }

  .row-unrated {
    font-size: 11.5px;
    letter-spacing: 0.14em;
    color: var(--text-42);
  }

  .row-where {
    font-size: 13px;
    line-height: 1.3;
    color: var(--text-55);
  }

  .row-note {
    font-size: 13px;
    line-height: 1.5;
    color: var(--text-70);
    font-style: italic;
  }

  .view {
    font-weight: 500;
    font-size: 13px;
    color: var(--link);
    flex: none;
  }

  .empty {
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 11px;
    padding: 30px;
  }

  .empty-lead {
    margin: 0;
    font-size: 19px;
    font-weight: 500;
  }

  .empty-sub {
    margin: 8px 0 0;
    font-size: 15px;
    color: var(--text-55);
  }

  @media (max-width: 767px) {
    .row {
      flex-wrap: wrap;
    }

    .thumb {
      width: 100%;
      height: 140px;
    }

    .view {
      width: 100%;
      text-align: right;
    }
  }
</style>
