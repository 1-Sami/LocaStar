---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Base from '../layouts/Base.astro';
import { aboutCopy } from '@locastar/shared';

import { useTranslations } from '../i18n/ui';
import { OSM_ATTRIBUTION, SUPPORT_EMAIL } from '../lib/site';

/*
 * The words are the app's own About copy, now in packages/shared so the app
 * screen and this page read the same source. It is not rewritten for the web,
 * because the story is the story — and the Swedish is the app's Swedish.
 */
export const prerender = false;

const origin = Astro.site?.origin ?? Astro.url.origin;
const lang = Astro.locals.lang ?? 'en';
const t = useTranslations(lang);
const about = aboutCopy(lang);

const title = `${about.ballTitle} — ${t('about.titleSuffix')}`;
const description = about.gap1;
---

<Base title={title} description={description} canonical={`${origin}/about`}>
  <SiteHeader current="about" />

  <main id="main" class="wrap">
    <article class="piece">
      <picture class="photo">
        <source srcset="/images/about/hero.webp" type="image/webp" />
        <img src="/images/about/hero.png" alt="" width="1800" height="560" loading="eager" fetchpriority="high" />
      </picture>

      <h1>{about.ballTitle}</h1>

      <p>{about.ball1}</p>
      <p>{about.ball2}</p>

      <p class="pull">{about.ball3}</p>

      <h2>{about.gapTitle}</h2>
      <p>{about.gap1}</p>
      <p>{about.gap2}</p>
      <p>{about.gap3}</p>
      <p>{about.gap4}</p>

      <h2>{about.growTitle}</h2>
      <p>{about.grow1}</p>
      <p>{about.grow2}</p>

      <h2>{about.supportTitle}</h2>
      <p>
        {about.supportPrefix}
        <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a>{about.supportSuffix}
      </p>

      <p class="credit">
        {about.attributionPrefix}
        <a href={OSM_ATTRIBUTION.href} rel="noopener noreferrer" target="_blank">{about.attributionLink}</a>
        {about.attributionSuffix}
      </p>
    </article>
  </main>

  <SiteFooter />
</Base>

<style>
  main {
    padding-block: 48px 72px;
  }

  /* An editorial long-read: one narrow column at a comfortable measure, not a
     marketing page with cards. */
  .piece {
    max-width: 760px;
  }

  /*
   * aspect-ratio, not a fixed height — same reasoning as the Features page
   * bands: the source illustration is 1800x560, and a flat height on a
   * fluid-width column meant the rendered box didn't match that ratio outside
   * one exact viewport width.
   */
  .photo {
    display: block;
    aspect-ratio: 1800 / 560;
    border-radius: 13px;
    overflow: hidden;
    margin-bottom: 34px;
    background: var(--surface);
  }

  .photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  h1 {
    font-size: clamp(32px, 5vw, 52px);
    line-height: 1.06;
    letter-spacing: -0.035em;
    margin-bottom: 24px;
  }

  h2 {
    font-size: 24px;
    line-height: 1.2;
    margin: 40px 0 16px;
  }

  p {
    font-size: 17.5px;
    line-height: 1.7;
    color: var(--text-70);
    margin: 0 0 16px;
  }

  .pull {
    font-size: 24px;
    line-height: 1.45;
    color: var(--text);
    border-left: 2px solid var(--accent);
    padding-left: 20px;
    margin: 30px 0;
  }

  .credit {
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid var(--hairline);
    font-size: 13px;
    color: var(--text-42);
  }
</style>
