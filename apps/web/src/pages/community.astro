---
import { fetchPublicLists } from '@locastar/shared';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Base from '../layouts/Base.astro';
import { useTranslations, localePath } from '../i18n/ui';
import { anonClient } from '../lib/supabase';

export const prerender = false;

const supabase = anonClient();
const lang = Astro.locals.lang ?? 'en';
const t = useTranslations(lang);
const p = (href: string) => localePath(href, lang);

const sortParam = Astro.url.searchParams.get('sort');
const sort = sortParam === 'most_liked' || sortParam === 'least_liked' ? sortParam : 'newest';

let lists;
try {
  lists = await fetchPublicLists(supabase, null, sort);
} catch (error) {
  console.error('Failed to load public lists', error);
  return new Response('Temporarily unavailable', { status: 503, headers: { 'Retry-After': '60' } });
}

const origin = Astro.site?.origin ?? Astro.url.origin;
const title = t('community.title');
const description =
  t('community.metaDesc');

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Shared lists',
    url: `${origin}/community`,
  },
];
---

<Base title={title} description={description} canonical={`${origin}/community`} jsonLd={jsonLd}>
  <SiteHeader current="community" />

  <main id="main" class="wrap">
    <header class="head">
      <h1>{t('community.heading')}</h1>
      <p class="lead">
        {t('community.lead')}
      </p>

      <label class="sort">
        <span class="mono sort-label">{t('common.sort')}</span>
        <select onchange="location.href = this.value" aria-label={t('community.sortLists')}>
          <option value={p('/community')} selected={sort === 'newest'}>{t('community.sortNewest')}</option>
          <option value={p('/community?sort=most_liked')} selected={sort === 'most_liked'}>{t('community.sortMostLiked')}</option>
          <option value={p('/community?sort=least_liked')} selected={sort === 'least_liked'}>{t('community.sortLeastLiked')}</option>
        </select>
      </label>
    </header>

    {
      lists.length === 0 ? (
        <div class="empty">
          <p class="empty-lead">{t('community.empty')}</p>
          <p class="empty-sub">
            {t('community.emptySub')}
          </p>
        </div>
      ) : (
        <div class="grid">
          {lists.map((list) => {
            const previews = list.previewLocations.slice(0, 3);
            return (
              <a class="card" href={p(`/lists/${list.id}`)}>
                <span class="name">{list.name}</span>
                <span class="by">{t('community.by', { name: list.ownerUsername ?? list.ownerDisplayName ?? t('community.someone') })}</span>
                {list.description && <span class="blurb">{list.description}</span>}
                <div class="mosaic">
                  <div
                    class="m-main"
                    style={previews[0]?.imageUrl ? `background-image:url("${previews[0].imageUrl}")` : ''}
                  />
                  <div class="m-side">
                    <div
                      class="m-tile"
                      style={previews[1]?.imageUrl ? `background-image:url("${previews[1].imageUrl}")` : ''}
                    />
                    <div
                      class="m-tile"
                      style={previews[2]?.imageUrl ? `background-image:url("${previews[2].imageUrl}")` : ''}
                    />
                  </div>
                </div>
                <span class="mono count">
                  {list.itemCount} {list.itemCount === 1 ? 'PLACE' : 'PLACES'} · {list.likeCount}{' '}
                  {list.likeCount === 1 ? 'LIKE' : 'LIKES'}
                </span>
              </a>
            );
          })}
        </div>
      )
    }
  </main>

  <SiteFooter />
</Base>

<style>
  main {
    padding-block: 48px 72px;
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 32px;
  }

  h1 {
    font-size: clamp(32px, 5vw, 52px);
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .lead {
    margin: 0;
    font-size: 18px;
    line-height: 1.6;
    color: var(--text-70);
    max-width: 58ch;
  }

  .sort {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 4px;
  }

  .sort-label {
    font-size: 10px;
    letter-spacing: 0.16em;
    color: var(--text-42);
  }

  .sort select {
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 7px;
    color: var(--text);
    font-family: var(--font-display);
    font-size: 13px;
    padding: 7px 10px;
  }

  .sort select option {
    background: var(--surface);
    color: var(--text);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .card {
    background: var(--list-surface);
    border: 1px solid rgba(76, 143, 232, 0.3);
    border-radius: 11px;
    padding: 18px;
    display: flex;
    flex-direction: column;
    color: var(--text);
    transition: box-shadow 120ms ease-out;
  }

  .card:hover {
    color: var(--text);
    box-shadow: 0 0 0 3px rgba(232, 169, 59, 0.12);
  }

  .name {
    font-weight: 500;
    font-size: 17px;
    line-height: 1.25;
  }

  .by {
    font-size: 13px;
    line-height: 1;
    color: var(--text-55);
    margin: 6px 0 0;
  }

  .blurb {
    font-size: 13px;
    line-height: 1.5;
    color: var(--text-55);
    margin-top: 8px;
  }

  .mosaic {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 5px;
    height: 110px;
    margin-top: 14px;
  }

  .m-side {
    display: grid;
    grid-template-rows: 1fr 1fr;
    gap: 5px;
  }

  .m-main,
  .m-tile {
    border-radius: 6px;
    background-color: rgba(244, 246, 245, 0.06);
    background-size: cover;
    background-position: center;
  }

  .count {
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--text-55);
    margin-top: 12px;
  }

  .empty {
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 11px;
    padding: 30px;
  }

  .empty-lead {
    margin: 0;
    font-size: 19px;
    font-weight: 500;
  }

  .empty-sub {
    margin: 8px 0 0;
    font-size: 15px;
    color: var(--text-55);
    max-width: 52ch;
  }

  @media (max-width: 1279px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 767px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
