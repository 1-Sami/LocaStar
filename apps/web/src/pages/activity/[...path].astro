---
import {
  CATEGORY_PAGE_SIZE,
  CITY_PAGE_MIN_PLACES,
  categoryName,
  citySlug,
  fetchAllCategories,
  fetchCategoryBySlug,
  fetchCategoryCityCounts,
  fetchCategoryPlaces,
  fetchCategoryCounts,
} from '@locastar/shared';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Base from '../../layouts/Base.astro';
import { useTranslations, localePath } from '../../i18n/ui';
import { categoryColor, coverStyle, ratingLabel } from '../../lib/format';
import { anonClient } from '../../lib/supabase';

export const prerender = false;

/*
 * One file for two kinds of page: /activity/<category> and, since 2026-09-10,
 * /activity/<category>/<town>. A rest parameter rather than a second route
 * file, so the two cannot drift apart — a town page is this page with one more
 * filter, not a copy of it.
 */
const segments = (Astro.params.path ?? '').split('/').filter(Boolean);
if (segments.length === 0 || segments.length > 2) return new Response(null, { status: 404 });
const [slug, townSegment] = segments;
const supabase = anonClient();
const lang = Astro.locals.lang ?? 'en';
const t = useTranslations(lang);
const p = (href: string) => localePath(href, lang);

let category;
try {
  category = slug ? await fetchCategoryBySlug(supabase, slug) : null;
} catch (error) {
  // Same reasoning as the location page: a blip must not read as "gone".
  console.error('Failed to load category', slug, error);
  return new Response('Temporarily unavailable', {
    status: 503,
    headers: { 'Retry-After': '60' },
  });
}

if (!category || !slug) return new Response(null, { status: 404 });

/*
 * A town, two ways.
 *
 * /activity/basketball/huddinge is a real page: indexable, its own canonical,
 * in the sitemap. It exists only where the town has at least
 * CITY_PAGE_MIN_PLACES places. Towns were deliberately not pages at first — the
 * worry was 54 categories times hundreds of towns, thousands of near-empty
 * pages competing for the same words. What changed it was the owner searching
 * "basketplan huddinge" and finding nothing, because nothing on the site was
 * *about* basketball in Huddinge. The threshold keeps the original worry
 * answered: 297 pages, not 3,500.
 *
 * ?city=Huddinge is the older filter. It still serves towns too small for a
 * page, and robots.txt keeps it out of search. For a town that has a page it
 * now redirects there, so an old link lands on the version Google can see.
 */
const cityParam = Astro.url.searchParams.get('city')?.trim() || undefined;

/*
 * Pagination, because without it this page was a dead end for the crawler.
 *
 * It listed 24 places and said "showing 24 of 1,202" with no way to reach the
 * rest — a defect for a reader and a much larger one for Google. Measured on
 * 2026-09-09: only 1,081 of 8,294 place pages were reachable within two links
 * of the home page, so 7,213 of them existed in the sitemap and nowhere else.
 * That is what "Discovered — currently not indexed" means. A URL Google knows
 * only from a sitemap, with nothing linking to it, is a page the site itself
 * is saying does not matter.
 *
 * 48 rather than 24 halves the number of pages, and the pager lists every one
 * of them, so the deepest place sits three links from the home page instead of
 * fifty-one.
 */
const PAGE_SIZE = CATEGORY_PAGE_SIZE;
const rawPage = Astro.url.searchParams.get('page');
const page = rawPage === null ? 1 : Number(rawPage);
// A bad page number is a 404, not page 1. Otherwise ?page=abc and ?page=99999
// are infinite crawlable copies of the first page.
if (!Number.isInteger(page) || page < 1) return new Response(null, { status: 404 });

/*
 * A town page has to turn its slug back into the town's real name before it can
 * ask for that town's places, so it fetches the town list first. Every other
 * page fetches it alongside the rest, as before.
 */
let town: { city: string; count: number } | undefined;
let prefetchedTowns: Awaited<ReturnType<typeof fetchCategoryCityCounts>> | undefined;
if (townSegment) {
  try {
    prefetchedTowns = await fetchCategoryCityCounts(supabase, slug);
  } catch (error) {
    // Not a 404: a blip must not tell Google the page is gone.
    console.error('Failed to load towns', slug, error);
    return new Response('Temporarily unavailable', {
      status: 503,
      headers: { 'Retry-After': '60' },
    });
  }
  let decoded = townSegment;
  try {
    decoded = decodeURIComponent(townSegment);
  } catch {
    // A malformed escape is simply a town that does not exist.
  }
  const wanted = citySlug(decoded);
  town = prefetchedTowns.find((row) => citySlug(row.city) === wanted);
  if (!town || town.count < CITY_PAGE_MIN_PLACES) return new Response(null, { status: 404 });
  // /activity/basketball/Göteborg and /goteborg both reach the page, but only
  // one spelling may be its address.
  if (townSegment !== citySlug(town.city)) {
    return Astro.redirect(p(`/activity/${slug}/${citySlug(town.city)}${Astro.url.search}`), 301);
  }
}
const city = town?.city ?? cityParam;

const [cityCounts, listing, allCategories, counts] = await Promise.all([
  prefetchedTowns ?? fetchCategoryCityCounts(supabase, slug).catch(() => []),
  fetchCategoryPlaces(supabase, category.id, {
    city,
    limit: PAGE_SIZE,
    offset: (page - 1) * PAGE_SIZE,
  }).catch(() => ({
    places: [],
    total: 0,
  })),
  fetchAllCategories(supabase).catch(() => []),
  fetchCategoryCounts(supabase).catch(() => []),
]);

// The old filter URL, for a town that now has a page of its own.
if (cityParam && !townSegment) {
  const match = cityCounts.find((row) => row.city === cityParam);
  if (match && match.count >= CITY_PAGE_MIN_PLACES) {
    return Astro.redirect(p(`/activity/${slug}/${citySlug(match.city)}`), 301);
  }
}

const publicUrl = (path: string | null) =>
  path ? supabase.storage.from('media').getPublicUrl(path).data.publicUrl : null;

const colour = categoryColor(slug);
/*
 * The category's name in the reader's language. The row's own name column is
 * English — it is what the app seeds from — so the shared table is what makes
 * a Swedish page say Utegym rather than Outdoor gym.
 */
const catName = categoryName(slug, lang) ?? category.name;
const catLower = catName.toLowerCase();
/*
 * The category total comes from the count function, not from adding up the
 * city facets: 16 places have no city at all, so summing the facets quietly
 * loses them. The same class of mistake as summing category counts for a
 * location total — both read as a number that is simply wrong.
 */
const total = counts.find((row) => row.slug === slug)?.count ?? listing.total;
const shownTotal = city ? listing.total : total;

const topCities = cityCounts.slice(0, 6);
const remainingCities = Math.max(0, cityCounts.length - topCities.length);
// Alphabetical: this list is for finding your own town, not for ranking them.
const townList = cityCounts
  .filter((row) => row.count >= CITY_PAGE_MIN_PLACES)
  .sort((a, b) => a.city.localeCompare(b.city, 'sv'));

/*
 * Related activities: other categories, excluding this one.
 *
 * Deliberately not "random" — a stable slice keeps the internal link graph
 * stable between crawls, which is what the links are for.
 */
const related = allCategories.filter((c) => c.slug !== slug).slice(0, 10);

const where = city ?? t('activity.inSweden');
const heading = t('activity.headingIn', { name: catName, where });
const title = `${heading} — ${t('activity.titleSuffix', { count: shownTotal })} | LocaStar`;

/*
 * A description built from what is actually on the page.
 *
 * Not a template sentence with the name dropped in — those get discarded, and
 * they tell a reader nothing the title did not. The counts are real, so this
 * changes as the map grows.
 */
const cityBit =
  !city && cityCounts.length > 1
    ? t('activity.leadCities', { count: cityCounts.length, first: topCities[0].city })
    : '';
const description =
  t('activity.metaLead', { count: shownTotal, name: catName, where }) + cityBit + t('activity.leadTail');
// The same sentence without the name and town, which the h1 directly above it
// has already said.
const pageLead = t('activity.lead', { count: shownTotal }) + cityBit + t('activity.leadTail');

const pageCount = Math.max(1, Math.ceil(listing.total / PAGE_SIZE));
// Past the end is a 404 too — page 1 of an empty category is still a real page,
// but page 9 of a three-page category is not.
if (page > 1 && page > pageCount) return new Response(null, { status: 404 });

const origin = Astro.site?.origin ?? Astro.url.origin;
/*
 * Page 2 canonicalises to itself, never back to page 1 — pointing it at page 1
 * would tell Google to drop exactly the pages that exist to be found.
 *
 * The ?city= filter still canonicalises to the unfiltered page — it is
 * robots-disallowed and only survives for towns too small for a page. A town
 * page is its own canonical, page by page, exactly like the category.
 */
const pageSuffix = page > 1 ? `?page=${page}` : '';
const listPath = town ? `/activity/${slug}/${citySlug(town.city)}` : `/activity/${slug}`;
const canonical =
  !town && cityParam ? `${origin}/activity/${slug}` : `${origin}${listPath}${pageSuffix}`;

const pageHref = (n: number) => p(n > 1 ? `${listPath}?page=${n}` : listPath);
const townHref = (name: string) => p(`/activity/${slug}/${citySlug(name)}`);

const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'LocaStar', item: `${origin}/` },
      { '@type': 'ListItem', position: 2, name: catName, item: `${origin}/activity/${slug}` },
      ...(town ? [{ '@type': 'ListItem', position: 3, name: town.city, item: `${origin}${listPath}` }] : []),
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: heading,
    numberOfItems: listing.places.length,
    itemListElement: listing.places.map((place, index) => ({
      '@type': 'ListItem',
      // Continues across pages, so page 2 starts at 49 rather than at 1 again.
      position: (page - 1) * PAGE_SIZE + index + 1,
      name: place.name,
      url: `${origin}/location/${place.id}`,
    })),
  },
];

/*
 * FAQ answers are written from what the data can support, not invented.
 * FAQPage structured data is only emitted because these answers are genuinely
 * on the page — Google treats markup that is not visible as a violation.
 */
const faqs = [
  { q: t('activity.faq1q', { name: catName }), a: t('activity.faq1a') },
  { q: t('activity.faq2q'), a: t('activity.faq2a') },
  { q: t('activity.faq3q'), a: t('activity.faq3a') },
];

jsonLd.push({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
});
---

<Base
  title={page > 1 ? t('activity.titlePaged', { title, page }) : title}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
  altSearch={!town && cityParam ? '' : pageSuffix}
>
  <SiteHeader current="categories" />

  <main id="main">
    <div class="colour-bar" style={`background:${colour}`}></div>

    <div class="wrap intro">
      <nav class="mono crumbs" aria-label="Breadcrumb">
        <a href={p('/')}>LocaStar</a>
        <span aria-hidden="true">/</span>
        {town ? (
          <>
            <a href={p(`/activity/${slug}`)}>{catName}</a>
            <span aria-hidden="true">/</span>
            <span class="here">{town.city}</span>
          </>
        ) : (
          <span class="here">{catName}</span>
        )}
      </nav>

      <h1>{heading}</h1>

      <p class="lead">
        {shownTotal === 0
          ? t('activity.emptyLead', { name: catLower, where })
          : pageLead}
      </p>

      {
        cityCounts.length > 0 && (
          <div class="chips">
            <a
              class={`chip${city ? '' : ' on'}`}
              href={p(`/activity/${slug}`)}
              style={city ? '' : `background:${colour};border-color:${colour}`}
            >
              {t('activity.all', { count: total })}
            </a>
            {topCities.map((row) => (
              <a
                class={`chip${city === row.city ? ' on' : ''}`}
                href={
                  row.count >= CITY_PAGE_MIN_PLACES
                    ? townHref(row.city)
                    : p(`/activity/${slug}?city=${encodeURIComponent(row.city)}`)
                }
                style={city === row.city ? `background:${colour};border-color:${colour}` : ''}
              >
                {row.city} {row.count}
              </a>
            ))}
            {remainingCities > 0 && <span class="chip muted">{t('activity.moreCities', { count: remainingCities })}</span>}
          </div>
        )
      }
    </div>

    <section class="wrap listing">
      <div class="listing-head">
        <h2>{city ? t('activity.inCity', { city }) : t('activity.whereBeen')}</h2>
        {listing.total > listing.places.length && (
          <span class="mono soft">{t('activity.showing', { shown: listing.places.length, total: listing.total })}</span>
        )}
      </div>

      {
        listing.places.length === 0 ? (
          <div class="empty">
            <p class="empty-lead">{t('activity.nothingYet')}</p>
            <p class="sub">
              {t('activity.nothingSub', { name: catLower })}
            </p>
          </div>
        ) : (
          <div class="grid">
            {listing.places.map((place) => {
              const rating = ratingLabel(place.avgRating, place.reviewCount);
              const cover = coverStyle(publicUrl(place.coverPhotoPath), slug);
              return (
                <a class="card" href={p(`/location/${place.id}`)} style={`border-color:${colour}`}>
                  {cover ? (
                    <div class="card-photo" style={cover} />
                  ) : (
                    <div class="card-photo flat" style={`background:${colour}`}>
                      <span class="mono">{catName}</span>
                    </div>
                  )}
                  <div class="card-body">
                    <span class="card-name">{place.name}</span>
                    {rating.rated ? (
                      <span class="mono card-rating">
                        ★ {rating.avg} <span class="dim">({rating.count})</span>
                      </span>
                    ) : (
                      <span class="mono card-unrated">{t('common.notRated')}</span>
                    )}
                    {(place.address || place.city) && (
                      <span class="card-where">{[place.address, place.city].filter(Boolean).join(' · ')}</span>
                    )}
                  </div>
                </a>
              );
            })}
          </div>
        )
      }

      {/*
        Every page number, not a next link.

        A next-only pager puts page 40 forty clicks from page 1, and a crawler
        weighs a page by how far it has to walk to reach it. Listing them all
        puts the last place in the category three links from the home page.
        The largest category is 1,202 places, so 26 numbers at this page size.
      */}
      {pageCount > 1 && (
        <nav class="pager" aria-label={t('activity.pagerLabel')}>
          {page > 1 && (
            <a class="pager-step" href={pageHref(page - 1)} rel="prev">{t('activity.prev')}</a>
          )}
          <ol class="pager-nums">
            {Array.from({ length: pageCount }, (_, i) => i + 1).map((n) => (
              <li>
                {n === page ? (
                  <span class="pager-num on" aria-current="page">{n}</span>
                ) : (
                  <a class="pager-num" href={pageHref(n)}>{n}</a>
                )}
              </li>
            ))}
          </ol>
          {page < pageCount && (
            <a class="pager-step" href={pageHref(page + 1)} rel="next">{t('activity.next')}</a>
          )}
        </nav>
      )}
    </section>

    <section class="wrap one-col">
      <div class="faq">
        <h2>{t('activity.questions')}</h2>
        {
          faqs.map((faq) => (
            <details class="faq-item">
              <summary>{faq.q}</summary>
              <p>{faq.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    {/*
      Every town that has a page, so that every town page is linked from
      somewhere. The chips at the top show only the six biggest; without this
      list the rest would be reachable from the sitemap alone — the orphaned
      page problem the pagination was built to fix.
    */}
    {
      townList.length > 0 && (
        <section class="wrap related towns">
          <h2>{t('activity.byTown', { name: catName })}</h2>
          <div class="chips">
            {townList.map((row) => (
              <a
                class={`chip${city === row.city ? ' on' : ''}`}
                href={townHref(row.city)}
                style={
                  city === row.city ? `background:${colour};border-color:${colour}` : `border-color:${colour}`
                }
              >
                {row.city} {row.count}
              </a>
            ))}
          </div>
        </section>
      )
    }

    {
      related.length > 0 && (
        <section class="wrap related">
          <h2>{t('activity.other')}</h2>
          <div class="chips">
            {related.map((other) => (
              <a class="chip" href={p(`/activity/${other.slug}`)} style={`border-color:${categoryColor(other.slug)}`}>
                {categoryName(other.slug, lang) ?? other.name}
              </a>
            ))}
          </div>
        </section>
      )
    }
  </main>

  <SiteFooter />
</Base>

<style>
  .colour-bar {
    height: 8px;
  }

  .intro {
    padding-top: 56px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .crumbs {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 12px;
    letter-spacing: 0.1em;
    color: var(--text-42);
  }

  .crumbs .here {
    color: var(--accent);
  }

  h1 {
    font-size: clamp(36px, 6vw, 68px);
    line-height: 1.02;
    letter-spacing: -0.038em;
  }

  .lead {
    font-size: 20px;
    line-height: 1.6;
    color: var(--text-70);
    margin: 0;
    max-width: 640px;
    text-wrap: pretty;
  }

  .chips {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .chip {
    font-weight: 500;
    font-size: 13px;
    padding: 11px 16px;
    border-radius: 22px;
    border: 1px solid rgba(var(--ink-rgb), 0.2);
    color: var(--text-70);
    transition: border-color 120ms ease-out;
  }

  .chip:hover {
    color: var(--text);
  }

  .chip.on {
    color: #fff;
  }

  .chip.muted {
    color: var(--text-42);
  }

  .pager {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 36px;
  }

  /*
   * display: contents, so the numbered items join the pager's own flex row
   * instead of forming a block of their own. With 26 pages the list was wide
   * enough to fill a line by itself, which pushed Previous above the numbers
   * and Next below them. The list element stays for its semantics.
   */
  .pager-nums {
    display: contents;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .pager-nums li {
    display: flex;
  }

  .pager-num,
  .pager-step {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 38px;
    height: 38px;
    padding-inline: 10px;
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 14px;
    font-variant-numeric: tabular-nums;
    color: var(--text);
    text-decoration: none;
  }

  .pager-num:hover,
  .pager-step:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* The current page is not a link, so it carries the weight instead. */
  .pager-num.on {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--page);
    font-weight: 600;
  }

  .listing {
    padding-top: 56px;
  }

  .listing-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 20px;
    gap: 16px;
  }

  .listing-head h2 {
    font-size: 26px;
  }

  .soft {
    font-size: 12px;
    color: var(--text-42);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .card {
    border: 1px solid;
    border-radius: 11px;
    overflow: hidden;
    background: var(--surface);
    color: var(--text);
    display: flex;
    flex-direction: column;
    transition: box-shadow 120ms ease-out;
  }

  .card:hover {
    color: var(--text);
    box-shadow: 0 0 0 3px rgba(232, 169, 59, 0.12);
  }

  .card-photo {
    height: 140px;
    background-size: cover;
    background-position: center;
  }

  /* The normal case: 985 of 996 places have no photo. */
  .card-photo.flat {
    display: flex;
    align-items: flex-end;
    padding: 12px;
  }

  .card-photo.flat .mono {
    font-size: 10px;
    letter-spacing: 0.14em;
    color: rgba(255, 255, 255, 0.85);
  }

  .card-body {
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .card-name {
    font-weight: 500;
    font-size: 16px;
    line-height: 1.2;
  }

  .card-rating {
    font-size: 11.5px;
    letter-spacing: 0.06em;
    color: var(--accent);
  }

  .dim {
    color: var(--text-42);
  }

  .card-unrated {
    font-size: 11.5px;
    letter-spacing: 0.14em;
    color: var(--text-42);
  }

  .card-where {
    font-size: 13px;
    line-height: 1.35;
    color: var(--text-55);
  }

  .empty {
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 11px;
    padding: 26px;
  }

  .empty-lead {
    margin: 0;
    font-size: 17px;
  }

  .sub {
    font-size: 13px;
    color: var(--text-55);
    margin: 6px 0 0;
  }

  .one-col {
    padding-top: 52px;
    max-width: 720px;
  }

  .faq h2 {
    font-size: 24px;
    line-height: 1.15;
    margin-bottom: 16px;
  }

  .prose p {
    font-size: 16px;
    line-height: 1.7;
    color: var(--text-70);
    margin: 0 0 14px;
    max-width: 62ch;
  }

  .add-link {
    font-weight: 500;
    font-size: 14px;
  }

  .faq-item {
    border-top: 1px solid var(--hairline);
    padding: 15px 0;
  }

  .faq-item summary {
    font-size: 16px;
    line-height: 1.3;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary::after {
    content: '+';
    font-family: var(--font-mono);
    color: var(--text-42);
  }

  .faq-item[open] summary::after {
    content: '−';
  }

  .faq-item p {
    font-size: 15px;
    line-height: 1.65;
    color: var(--text-70);
    margin: 10px 0 0;
  }

  .related {
    padding-block: 52px 64px;
  }

  /* Sits directly above "Other things to do", which brings its own spacing. */
  .related.towns {
    padding-bottom: 0;
  }

  .related h2 {
    font-size: 24px;
