---
import {
  fetchLists,
  fetchMyAddedLocations,
  fetchMyReviews,
  fetchMyShares,
  fetchProfile,
  fetchProfileStats,
  fetchSavedLists,
  fetchSavedLocations,
  isModeratorRole,
} from '@locastar/shared';
import ListCard from '../../components/ListCard.astro';
import PlaceRow from '../../components/PlaceRow.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Base from '../../layouts/Base.astro';
import { useTranslations, localePath } from '../../i18n/ui';
import { longDate } from '../../lib/format';
import { currentUser } from '../../lib/auth';

export const prerender = false;
const lang = Astro.locals.lang ?? 'en';
const t = useTranslations(lang);
const p = (href: string) => localePath(href, lang);

const { user, supabase } = await currentUser(Astro.cookies, Astro.request.headers);
if (!user) return Astro.redirect(p('/auth/sign-in'));

const section = Astro.url.searchParams.get('show') ?? 'saved';
const listError = Astro.url.searchParams.get('listError');
const created = Astro.url.searchParams.get('created');

/*
 * Everything is fetched with the visitor's own session, so RLS returns their
 * rows and nobody else's — the same authorisation the app relies on, not a
 * check written again here.
 *
 * Favourites, bookmarks and shares are kept apart rather than merged, because
 * the app keeps them apart and they mean different things: a favourite is
 * somewhere you rate, a bookmark is somewhere you intend to go, and a share is
 * somewhere another person sent you.
 */
const [profile, stats, favourites, bookmarks, shares, lists, savedLists, reviews, added] = await Promise.all([
  fetchProfile(supabase, user.id).catch(() => null),
  fetchProfileStats(supabase, user.id).catch(() => null),
  fetchSavedLocations(supabase, user.id, 'favorite').catch(() => []),
  fetchSavedLocations(supabase, user.id, 'bucket_list').catch(() => []),
  fetchMyShares(supabase, user.id).catch(() => []),
  fetchLists(supabase, user.id).catch(() => []),
  fetchSavedLists(supabase, user.id).catch(() => []),
  fetchMyReviews(supabase, user.id).catch(() => []),
  fetchMyAddedLocations(supabase, user.id).catch(() => []),
]);

const name = profile?.username ?? profile?.display_name ?? user.email ?? 'You';
const isModerator = isModeratorRole(profile?.role ?? 'user');

const publicUrl = (path: string | null) =>
  path ? supabase.storage.from('media').getPublicUrl(path).data.publicUrl : null;

const NAV = [
  { key: 'saved', label: t('acct.saved'), count: favourites.length + bookmarks.length + shares.length },
  { key: 'lists', label: t('acct.myLists'), count: lists.length + savedLists.length },
  { key: 'added', label: t('acct.addedByMe'), count: added.length },
  { key: 'reviews', label: t('acct.myReviews'), count: reviews.length },
] as const;

const origin = Astro.site?.origin ?? Astro.url.origin;
---

<Base
  title={t('acct.title')}
  description={t('acct.metaDesc')}
  canonical={`${origin}/account`}
>
  <SiteHeader />

  <main id="main" class="wrap layout">
    <aside class="side">
      <div class="who">
        <span class="avatar" aria-hidden="true"></span>
        <div class="who-text">
          <span class="name">{name}</span>
          {
            stats && (
              <span class="mono contributions">
                {stats.contributions} {stats.contributions === 1 ? t('acct.contribution_one') : t('acct.contribution_other')}
              </span>
            )
          }
        </div>
      </div>

      <nav class="side-nav" aria-label={t('acct.navLabel')}>
        {
          NAV.map((item) => (
            <a class={`side-link${section === item.key ? ' on' : ''}`} href={p(`/account?show=${item.key}`)}>
              <span>{item.label}</span>
              <span class="mono side-count">{item.count}</span>
            </a>
          ))
        }
      </nav>

      <form method="post" action={p('/auth/sign-out')}>
        <button class="signout" type="submit">{t('acct.logOut')}</button>
      </form>

      {/*
        A red box rather than a quiet link, matching the app. This is the one
        control here that destroys something, and it should not look like a
        setting.
      */}
      <div class="danger">
        <span class="mono danger-head">{t('acct.deleteHead')}</span>
        <p>{t('acct.deleteSub')}</p>
        <a class="danger-link" href={p('/account/delete')}>{t('acct.deleteLink')}</a>
      </div>
    </aside>

    <section class="body">
      {
        isModerator && (
          <div class="mod-note">
            <span class="mono mod-kicker">{t('acct.moderator')}</span>
            <p>{t('acct.moderatorNote')}</p>
          </div>
        )
      }

      {
        section === 'saved' && (
          <>
            <h1>{t('acct.saved')}</h1>

            <section class="group">
              <div class="group-head">
                <h2>{t('acct.favourites')}</h2>
                <span class="mono group-count">{favourites.length}</span>
              </div>
              {favourites.length === 0 ? (
                <p class="empty-line">{t('acct.favouritesEmpty')}</p>
              ) : (
                <div class="rows">
                  {favourites.map((place) => (
                    <PlaceRow
                      href={`/location/${place.id}`}
                      name={place.name}
                      categorySlug={place.category_slug}
                      avgRating={place.avg_rating}
                      reviewCount={place.review_count}
                      where={place.city}
                      imageUrl={publicUrl(place.cover_photo_path)}
                    />
                  ))}
                </div>
              )}
            </section>

            <section class="group">
              <div class="group-head">
                <h2>{t('acct.bookmarks')}</h2>
                <span class="mono group-count">{bookmarks.length}</span>
              </div>
              {bookmarks.length === 0 ? (
                <p class="empty-line">{t('acct.bookmarksEmpty')}</p>
              ) : (
                <div class="rows">
                  {bookmarks.map((place) => (
                    <PlaceRow
                      href={`/location/${place.id}`}
                      name={place.name}
                      categorySlug={place.category_slug}
                      avgRating={place.avg_rating}
                      reviewCount={place.review_count}
                      where={place.city}
                      imageUrl={publicUrl(place.cover_photo_path)}
                    />
                  ))}
                </div>
              )}
            </section>

            <section class="group">
              <div class="group-head">
                <h2>{t('acct.shared')}</h2>
                <span class="mono group-count">{shares.length}</span>
              </div>
              {shares.length === 0 ? (
                <p class="empty-line">{t('acct.sharedEmpty')}</p>
              ) : (
                <div class="rows">
                  {shares.map((share) => (
                    <PlaceRow
                      href={`/location/${share.id}`}
                      name={share.name}
                      categorySlug={share.category_slug}
                      avgRating={share.avg_rating}
                      reviewCount={share.review_count}
                      where={share.city}
                      imageUrl={publicUrl(share.cover_photo_path)}
                      aside={share.direction === 'sent' ? 'SENT' : 'RECEIVED'}
                    />
                  ))}
                </div>
              )}
            </section>
          </>
        )
      }

      {
        section === 'lists' && (
          <>
            <h1>{t('acct.myLists')}</h1>

            {created && <p class="ok-line">{t('acct.listCreated')}</p>}
            {listError === 'name' && <p class="err-line">{t('acct.listNeedsName')}</p>}
            {listError === '1' && <p class="err-line">{t('acct.listFailed')}</p>}

            <form method="post" action="/api/list" class="new-list">
              <input type="hidden" name="back" value={p('/account')} />
              <input name="name" placeholder={t('acct.nameNewList')} aria-label={t('acct.listName')} required />
              <input name="description" placeholder={t('acct.listPurpose')} aria-label={t('acct.description')} />
              <label class="public-toggle">
                <input type="checkbox" name="isPublic" value="1" />
                <span>{t('acct.public')}</span>
              </label>
              <button type="submit">{t('acct.createList')}</button>
            </form>
            <p class="fine">{t('acct.listFine')}</p>

            {lists.length === 0 ? (
              <p class="empty-line">{t('acct.noLists')}</p>
            ) : (
              <div class="cards">
                {lists.map((list) => (
                  <ListCard
                    href={p(`/lists/${list.id}`)}
                    name={list.name}
                    itemCount={list.itemCount}
                    previews={list.previewLocations.slice(0, 3).map((p) => p.imageUrl)}
                    note={list.isPublic ? 'PUBLIC' : 'PRIVATE'}
                  />
                ))}
              </div>
            )}

            {savedLists.length > 0 && (
              <section class="group">
                <div class="group-head">
                  <h2>{t('acct.savedLists')}</h2>
                  <span class="mono group-count">{savedLists.length}</span>
                </div>
                <div class="cards">
                  {savedLists.map((list) => (
                    <ListCard
                      href={p(`/lists/${list.id}`)}
                      name={list.name}
                      by={list.ownerUsername ?? list.ownerDisplayName}
                      itemCount={list.itemCount}
                      previews={list.previewLocations.slice(0, 3).map((p) => p.imageUrl)}
                    />
                  ))}
                </div>
              </section>
            )}
          </>
        )
      }

      {
        section === 'added' && (
          <>
            <h1>{t('acct.addedByMe')}</h1>
            {added.length === 0 ? (
              <div class="empty">
                <p class="empty-lead">{t('acct.noneAdded')}</p>
                <p class="empty-sub">{t('acct.noneAddedSub')}</p>
                <a class="ghost" href={p('/add')}>{t('add.heading')}</a>
              </div>
            ) : (
              <div class="rows">
                {added.map((place) => (
                  <PlaceRow
                    href={`/location/${place.id}`}
                    name={place.name}
                    categoryName={place.category_label}
                    avgRating={place.avg_rating}
                    reviewCount={place.review_count}
                    aside={place.kind === 'activity' ? 'ACTIVITY' : longDate(place.created_at)}
                  />
                ))}
              </div>
            )}
          </>
        )
      }

      {
        section === 'reviews' && (
          <>
            <h1>{t('acct.myReviews')}</h1>
            {reviews.length === 0 ? (
              <div class="empty">
                <p class="empty-lead">{t('acct.noReviews')}</p>
                <p class="empty-sub">{t('acct.noReviewsSub')}</p>
              </div>
            ) : (
              <div class="rows">
                {reviews.map((review) => (
                  <a class="review" href={p(`/location/${review.location_id}`)}>
                    <span class="review-place">{review.location_name}</span>
                    <span class="mono review-stars">
                      {'★'.repeat(review.rating)}
                      {'☆'.repeat(5 - review.rating)}
                    </span>
                    {review.title && <strong class="review-title">{review.title}</strong>}
                    {review.body && <p class="review-body">{review.body}</p>}
                  </a>
                ))}
              </div>
            )}
          </>
        )
      }
    </section>
  </main>

  <SiteFooter />
</Base>

<style>
  .layout {
    display: grid;
    grid-template-columns: 250px 1fr;
    gap: 40px;
    padding-block: 40px 72px;
  }

  .side {
    display: flex;
    flex-direction: column;
    gap: 22px;
    align-self: start;
    position: sticky;
    top: 24px;
  }

  .who {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--surface-alt);
    flex: none;
  }

  .who-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .who .name {
    font-weight: 500;
    font-size: 16px;
  }

  .contributions {
    font-size: 10px;
    letter-spacing: 0.14em;
    color: var(--accent);
  }

  .side-nav {
    display: flex;
    flex-direction: column;
  }

  .side-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 11px 0;
    font-size: 15px;
    color: var(--text-70);
    border-bottom: 1px solid var(--hairline);
  }

  .side-link.on {
    color: var(--accent);
  }

  .side-count {
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--text-42);
  }

  .signout {
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 11px 18px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 14px;
    color: var(--text);
    cursor: pointer;
    width: 100%;
  }

  .signout:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .danger {
    border: 1px solid rgba(224, 82, 82, 0.45);
    background: rgba(224, 82, 82, 0.08);
    border-radius: 10px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: flex-start;
  }

  .danger-head {
    font-size: 10px;
    letter-spacing: 0.16em;
    color: #f0a9a9;
  }

  .danger p {
    margin: 0;
    font-size: 13px;
    line-height: 1.5;
    color: var(--text-55);
  }

  .danger-link {
    font-weight: 600;
    font-size: 14px;
    color: #f0a9a9;
  }

  .danger-link:hover {
    color: #ff8484;
  }

  .body {
    min-width: 0;
  }

  h1 {
    font-size: clamp(28px, 4vw, 40px);
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin-bottom: 22px;
  }

  .group {
    margin-bottom: 34px;
  }

  .group-head {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 14px;
  }

  .group-head h2 {
    font-size: 20px;
  }

  .group-count {
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--text-42);
  }

  .rows {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-bottom: 30px;
  }

  .empty-line {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--text-42);
  }

  .ok-line {
    margin: 0 0 14px;
    font-size: 14.5px;
    color: var(--ok);
  }

  .err-line {
    margin: 0 0 14px;
    font-size: 14.5px;
    color: #f0a9a9;
  }

  .new-list {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 8px;
  }

  .new-list input[type='text'],
  .new-list input:not([type]) {
    flex: 1;
    min-width: 180px;
    background: var(--surface);
    border: 1px solid rgba(244, 246, 245, 0.24);
    border-radius: 8px;
    color: var(--text);
    font-family: var(--font-display);
    font-size: 14.5px;
    padding: 12px 13px;
  }

  .new-list input::placeholder {
    color: var(--text-42);
  }

  .public-toggle {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: var(--text-70);
  }

  .public-toggle input {
    accent-color: var(--accent);
    width: 16px;
    height: 16px;
  }

  .new-list button {
    background: var(--accent);
    border: 0;
    border-radius: 8px;
    padding: 12px 20px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 14.5px;
    color: var(--page);
    cursor: pointer;
  }

  .new-list button:hover {
    background: #f0b94e;
  }

  .fine {
    margin: 0 0 24px;
    font-size: 12.5px;
    color: var(--text-42);
  }

  .review {
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 11px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    color: var(--text);
  }

  .review:hover {
    color: var(--text);
    box-shadow: 0 0 0 3px rgba(232, 169, 59, 0.12);
  }

  .review-place {
    font-weight: 500;
    font-size: 15.5px;
  }

  .review-stars {
    font-size: 11.5px;
    color: var(--accent);
  }

  .review-title {
    font-weight: 500;
    font-size: 15px;
  }

  .review-body {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--text-70);
  }

  .empty {
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 11px;
    padding: 30px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .empty-lead {
    margin: 0;
    font-size: 19px;
    font-weight: 500;
  }

  .empty-sub {
    margin: 8px 0 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-55);
    max-width: 52ch;
  }

  .ghost {
    margin-top: 18px;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 11px 18px;
    font-weight: 500;
    font-size: 14px;
    color: var(--text);
  }

  .ghost:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .mod-note {
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-left: 3px solid var(--accent);
    border-radius: 9px;
    padding: 16px 18px;
    margin-bottom: 24px;
  }

  .mod-kicker {
    font-size: 10px;
    letter-spacing: 0.16em;
    color: var(--accent);
  }

  .mod-note p {
    margin: 8px 0 0;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--text-70);
    max-width: 60ch;
  }

  @media (max-width: 1000px) {
    .layout {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .side {
      position: static;
    }

    .cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
