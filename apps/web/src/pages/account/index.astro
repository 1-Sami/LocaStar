---
import {
  achievementCopy,
  categoryName,
  fetchMyAchievementCounts,
  fillCopy,
  hasAchievements,
  summarise,
  fetchLists,
  fetchMyAddedLocations,
  fetchMyReviews,
  fetchMyShares,
  fetchFriendships,
  fetchMyPrivateProfile,
  fetchNotifications,
  fetchProfile,
  fetchProfileStats,
  fetchSavedLists,
  fetchSavedLocations,
  isModeratorRole,
  DEFAULT_NOTIFICATION_PREFERENCES,
  type LocationShare,
} from '@locastar/shared';
import ListCard from '../../components/ListCard.astro';
import PlaceCard from '../../components/PlaceCard.astro';
import PlaceRow from '../../components/PlaceRow.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Base from '../../layouts/Base.astro';
import { useTranslations, localePath } from '../../i18n/ui';
import { longDate } from '../../lib/format';
import { currentUser } from '../../lib/auth';
import { addFormCopy } from '../../i18n/addForm';

export const prerender = false;
const lang = Astro.locals.lang ?? 'en';
const t = useTranslations(lang);
const p = (href: string) => localePath(href, lang);

const { user, supabase } = await currentUser(Astro.cookies, Astro.request.headers);
if (!user) return Astro.redirect(p('/auth/sign-in'));

const section = Astro.url.searchParams.get('show') ?? 'saved';
const listError = Astro.url.searchParams.get('listError');
const created = Astro.url.searchParams.get('created');
const avatarSaved = Astro.url.searchParams.get('avatar') === '1';
const avatarRemoved = Astro.url.searchParams.get('avatar') === 'removed';
const avatarError = Astro.url.searchParams.get('avatarError');
const done = Astro.url.searchParams.get('done');
const accountError = Astro.url.searchParams.get('accountError') === '1';

/*
 * The add form lands here, instead of on the new place's page, for a private
 * event or one set to appear later: that page reads as a signed-out visitor and
 * would 404 for its own creator. Same notes the place page shows otherwise.
 */
const addCopy = addFormCopy(lang);
const scheduledFor = Astro.url.searchParams.get('scheduled');
const addedNotes = Astro.url.searchParams.get('added')
  ? [
      scheduledFor && /^\d{4}-\d{2}-\d{2}$/.test(scheduledFor)
        ? addCopy.addedScheduled.replace('{date}', longDate(`${scheduledFor}T12:00:00Z`, lang === 'sv' ? 'sv-SE' : 'en-GB'))
        : Astro.url.searchParams.get('private') === '1'
          ? addCopy.addedPrivate
          : null,
      Astro.url.searchParams.get('photos') === 'failed' ? addCopy.addedPhotosFailed : null,
      Astro.url.searchParams.get('claim') === 'failed' ? addCopy.addedClaimFailed : null,
    ].filter((line): line is string => Boolean(line))
  : [];

/*
 * Everything is fetched with the visitor's own session, so RLS returns their
 * rows and nobody else's — the same authorisation the app relies on, not a
 * check written again here.
 *
 * Favourites, bookmarks and shares are kept apart rather than merged, because
 * the app keeps them apart and they mean different things: a favourite is
 * somewhere you rate, a bookmark is somewhere you intend to go, and a share is
 * somewhere another person sent you.
 */
const [profile, stats, favourites, bookmarks, shares, lists, savedLists, reviews, added, friends, notifications, privateProfile] = await Promise.all([
  fetchProfile(supabase, user.id).catch(() => null),
  fetchProfileStats(supabase, user.id).catch(() => null),
  fetchSavedLocations(supabase, user.id, 'favorite').catch(() => []),
  fetchSavedLocations(supabase, user.id, 'bucket_list').catch(() => []),
  fetchMyShares(supabase, user.id).catch(() => []),
  fetchLists(supabase, user.id).catch(() => []),
  fetchSavedLists(supabase, user.id).catch(() => []),
  fetchMyReviews(supabase, user.id).catch(() => []),
  fetchMyAddedLocations(supabase, user.id).catch(() => []),
  fetchFriendships(supabase, user.id).catch(() => []),
  fetchNotifications(supabase, user.id).catch(() => []),
  /*
   * Its own RPC, not part of the profile: notification_preferences is granted
   * to nobody column-wise, because the profiles SELECT policy is using(true)
   * and anything in that select is world-readable. See 0066.
   */
  fetchMyPrivateProfile(supabase).catch(() => null),
]);

const name = profile?.username ?? profile?.display_name ?? user.email ?? 'You';
const isModerator = isModeratorRole(profile?.role ?? 'user');

/*
 * Achievements, for the accounts that have them.
 *
 * A second round trip after the batch above, deliberately: it depends on the
 * role, and a partner or admin should not be asked for at all. The words come
 * from packages/shared, the same ones the app's screen renders, so a badge
 * cannot be called one thing here and another on a phone.
 */
const ach = achievementCopy(lang);
const showAchievements = hasAchievements(profile?.role ?? 'user');
const achievements = showAchievements
  ? await fetchMyAchievementCounts(supabase)
      .then(summarise)
      .catch(() => null)
  : null;
const myLevel = achievements?.level ?? null;

/*
 * Split by who is waiting on whom, because the three want different controls:
 * an incoming request can be accepted or declined, an outgoing one can only be
 * withdrawn, and a friendship can be ended. Merged into one list, every row
 * would have to explain which of the three it was.
 */
const incoming = friends.filter((f) => f.status === 'pending' && f.direction === 'incoming');
const outgoing = friends.filter((f) => f.status === 'pending' && f.direction === 'outgoing');
const accepted = friends.filter((f) => f.status === 'accepted');

const unread = notifications.filter((n) => n.readAt === null).length;
const prefs = privateProfile?.notification_preferences ?? DEFAULT_NOTIFICATION_PREFERENCES;

const friendName = (f: (typeof friends)[number]) =>
  f.username ?? f.displayName ?? t('acct.someone');

/*
 * One line per notification, built from that kind's own payload.
 *
 * The union is discriminated on `type`, so each branch reads only the fields
 * its own payload actually has — there is no shared shape to lean on, and
 * guessing at one would break the moment a kind gains a field.
 */
const notificationLine = (n: (typeof notifications)[number]) => {
  switch (n.type) {
    case 'share':
      return t('acct.noteShare', {
        who: n.payload.sender_name,
        place: n.payload.location_name ?? t('acct.aPlace'),
      });
    case 'list_share':
      return t('acct.noteListShare', {
        who: n.payload.sender_name,
        list: n.payload.list_name ?? t('acct.aList'),
      });
    case 'role_granted':
      return t('acct.noteRole', { role: n.payload.role });
    case 'friend_request':
      return t('acct.noteFriendRequest', { who: n.payload.sender_name });
    case 'friend_accepted':
      return t('acct.noteFriendAccepted', { who: n.payload.sender_name });
    case 'activity_reminder':
      return t('acct.noteReminder', {
        place: n.payload.location_name ?? t('acct.aPlace'),
        when: longDate(n.payload.starts_at),
      });
  }
};

/*
 * A share is only half a fact without the other person. "SENT" told you the
 * direction and nothing else; the name is what makes the row mean something.
 */
const shareAside = (share: LocationShare) => {
  const who = share.otherPartyUsername ?? share.otherPartyDisplayName;
  if (!who) return share.direction === 'sent' ? t('acct.sent') : t('acct.received');
  return share.direction === 'sent' ? t('acct.sentTo', { who }) : t('acct.receivedFrom', { who });
};

const publicUrl = (path: string | null) =>
  path ? supabase.storage.from('media').getPublicUrl(path).data.publicUrl : null;

const NAV = [
  { key: 'saved', label: t('acct.saved'), count: favourites.length + bookmarks.length + shares.length },
  { key: 'lists', label: t('acct.myLists'), count: lists.length + savedLists.length },
  { key: 'added', label: t('acct.addedByMe'), count: added.length },
  { key: 'reviews', label: t('acct.myReviews'), count: reviews.length },
  /*
   * Friends and notifications count what is waiting on you, not how many rows
   * there are. A badge reading 40 beside Notifications when all forty have
   * been read is noise; the number people look for is the one that means
   * something needs them.
   */
  { key: 'friends', label: t('acct.friends'), count: incoming.length },
  { key: 'notifications', label: t('acct.notifications'), count: unread },
  /* Badges earned of badges there are, which is the number the screen itself
     leads with. Absent entirely for a partner or an admin. */
  ...(achievements
    ? [{ key: 'achievements', label: ach.title, count: achievements.earnedCount }]
    : []),
  /* No count: settings is not a collection, and a 0 beside it reads as a
     tally of something rather than as nothing to show. */
  { key: 'settings', label: t('acct.settings'), count: null },
];

const origin = Astro.site?.origin ?? Astro.url.origin;
---

<Base
  title={t('acct.title')}
  description={t('acct.metaDesc')}
  canonical={`${origin}/account`}
>
  <SiteHeader />

  <main id="main" class="wrap layout">
    <aside class="side">
      {/*
        The photo controls live behind the picture, the way they do in the app:
        press the avatar, choose change or remove. They used to be two labels
        sitting under the row — always visible, competing for a 250px rail with
        the one thing the rail is for, and reading as page furniture rather than
        as something belonging to the picture above them.

        A <details>, not a dialog: it opens with no JavaScript at all, which
        matters because losing the script would otherwise leave no way to change
        a photo. The file input still auto-submits on change, and the remove
        button still asks first — both are found by name and by data-confirm,
        not by where they sit, so moving them in here changed nothing.
      */}
      <div class="who-row">
        <details class="photo-menu">
          <summary class="photo-summary" title={t('acct.photoOptions')} aria-label={t('acct.photoOptions')}>
            {
              profile?.avatar_url ? (
                <span class="avatar" style={`background-image:url("${profile.avatar_url}")`} />
              ) : (
                <span class="avatar initial">{name.trim().charAt(0).toUpperCase()}</span>
              )
            }
            <span class="photo-hint" aria-hidden="true">✎</span>
          </summary>

          <form
            class="photo-pop"
            method="post"
            action={p('/api/avatar')}
            enctype="multipart/form-data"
          >
            <input type="hidden" name="back" value={p('/account')} />
            <label class="pop-item">
              {profile?.avatar_url ? t('acct.changePhoto') : t('acct.addPhoto')}
              <input type="file" name="avatar" accept="image/jpeg,image/png,image/webp" />
            </label>
            {
              profile?.avatar_url && (
                <button
                  class="pop-item pop-danger"
                  type="submit"
                  name="remove"
                  value="1"
                  data-confirm={t('acct.removePhotoConfirm')}
                >
                  {t('acct.removePhoto')}
                </button>
              )
            }
          </form>
        </details>

        <span class="who-text">
          <span class="name-row">
            <span class="name">{name}</span>
          </span>
          {
            stats && (
              <span class="mono contributions">
                {stats.contributions} {stats.contributions === 1 ? t('acct.contribution_one') : t('acct.contribution_other')}
              </span>
            )
          }
          {/* Under the contribution count, where the owner asked for it: the
              tally says how much, this says what that adds up to. */}
          {myLevel && myLevel.number > 1 && (
            <a class="level-pill" href={p('/account?show=achievements')}>
              <span aria-hidden="true">◆</span>
              {ach.level[myLevel.id]}
            </a>
          )}
        </span>
      </div>

      {avatarSaved && <p class="ok-line">{t('acct.avatarSaved')}</p>}
      {avatarRemoved && <p class="ok-line">{t('acct.avatarRemoved')}</p>}
      {
        avatarError && (
          <p class="err-line">
            {avatarError === 'type'
              ? t('acct.avatarErrType')
              : avatarError === 'size'
                ? t('acct.avatarErrSize')
                : avatarError === 'none'
                  ? t('acct.avatarErrNone')
                  : t('acct.avatarErr')}
          </p>
        )
      }

      <nav class="side-nav" aria-label={t('acct.navLabel')}>
        {
          NAV.map((item) => (
            <a class={`side-link${section === item.key ? ' on' : ''}`} href={p(`/account?show=${item.key}`)}>
              <span>{item.label}</span>
              {item.count !== null && <span class="mono side-count">{item.count}</span>}
            </a>
          ))
        }
      </nav>

      {/*
        Filled and brand-coloured, so it does not read as one more of the
        account's own links. It goes somewhere else entirely, and only a
        moderator ever sees it.
      */}
      {
        isModerator && (
          <a class="mod-button" href={p('/admin/reports')}>
            {t('acct.moderatorLink')}
          </a>
        )
      }

      {/*
        Last in the rail, under everything the page is actually for. It used to
        sit beside the name to keep it quiet; down here it stays quiet by being
        the thing you scroll past, so it is bordered and muted rather than
        filled — nothing in this column should compete with the admin button.

        Its own form, because a form cannot be nested inside the avatar's.
      */}
      <form method="post" action={p('/auth/sign-out')} class="signout-form">
        <button class="signout" type="submit">{t('acct.logOut')}</button>
      </form>

    </aside>

    <section class="body">
      {accountError && <p class="err-line">{t('acct.actionFailed')}</p>}
      {done && !accountError && <p class="ok-line">{t('acct.actionDone')}</p>}
      {addedNotes.map((line) => <p class="ok-line">{line}</p>)}
      {
        section === 'saved' && (
          <>
            <h1>{t('acct.saved')}</h1>

            <section class="group">
              <div class="group-head">
                <h2>{t('acct.favourites')}</h2>
                <span class="mono group-count">{favourites.length}</span>
              </div>
              {favourites.length === 0 ? (
                <p class="empty-line">{t('acct.favouritesEmpty')}</p>
              ) : (
                <div class="cards">
                  {favourites.map((place) => (
                    <PlaceCard
                      href={p(`/location/${place.location_id}`)}
                      name={place.name}
                      categorySlug={place.category_slug}
                      categoryName={categoryName(place.category_slug, lang)}
                      avgRating={place.avg_rating}
                      reviewCount={place.review_count}
                      where={place.city}
                      address={place.address}
                      imageUrl={publicUrl(place.cover_photo_path)}
                      startsAt={place.starts_at}
                    />
                  ))}
                </div>
              )}
            </section>

            <section class="group">
              <div class="group-head">
                <h2>{t('acct.bookmarks')}</h2>
                <span class="mono group-count">{bookmarks.length}</span>
              </div>
              {bookmarks.length === 0 ? (
                <p class="empty-line">{t('acct.bookmarksEmpty')}</p>
              ) : (
                <div class="cards">
                  {bookmarks.map((place) => (
                    <PlaceCard
                      href={p(`/location/${place.location_id}`)}
                      name={place.name}
                      categorySlug={place.category_slug}
                      categoryName={categoryName(place.category_slug, lang)}
                      avgRating={place.avg_rating}
                      reviewCount={place.review_count}
                      where={place.city}
                      address={place.address}
                      imageUrl={publicUrl(place.cover_photo_path)}
                      startsAt={place.starts_at}
                    />
                  ))}
                </div>
              )}
            </section>

            <section class="group">
              <div class="group-head">
                <h2>{t('acct.shared')}</h2>
                <span class="mono group-count">{shares.length}</span>
              </div>
              {shares.length === 0 ? (
                <p class="empty-line">{t('acct.sharedEmpty')}</p>
              ) : (
                <div class="cards">
                  {shares.map((share) => (
                    <PlaceCard
                      href={p(`/location/${share.location_id}`)}
                      name={share.name}
                      categorySlug={share.category_slug}
                      categoryName={categoryName(share.category_slug, lang)}
                      avgRating={share.avg_rating}
                      reviewCount={share.review_count}
                      where={shareAside(share) ?? share.city}
                      imageUrl={publicUrl(share.cover_photo_path)}
                      startsAt={share.starts_at}
                    />
                  ))}
                </div>
              )}
            </section>
          </>
        )
      }

      {
        section === 'lists' && (
          <>
            <h1>{t('acct.myLists')}</h1>

            {created && <p class="ok-line">{t('acct.listCreated')}</p>}
            {listError === 'name' && <p class="err-line">{t('acct.listNeedsName')}</p>}
            {listError === '1' && <p class="err-line">{t('acct.listFailed')}</p>}

            <form method="post" action="/api/list" class="new-list">
              <input type="hidden" name="back" value={p('/account')} />
              <input name="name" placeholder={t('acct.nameNewList')} aria-label={t('acct.listName')} required />
              <input name="description" placeholder={t('acct.listPurpose')} aria-label={t('acct.description')} />
              <label class="public-toggle">
                <input type="checkbox" name="isPublic" value="1" />
                <span>{t('acct.public')}</span>
              </label>
              <button type="submit">{t('acct.createList')}</button>
            </form>
            <p class="fine">{t('acct.listFine')}</p>

            {lists.length === 0 ? (
              <p class="empty-line">{t('acct.noLists')}</p>
            ) : (
              <div class="cards">
                {lists.map((list) => (
                  <ListCard
                    href={p(`/lists/${list.id}`)}
                    name={list.name}
                    itemCount={list.itemCount}
                    previews={list.previewLocations.slice(0, 3).map((p) => p.imageUrl)}
                    note={list.isPublic ? 'PUBLIC' : 'PRIVATE'}
                  />
                ))}
              </div>
            )}

            {savedLists.length > 0 && (
              <section class="group">
                <div class="group-head">
                  <h2>{t('acct.savedLists')}</h2>
                  <span class="mono group-count">{savedLists.length}</span>
                </div>
                <div class="cards">
                  {savedLists.map((list) => (
                    <ListCard
                      href={p(`/lists/${list.id}`)}
                      name={list.name}
                      by={list.ownerUsername ?? list.ownerDisplayName}
                      itemCount={list.itemCount}
                      previews={list.previewLocations.slice(0, 3).map((p) => p.imageUrl)}
                    />
                  ))}
                </div>
              </section>
            )}
          </>
        )
      }

      {
        section === 'added' && (
          <>
            <h1>{t('acct.addedByMe')}</h1>
            {added.length === 0 ? (
              <div class="empty">
                <p class="empty-lead">{t('acct.noneAdded')}</p>
                <p class="empty-sub">{t('acct.noneAddedSub')}</p>
                <a class="ghost" href={p('/add')}>{t('add.heading')}</a>
              </div>
            ) : (
              <div class="rows">
                {added.map((place) => (
                  <PlaceRow
                    href={p(`/location/${place.id}`)}
                    name={place.name}
                    categorySlug={place.category_slug}
                    categoryName={categoryName(place.category_slug, lang) ?? place.category_label}
                    avgRating={place.avg_rating}
                    reviewCount={place.review_count}
                    imageUrl={publicUrl(place.cover_photo_path)}
                    aside={place.kind === 'activity' ? t('loc.activity').toUpperCase() : longDate(place.created_at)}
                  />
                ))}
              </div>
            )}
          </>
        )
      }

      {
        section === 'reviews' && (
          <>
            <h1>{t('acct.myReviews')}</h1>
            {reviews.length === 0 ? (
              <div class="empty">
                <p class="empty-lead">{t('acct.noReviews')}</p>
                <p class="empty-sub">{t('acct.noReviewsSub')}</p>
              </div>
            ) : (
              <div class="rows">
                {reviews.map((review) => (
                  <a class="review" href={p(`/location/${review.location_id}`)}>
                    <span class="review-place">{review.location_name}</span>
                    <span class="mono review-stars">
                      {'★'.repeat(review.rating)}
                      {'☆'.repeat(5 - review.rating)}
                    </span>
                    {review.title && <strong class="review-title">{review.title}</strong>}
                    {review.body && <p class="review-body">{review.body}</p>}
                  </a>
                ))}
              </div>
            )}
          </>
        )
      }

      {
        section === 'friends' && (
          <>
            <h1>{t('acct.friends')}</h1>

            {incoming.length > 0 && (
              <section class="group">
                <div class="group-head">
                  <h2>{t('acct.friendRequests')}</h2>
                  <span class="mono group-count">{incoming.length}</span>
                </div>
                <div class="people">
                  {incoming.map((f) => (
                    <div class="person">
                      {f.avatarUrl ? (
                        <span class="face" style={`background-image:url("${f.avatarUrl}")`} />
                      ) : (
                        <span class="face initial">{friendName(f).charAt(0).toUpperCase()}</span>
                      )}
                      <span class="person-name">{friendName(f)}</span>
                      <form method="post" action="/api/account" class="person-do">
                        <input type="hidden" name="back" value={p('/account?show=friends')} />
                        <input type="hidden" name="friendshipId" value={f.friendshipId} />
                        <button class="mini primary" type="submit" name="action" value="friend-accept">
                          {t('acct.accept')}
                        </button>
                        <button class="mini" type="submit" name="action" value="friend-remove">
                          {t('acct.decline')}
                        </button>
                      </form>
                    </div>
                  ))}
                </div>
              </section>
            )}

            <section class="group">
              <div class="group-head">
                <h2>{t('acct.myFriends')}</h2>
                <span class="mono group-count">{accepted.length}</span>
              </div>
              {accepted.length === 0 ? (
                <p class="empty-line">{t('acct.noFriends')}</p>
              ) : (
                <div class="people">
                  {accepted.map((f) => (
                    <div class="person">
                      {f.avatarUrl ? (
                        <span class="face" style={`background-image:url("${f.avatarUrl}")`} />
                      ) : (
                        <span class="face initial">{friendName(f).charAt(0).toUpperCase()}</span>
                      )}
                      <span class="person-name">{friendName(f)}</span>
                      <form method="post" action="/api/account" class="person-do">
                        <input type="hidden" name="back" value={p('/account?show=friends')} />
                        <input type="hidden" name="friendshipId" value={f.friendshipId} />
                        <button
                          class="mini"
                          type="submit"
                          name="action"
                          value="friend-remove"
                          data-confirm={t('acct.unfriendConfirm', { who: friendName(f) })}
                        >
                          {t('acct.unfriend')}
                        </button>
                      </form>
                    </div>
                  ))}
                </div>
              )}
            </section>

            {outgoing.length > 0 && (
              <section class="group">
                <div class="group-head">
                  <h2>{t('acct.friendSent')}</h2>
                  <span class="mono group-count">{outgoing.length}</span>
                </div>
                <div class="people">
                  {outgoing.map((f) => (
                    <div class="person">
                      {f.avatarUrl ? (
                        <span class="face" style={`background-image:url("${f.avatarUrl}")`} />
                      ) : (
                        <span class="face initial">{friendName(f).charAt(0).toUpperCase()}</span>
                      )}
                      <span class="person-name">{friendName(f)}</span>
                      <span class="mono person-note">{t('acct.friendPending')}</span>
                      <form method="post" action="/api/account" class="person-do">
                        <input type="hidden" name="back" value={p('/account?show=friends')} />
                        <input type="hidden" name="friendshipId" value={f.friendshipId} />
                        <button class="mini" type="submit" name="action" value="friend-remove">
                          {t('acct.friendWithdraw')}
                        </button>
                      </form>
                    </div>
                  ))}
                </div>
              </section>
            )}

            {/*
              Adding a friend is not here. Finding somebody needs the user
              search the app has and the website does not, and a control that
              cannot complete the job is worse than an honest absence.
            */}
