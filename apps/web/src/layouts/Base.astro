---
import '../styles/tokens.css';

/*
 * Every page's <head>.
 *
 * The site this replaces served `<title data-rh="true"></title>` — empty — on
 * every route, with no description and no content in the HTML until JavaScript
 * ran. That is why nothing could be indexed, and it is the single thing this
 * rebuild exists to fix. So title and description are required props: a page
 * cannot forget them.
 */
interface Props {
  title: string;
  description: string;
  canonical: string;
  lang?: 'en' | 'sv';
  /** JSON-LD objects. Emitted verbatim, so build them where the data is. */
  jsonLd?: unknown[];
}

const { title, description, canonical, jsonLd = [] } = Astro.props;

/*
 * The language comes from the URL, via middleware, not from a prop each page
 * has to remember to pass.
 *
 * hreflang tells Google these are the same page in two languages rather than
 * duplicates competing with each other, and which to show a Swedish searcher.
 * x-default points at English for everyone else.
 */
const lang = Astro.locals.lang ?? 'en';
const bare = Astro.url.pathname.startsWith('/sv/')
  ? Astro.url.pathname.slice(3)
  : Astro.url.pathname === '/sv'
    ? '/'
    : Astro.url.pathname;
const origin = Astro.site?.origin ?? Astro.url.origin;
const enHref = origin + bare;
const svHref = origin + (bare === '/' ? '/sv/' : '/sv' + bare);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={lang === 'sv' ? svHref : canonical} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="sv" href={svHref} />
    <link rel="alternate" hreflang="x-default" href={enHref} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Spline+Sans:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    {
      jsonLd.map((block) => (
        <script type="application/ld+json" set:html={JSON.stringify(block)} />
      ))
    }
  </head>
  <body>
    <a href="#main" class="skip">Skip to content</a>
    <slot />
  </body>
</html>

<style>
  /* Visible only when focused — keyboard users get a way past the header. */
  .skip {
    position: absolute;
    left: -9999px;
    top: 0;
    background: var(--accent);
    color: var(--page);
    padding: 12px 18px;
    border-radius: 0 0 8px 0;
    font-weight: 600;
    z-index: 10;
  }
  .skip:focus {
    left: 0;
  }
</style>
