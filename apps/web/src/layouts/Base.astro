---
import '../styles/tokens.css';

/*
 * Every page's <head>.
 *
 * The site this replaces served `<title data-rh="true"></title>` — empty — on
 * every route, with no description and no content in the HTML until JavaScript
 * ran. That is why nothing could be indexed, and it is the single thing this
 * rebuild exists to fix. So title and description are required props: a page
 * cannot forget them.
 */
interface Props {
  title: string;
  description: string;
  canonical: string;
  /**
   * The picture a share card shows. A place's own photo where there is one,
   * absolute URL. Falls back to the site card.
   */
  image?: string | null;
  /**
   * True for a page that exists in English only.
   *
   * The legal documents are the English text whichever URL you reach them at,
   * so /sv/legal/privacy is a second address for one page, not a translation.
   * Claiming otherwise with hreflang points Google at duplicate content.
   */
  englishOnly?: boolean;
  /** JSON-LD objects. Emitted verbatim, so build them where the data is. */
  jsonLd?: unknown[];
}

const {
  title,
  description,
  canonical,
  image = null,
  englishOnly = false,
  jsonLd = [],
} = Astro.props;

/*
 * The language comes from the URL, via middleware, not from a prop each page
 * has to remember to pass.
 *
 * hreflang tells Google these are the same page in two languages rather than
 * duplicates competing with each other, and which to show a Swedish searcher.
 * x-default points at English for everyone else.
 */
const lang = Astro.locals.lang ?? 'en';
const bare = Astro.url.pathname.startsWith('/sv/')
  ? Astro.url.pathname.slice(3)
  : Astro.url.pathname === '/sv'
    ? '/'
    : Astro.url.pathname;
const origin = Astro.site?.origin ?? Astro.url.origin;
const enHref = origin + bare;
const svHref = origin + (bare === '/' ? '/sv/' : '/sv' + bare);

/*
 * The address this page is at, in the language it is in.
 *
 * og:url used to be the `canonical` prop, which every page builds in English —
 * so a Swedish page shared on Facebook resolved to the English one. It has to
 * agree with the canonical link right below it.
 */
const selfHref = lang === 'sv' && !englishOnly ? svHref : canonical;
const shareImage = image ?? origin + '/share-card.png';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={selfHref} />
    {
      !englishOnly && (
        <>
          <link rel="alternate" hreflang="en" href={enHref} />
          <link rel="alternate" hreflang="sv" href={svHref} />
          <link rel="alternate" hreflang="x-default" href={enHref} />
        </>
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="LocaStar" />
    <meta property="og:locale" content={lang === 'sv' ? 'sv_SE' : 'en_GB'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={selfHref} />
    <meta property="og:image" content={shareImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />

    {/*
      An SVG favicon covers every current browser; the PNG is only there for
      iOS home screens, which still will not read SVG.
    */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#07100f" />

    {/*
      Served from this origin, not fonts.googleapis.com — see the note in
      public/fonts/fonts.css. The latin face of each is preloaded because both
      are used above the fold on every page, and a preload started here beats
      one discovered part-way through the stylesheet.
    */}
    <link
      rel="preload"
      href="/fonts/spline-sans-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/jetbrains-mono-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="stylesheet" href="/fonts/fonts.css" />

    {
      jsonLd.map((block) => (
        <script type="application/ld+json" set:html={JSON.stringify(block)} />
      ))
    }
  </head>
  <body>
    <a href="#main" class="skip">Skip to content</a>
    <slot />
  </body>
</html>

<style>
  /* Visible only when focused — keyboard users get a way past the header. */
  .skip {
    position: absolute;
    left: -9999px;
    top: 0;
    background: var(--accent);
    color: var(--page);
    padding: 12px 18px;
    border-radius: 0 0 8px 0;
    font-weight: 600;
    z-index: 10;
  }
  .skip:focus {
    left: 0;
  }
</style>
