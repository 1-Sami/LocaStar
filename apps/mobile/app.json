{
  "expo": {
    "name": "LocaStar",
    "slug": "locastar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "locastar",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "se.locastar.app",
      "supportsTablet": false,
      "associatedDomains": ["applinks:locastar.se"],
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "se.locastar.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#125F6F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "locastar.se",
              "pathPrefix": "/auth"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#125F6F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 112
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "LocaStar uses your location to show nearby places and activities."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "LocaStar uses your photo library so you can add pictures to locations and reviews.",
          "cameraPermission": "LocaStar uses your camera so you can take pictures for locations and reviews."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/splash-icon.png",
          "color": "#125F6F"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ac35b462-da44-4e1d-8dec-e7771210cb07"
      }
    },
    "owner": "1-sami",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ac35b462-da44-4e1d-8dec-e7771210cb07"
    }
  }
}
